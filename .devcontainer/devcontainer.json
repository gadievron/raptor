{
  "name": "RAPTOR Security Research Framework",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    // Proxy passthrough for mandatory-egress-proxy hosts. These are
    // Docker's predefined build args — no ARG declarations needed in
    // the Dockerfile; every RUN step (apt, pip, curl, npm) honours
    // them. Empty values (unproxied hosts) are treated as unset.
    "args": {
      "http_proxy": "${localEnv:http_proxy}",
      "https_proxy": "${localEnv:https_proxy}",
      "no_proxy": "${localEnv:no_proxy}",
      "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
      "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
      "NO_PROXY": "${localEnv:NO_PROXY}"
    }
  },
  // Default posture: UNPRIVILEGED. RAPTOR's threat model treats
  // scanned repos as hostile — under --privileged + passwordless sudo
  // + host-secret bind mounts, one in-container escalation was
  // host-equivalent by configuration. SYS_PTRACE + seccomp=unconfined
  // cover the standing needs (gdb/strace, rr REPLAY, the namespace +
  // Landlock sandbox machinery) without all-capabilities and host
  // device access.
  //
  // rr RECORDING profile (opt-in, local edit): recording needs
  // hardware perf counters — replace the line below with
  //   "runArgs": ["--privileged"],
  // and rebuild; the postStartCommand's perf_event_paranoid write
  // only succeeds under that profile (it degrades silently
  // otherwise). Pinned by .github/tests/test_devcontainer_config.py:
  // --privileged must never be the default again.
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "GitHub.copilot",
        "ms-vscode.cpptools",
        "GitHub.vscode-codeql"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true
      }
    }
  },
  "containerEnv": {
    "GIT_TERMINAL_PROMPT": "0",
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    // Runtime proxy passthrough (postCreateCommand pip installs,
    // in-container scans). Loopback appended to NO_PROXY so
    // in-container sidecars (SAGE, Ollama) are never proxied.
    "http_proxy": "${localEnv:http_proxy}",
    "https_proxy": "${localEnv:https_proxy}",
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "no_proxy": "${localEnv:no_proxy},localhost,127.0.0.1,::1",
    "NO_PROXY": "${localEnv:NO_PROXY},localhost,127.0.0.1,::1"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.env,target=/workspaces/raptor/.env,type=bind,consistency=cached",
    // Target the REMOTE USER's home: the claude CLI runs as vscode
    // (HOME=/home/vscode) and resolves ~/.claude there. A /root
    // target was a dead credential mount — never read by the
    // intended user (fresh unauthenticated state every container)
    // while the operator's real credentials and cross-project
    // history sat readable via sudo. Pinned by
    // .github/tests/test_devcontainer_config.py.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],
  "postCreateCommand": "pip install -r .devcontainer/requirements-all-optional.txt && pip install -r requirements-dev.txt",
  "postStartCommand": "sudo sh -c 'echo 1 > /proc/sys/kernel/perf_event_paranoid 2>/dev/null || true'",
  "remoteUser": "vscode"
}
