            }
          ],
          "properties": {
            "expanded_view": true,
            "expanded_line": 210
          },
          "partialFingerprints": {
            "raptor/expandedLocation/v1": "210:0:0:0"
          }
        },
        {
          "ruleId": "c.buffer.overflow",
          "level": "warning",
          "message": {
