          "partialFingerprints": {
            "raptor/expandedLocation/v1": "90:0:0:0"
          }
        },
        {
          "ruleId": "(unnamed)",
          "level": "warning",
          "message": {
            "text": "(unnamed) matched (fidelity-3 expanded view)"
