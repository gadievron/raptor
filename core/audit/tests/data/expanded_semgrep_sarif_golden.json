                "level": "warning"
              }
            },
            {
              "id": "(unnamed)",
              "name": "(unnamed)",
              "shortDescription": {
                "text": "(unnamed)"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
