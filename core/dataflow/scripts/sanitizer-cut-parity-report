#!/usr/bin/env python3
"""CLI shim for the sanitizer-cut parity baseline report generator.

Prints the markdown report to stdout.

Set ``RAPTOR_SANITIZER_CUT=1`` so the value-bound gate is consulted
(the baseline's sanitizer-cut fixtures need the flag on to suppress).

Dev-tooling only — not invoked by the LLM-driven RAPTOR workflows.
Co-located with ``core/dataflow/`` (the module it operates on) rather
than ``libexec/`` (which is reserved for framework-internal shims).

The libexec ``_RAPTOR_TRUSTED`` guard previously gated invocation —
removed for consistency with the sibling corpus-run / corpus-metrics
scripts: this class is openly invocable by developers, and the guard
was defensible only under the "internal dispatch script" framing
libexec implies.
"""
import os
import sys

# Repo root comes from the launcher-set RAPTOR_DIR — the ONLY
# path ever added to sys.path (hard lookup; KeyError if the
# script is run outside the launcher, by design).
sys.path.insert(0, os.environ["RAPTOR_DIR"])

from core.dataflow.sanitizer_cut_parity_report import (  # noqa: E402
    render_baseline_report,
)

sys.stdout.write(render_baseline_report() + "\n")
sys.exit(0)
