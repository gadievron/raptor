#!/usr/bin/env bash
#
# PostToolUse hook for Read — tracks file reads for coverage.
# Runs async (configured in .claude/settings.json).
#
# Finds the active running run via the project symlink, then
# appends the file path to the run's reads manifest.
#

# `set -euo pipefail` — pre-fix the script ran without strict
# mode, so:
#   * `set -e`: a failing command in the middle (e.g. `realpath`
#     returning nothing for a deleted file mid-resolve, mktemp
#     failing under disk pressure) silently continued, often
#     writing partial / corrupted manifest entries.
#   * `set -u`: typos in variable names (e.g. `$RUNDIR` vs
#     `$RUN_DIR`) silently expanded to empty, producing manifest
#     paths like `/tmp/.reads-manifest` (the `/` came from a bare
#     empty interpolation) — pollution at a path the operator
#     didn't own.
#   * `set -o pipefail`: failing pipe stages (e.g. `jq` rejecting
#     malformed input but `$()` still succeeding because the tail
#     command exited 0) hid parse errors, producing empty
#     PROJECT_DIR / PROJECT_TARGET that bypassed the prefix check.
# All three protections are appropriate for an async hook where
# silent partial success is worse than a clean exit.
set -euo pipefail

umask 077

# Cache the jq detection once (this async hook fires on every tracked
# Read; repeated `command -v` lookups were measurable on slow-PATH
# hosts). The named helper handles the no-jq JSON fallbacks and the
# O_NOFOLLOW manifest append — arguments stay argv DATA, never
# interpolated into python source.
HAVE_JQ=0
if command -v jq >/dev/null 2>&1; then
    HAVE_JQ=1
fi
HELPER="$(dirname "${BASH_SOURCE[0]}")/raptor-hook-json"
[ -f "$HELPER" ] || exit 0

# Resolve THIS SESSION's run via the run ledger (primary), falling
# back to the legacy machine-global project route only when no session
# credential is present (pre-series launchers, bare invocations).
#
# The hook inherits the launcher-exported RAPTOR_SESSION_PID — env-only
# resolution is sound here because the hook runs inside claude's own
# environment. sessions.d/<pid>.run lines are
# '<status> <epoch> <run-id> <abs-dir>'; candidates are validated:
# absolute printable path, a self-authenticating .raptor-run.json with
# status=running (project dirs are NOT enumerated, so --out and
# STANDALONE runs get read-coverage too — the old project requirement
# was only ever an artifact of run-dir discovery), and the run's
# recorded session_pid equals ours (a run resumed by another session
# no longer belongs to us). Newest valid live run wins; none valid →
# attribute NOTHING in-session, never the global heuristic.
# Keep in lock-step with the python twin core/coverage/track_read.py.
RUN_DIR=""
PROJECT_TARGET=""
_SESSION_PID="${RAPTOR_SESSION_PID:-}"
case "$_SESSION_PID" in
    ''|*[!0-9]*) _SESSION_PID="" ;;
esac
if [ -n "$_SESSION_PID" ]; then
    _LEDGER="$HOME/.local/share/raptor/sessions.d/$_SESSION_PID.run"
    # Size guard matching the python reader's ledger budget: an
    # over-budget ledger reads as empty there, and the two consumers
    # must not diverge on the same file.
    _LSIZE=$(stat -c %s "$_LEDGER" 2>/dev/null || stat -f %z "$_LEDGER" 2>/dev/null || echo 0)
    case "$_LSIZE" in ''|*[!0-9]*) _LSIZE=0 ;; esac
    if [ "$_LSIZE" -gt 524288 ]; then
        _LEDGER=""
    fi
    if [ -n "$_LEDGER" ] && [ -f "$_LEDGER" ]; then
        BEST_EPOCH=0
        # One date(1) per event, not per line — the hook fires on
        # EVERY file read.
        _now_cap=$(( $(date +%s) + 86400 ))
        while IFS=' ' read -r _st _epoch _rid _rdir; do
            case "$_st" in
                running) ;;
                pin) break ;;   # writer renders records before pins —
                                # nothing below is a run record
                *) continue ;;
            esac
            case "$_epoch" in ''|*[!0-9]*) continue ;; esac
            # Skip skewed-ahead-clock records (see the python twin);
            # the writer clamps them on its next rewrite.
            if [ "$_epoch" -gt "$_now_cap" ] 2>/dev/null; then
                continue
            fi
            case "$_rdir" in
                /*) ;;
                *) continue ;;
            esac
            # [[:cntrl:]] not [![:print:]]: the print class is
            # locale-dependent (under LC_ALL=C a multibyte path reads
            # unprintable and legit non-ASCII run dirs lose coverage);
            # the writer rejects control bytes, so match that.
            case "$_rdir" in
                *[[:cntrl:]]*) continue ;;
            esac
            [ -f "$_rdir/.raptor-run.json" ] || continue
            [ "$_epoch" -gt "$BEST_EPOCH" ] || continue
            # `|| true` on every probe: under `set -e` a jq parse
            # failure on malformed run metadata (agent-writable file)
            # would otherwise kill the hook mid-loop — a hostile or
            # truncated .raptor-run.json must skip THIS candidate,
            # not silence coverage attribution for the whole session.
            if [ "$HAVE_JQ" = "1" ]; then
                # Single jq spawn per candidate (three fields,
                # newline-delimited; missing → empty line).
                _meta3=$(jq -r '[(.status // ""), (.session_pid // ""), ((.target_path // "") | if type == "string" then . else "" end)] | .[]' "$_rdir/.raptor-run.json" 2>/dev/null || true)
                _status=""; _owner=""; _tgt=""
                {
                    IFS= read -r _status || true
                    IFS= read -r _owner || true
                    IFS= read -r _tgt || true
                } <<META
$_meta3
META
            else
                _status=$(python3 "$HELPER" get "$_rdir/.raptor-run.json" status 2>/dev/null || true)
                _owner=$(python3 "$HELPER" get "$_rdir/.raptor-run.json" session_pid 2>/dev/null || true)
                _tgt=$(python3 "$HELPER" get "$_rdir/.raptor-run.json" target_path 2>/dev/null || true)
            fi
            [ "$_status" = "running" ] || continue
            [ "$_owner" = "$_SESSION_PID" ] || continue
            BEST_EPOCH="$_epoch"
            RUN_DIR="$_rdir/"
            PROJECT_TARGET="$_tgt"
        done < "$_LEDGER"
        unset _st _epoch _rid _rdir _status _owner _tgt BEST_EPOCH _LEDGER
    fi
    # In-session with no valid live run: attribute nothing.
    [ -z "$RUN_DIR" ] && exit 0
else
    # ── legacy machine-global route (no-session fallback) ──────────
    # `.active` is operator-controlled but should always point at a
    # SIBLING entry under `~/.raptor/projects/`; reject path-shaped
    # targets (`../`, absolute) — see the twin for the full rationale.
    ACTIVE_LINK="$HOME/.raptor/projects/.active"
    [ ! -L "$ACTIVE_LINK" ] && exit 0

    LINK_TARGET=$(readlink "$ACTIVE_LINK")
    case "$LINK_TARGET" in
        */*|"") exit 0 ;;       # path component or empty — refuse
        .|..)  exit 0 ;;        # parent / self — refuse
        .*)    exit 0 ;;        # leading dot reserved for hook state files (.active etc.)
    esac
    case "$LINK_TARGET" in
        *..*) exit 0 ;;
    esac
    PROJECT_FILE="$HOME/.raptor/projects/$LINK_TARGET"
    [ ! -f "$PROJECT_FILE" ] && exit 0

    if [ "$HAVE_JQ" = "1" ]; then
        PROJECT_DIR=$(jq -r '.output_dir // empty' "$PROJECT_FILE" 2>/dev/null) || true
        PROJECT_TARGET=$(jq -r '.target // empty' "$PROJECT_FILE" 2>/dev/null) || true
    else
        PROJECT_DIR=$(python3 "$HELPER" get "$PROJECT_FILE" output_dir 2>/dev/null) || true
        PROJECT_TARGET=$(python3 "$HELPER" get "$PROJECT_FILE" target 2>/dev/null) || true
    fi
    [ -z "$PROJECT_DIR" ] && exit 0
    [ ! -d "$PROJECT_DIR" ] && exit 0

    # Newest running run (mtime of .raptor-run.json — most recently
    # transitioned to running).
    NEWEST_MTIME=0
    for d in "$PROJECT_DIR"/*/; do
        [ -f "${d}.raptor-run.json" ] || continue
        if [ "$HAVE_JQ" = "1" ]; then
            STATUS=$(jq -r '.status // empty' "${d}.raptor-run.json" 2>/dev/null) || true
        else
            STATUS=$(python3 "$HELPER" get "${d}.raptor-run.json" status 2>/dev/null) || true
        fi
        [ "$STATUS" = "running" ] || continue
        MTIME=$(stat -c %Y "${d}.raptor-run.json" 2>/dev/null || stat -f %m "${d}.raptor-run.json" 2>/dev/null || true)
        [ -z "$MTIME" ] && MTIME=0
        if [ "$MTIME" -gt "$NEWEST_MTIME" ] 2>/dev/null; then
            NEWEST_MTIME=$MTIME
            RUN_DIR=$d
        fi
    done
    [ -z "$RUN_DIR" ] && exit 0
fi

# Extract file path from hook payload (JSON on stdin)
if [ "$HAVE_JQ" = "1" ]; then
    FILE_PATH=$(jq -r '
        .tool_input.file_path
        // .tool_input.path
        // .toolArgs.path
        // empty
    ' 2>/dev/null) || true
else
    FILE_PATH=$(python3 "$HELPER" get-first - \
        tool_input.file_path tool_input.path toolArgs.path \
        2>/dev/null) || true
fi
[ -z "$FILE_PATH" ] && exit 0

# Skip non-source files. Pre-fix the extension check fired on
# `${FILE_PATH##*.}` which strips through the LAST `.` — but if
# the path has no `.`, the result is the WHOLE path, which
# obviously doesn't match any extension and we exit 0. That's
# fine for files. But for DIRECTORIES (paths with no extension):
# the same logic skips them, which is the right outcome for
# coverage tracking (we record file reads, not dir lists).
#
# What's NOT fine: the `${FILE_PATH##*.}` extension check matches
# directory paths whose final component HAS a `.` (e.g.
# `/repo/some.dir/`). Those falsely pass the extension filter
# (last component after final `.` matches `dir`, which doesn't
# match the case arm — fine for `dir`, but `/repo/foo.py/`
# matches `py` and the dir would get appended as if it were a
# read of a file). Coverage records then carry directory paths
# which downstream fail to look up as files.
#
# Add an explicit `[ -d ]` filter so directories are rejected
# regardless of trailing-component shape.
if [ -d "$FILE_PATH" ]; then
    exit 0
fi
_EXT="${FILE_PATH##*.}"
# Case-insensitive like the twin — ${var,,} is bash>=4 only and macOS
# system bash is 3.2 (this script already carries the BSD stat
# fallback), so guard it; without bash 4 or tr the match stays
# case-sensitive, the pre-fix behavior.
if [ -n "${BASH_VERSINFO:-}" ] && [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
    _EXT="${_EXT,,}"
elif command -v tr >/dev/null 2>&1; then
    _EXT=$(printf '%s' "$_EXT" | tr 'A-Z' 'a-z')
fi
case "$_EXT" in
    py|js|ts|jsx|tsx|c|h|cpp|hpp|cc|cxx|java|go|rs|rb|php|cs|swift|kt|scala|sh|bash|zsh|zig|nim|cr|sol|dart|m|mm|lua|pl|pm|jl|ex|exs|erl|hrl|fs|fsi|fsx|ml|mli|clj|cljs|cljc|groovy|gradle|r|hs|elm|vue|svelte|astro|tf|tofu|nix) ;;
    *) exit 0 ;;
esac

# Reject paths with newlines or control characters
case "$FILE_PATH" in
    *$'\n'*|*$'\r'*) exit 0 ;;
esac

# Resolve symlinks before prefix check to prevent traversal
FILE_PATH=$(realpath "$FILE_PATH" 2>/dev/null) || exit 0
if [ -n "$PROJECT_TARGET" ]; then
    # An unresolvable target (deleted tree, typed corruption that
    # slipped the strings filter) clears the FILTER — the python twin
    # attributes unfiltered too; exiting here silently ended all
    # attribution for the run.
    PROJECT_TARGET=$(realpath "$PROJECT_TARGET" 2>/dev/null) || PROJECT_TARGET=""
fi
if [ -n "$PROJECT_TARGET" ]; then
    # Path-separator-anchored prefix match. Pre-fix the bare
    # `"$PROJECT_TARGET"*` glob matched any path starting with the
    # target STRING — so:
    #   PROJECT_TARGET=/home/user/foo
    #   FILE_PATH=/home/user/foobar/x.py
    # matched the prefix "/home/user/foo" even though `foobar/` is
    # a sibling, not a child. Reads under sibling-named projects
    # were silently attributed to the active project's coverage,
    # inflating its read counts and polluting the active manifest.
    # Match either an exact-equal target dir OR target dir + `/`.
    case "$FILE_PATH" in
        "$PROJECT_TARGET") ;;
        "$PROJECT_TARGET"/*) ;;
        *) exit 0 ;;
    esac
fi

# Append to manifest with an O_NOFOLLOW guard.
#
# Bash `>>` follows ANY symlink at the manifest path. The run dir
# is writable by sandboxed target-derived children (it is the
# sandbox's output= path), so a symlink planted at
# <run_dir>/.reads-manifest turned this unsandboxed hook into an
# append-to-arbitrary-user-file primitive (content = source
# paths). The Python twin (core/coverage/track_read.py) documents
# and defends this exact attack with O_NOFOLLOW; a race-free
# equivalent is not expressible with shell redirection (an
# `[ -L ]` pre-check leaves the classic TOCTOU window), so the
# append delegates to the named python helper mirroring the twin's
# semantics: O_NOFOLLOW + O_APPEND, path and line passed as argv
# DATA, never interpolated into python source. A single O_APPEND
# write of one short line is atomic on POSIX regular files, giving
# the same no-interleave guarantee the previous flock provided for
# concurrent hook fires. python3 is already a hard fallback
# dependency of this script's JSON parsing above.
manifest="${RUN_DIR}.reads-manifest"
command -v python3 >/dev/null 2>&1 || exit 0
python3 "$HELPER" append "$manifest" "$FILE_PATH" 2>/dev/null || exit 0
