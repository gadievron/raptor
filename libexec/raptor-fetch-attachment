#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Deterministic attachment download step for the crash-analysis pipeline.

Usage: raptor-fetch-attachment <bug-report.json> <url> <dest-file>

Downloads one attachment recorded in a schema-validated
``bug-report.json`` so the builder/analyzer agents never need a
network tool of their own. Constraints, all fail-closed:

  - the URL must appear verbatim in the report's ``attachments[].url``
    list — the only fetchable URLs are the ones the gated artifact
    records;
  - https only;
  - the transfer goes through ``core.http.EgressClient`` (in-process
    egress proxy: hostname allowlist pinned to the attachment's own
    host, private-IP / loopback resolution refused, size-capped body);
  - the destination is confined to the ``attachments/`` directory
    beside the bug report: only the final file name of ``<dest-file>``
    is honoured (sanitised to a conservative charset), and any parent
    (``..``) component refuses — the file name originates in the
    untrusted tracker, so it must never steer the write location.

The downloaded file is an untrusted crash input: callers feed it to
the instrumented target program, nothing else.

Exit codes: 0 success, 1 download/validation failure, 2 usage error.
"""
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.json import load_json  # noqa: E402
from core.security.log_sanitisation import sanitise_for_terminal as _sft  # noqa: E402

# Byte budget for bug-report.json: it is distilled from an untrusted
# bug tracker, so cap the read like every other libexec artifact
# reader rather than buffering a pathological file unbounded.
_MAX_REPORT_BYTES = 8 * 1024 * 1024


# Attachment file names come from the untrusted tracker (the agent
# composes <workdir>/attachments/<filename> from the report), so the
# kept name is reduced to a conservative charset.
_SAFE_NAME_CHARS = re.compile(r"[^A-Za-z0-9._-]")
_MAX_NAME_LEN = 128


def _confine_dest(dest_arg: str, report_path: Path) -> Path | None:
    """Confine the requested destination under the run's attachment
    directory (``attachments/`` beside the bug report).

    Only the final file name of *dest_arg* is honoured; a ``..``
    component anywhere refuses outright (None) rather than being
    silently repaired — a traversal-shaped name is a signal worth
    surfacing, not normalising. The name is then reduced to a
    conservative charset and stripped of leading dots/dashes so it can
    be neither an option shape nor a dotfile.
    """
    raw = Path(dest_arg)
    if ".." in raw.parts:
        return None
    name = raw.name
    if not name or name == ".":
        return None
    name = _SAFE_NAME_CHARS.sub("_", name)
    name = name.lstrip(".-")[:_MAX_NAME_LEN] or "attachment.bin"
    return report_path.resolve().parent / "attachments" / name


def _attachment_urls(report: object) -> set:
    if not isinstance(report, dict):
        return set()
    urls = set()
    attachments = report.get("attachments")
    if isinstance(attachments, list):
        for item in attachments:
            if isinstance(item, dict) and isinstance(item.get("url"), str):
                urls.add(item["url"])
    return urls


def main() -> int:
    if len(sys.argv) != 4:
        print(f"Usage: {sys.argv[0]} <bug-report.json> <url> <dest-file>",
              file=sys.stderr)
        return 2

    report_path, url = Path(sys.argv[1]), sys.argv[2]

    report = load_json(report_path, max_bytes=_MAX_REPORT_BYTES)
    if report is None:
        print(f"cannot parse bug report: {report_path}", file=sys.stderr)
        return 1

    if url not in _attachment_urls(report):
        # The URL comes verbatim from the untrusted bug report — the
        # scheme/host checks below never run on this refusal path, and
        # path bytes are unconstrained in any case.
        print(
            f"refusing download: {_sft(url, max_len=300)} is not recorded in "
            f"{report_path.name}'s attachments list",
            file=sys.stderr,
        )
        return 1

    try:
        parts = urlsplit(url)
    except ValueError as e:
        print(f"malformed url: {_sft(str(e), max_len=300)}", file=sys.stderr)
        return 1
    if parts.scheme.lower() != "https" or not parts.hostname:
        print("refusing download: attachment URLs must be https with a "
              "hostname", file=sys.stderr)
        return 1
    if parts.username is not None or parts.password is not None:
        print("refusing download: attachment URL carries credentials",
              file=sys.stderr)
        return 1

    dest = _confine_dest(sys.argv[3], report_path)
    if dest is None:
        print(
            "refusing download: destination must not contain parent "
            "('..') components and must end in a file name; the file "
            "is stored under the bug report's attachments/ directory",
            file=sys.stderr,
        )
        return 1
    if dest.parent.is_symlink():
        print(
            f"refusing download: {dest.parent} is a symlink — the "
            "attachments directory must be a real directory",
            file=sys.stderr,
        )
        return 1

    from core.http import HttpError
    from core.http.egress_backend import EgressClient
    client = EgressClient(allowed_hosts=[parts.hostname])
    try:
        body = client.get_bytes(url)
    except HttpError as e:
        print(f"download failed: {_sft(str(e), max_len=300)}", file=sys.stderr)
        return 1

    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.is_symlink():
        print(f"refusing download: {dest} is a symlink", file=sys.stderr)
        return 1
    dest.write_bytes(body)
    if str(dest) != sys.argv[3]:
        print(f"note: destination confined to {dest}", file=sys.stderr)
    print(f"OK: {_sft(url, max_len=300)} -> {dest} ({len(body)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
