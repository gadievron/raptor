#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Stage E SMT verb: CWE-125 / CWE-787 array out-of-bounds.

Usage:
  raptor-smt-check-oob --buffer-size SIZE --index INDEX
                       [--profile NAME] [--guard 'condition' ...]

``SIZE`` and ``INDEX`` name the buffer length and the index used at the
access site.  Each must be atomic: a single identifier (``count``), a
numeric literal (``16``, ``0x10``), or a balanced function-call shape
(``strlen(input)`` — treated as an unconstrained free variable, so a
``feasible=true`` verdict involving one is a hint, not proof).  Compound
arithmetic (``--index 'offset + length'``) is rejected with a clear
error; introduce a helper variable in ``--guard``
(``--guard 'idx == offset + length'``) and pass ``--index idx``, or use
raptor-smt-validate-path directly.

``--profile`` defaults to ``uint64`` since most modern bounds are
``size_t``-shaped.  Override when the index is ``int`` or narrower.

``--guard`` is repeatable; one visible bounds-check / path condition each.
If a check was bypassed on the dangerous path, pre-negate manually.

Output: JSON to stdout matching :func:`validate_path`'s shape.  Of interest:

  feasible=true   OOB IS reachable; ``model`` shows escaping index/size
  feasible=false  guards rule out OOB
  feasible=null   Z3 unavailable / unencodable

Notes:
  Only checks the upper bound (``index >= buffer_size``).  Negative-index
  escapes need a signed profile AND an explicit guard expression.
"""
import argparse
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.json import dumps_display  # noqa: E402

from packages.exploit_feasibility.smt_verbs import check_oob  # noqa: E402


def main() -> int:
    p = argparse.ArgumentParser(
        prog="raptor-smt-check-oob",
        description="Stage E SMT verb for CWE-125 / CWE-787 OOB access.",
    )
    p.add_argument("--buffer-size", required=True, dest="buffer_size",
                   help="Identifier/expression naming the buffer length")
    p.add_argument("--index", required=True,
                   help="Identifier/expression naming the index")
    p.add_argument("--profile", default="uint64",
                   help="Bitvector profile name (default: uint64)")
    p.add_argument("--guard", action="append", default=[],
                   help="Visible bounds-check / path condition (repeat)")
    # Accept --source and --function for compatibility with sweep runner
    p.add_argument("--source", default=None, help=argparse.SUPPRESS)
    p.add_argument("--function", default=None, help=argparse.SUPPRESS)
    args = p.parse_args()

    try:
        result = check_oob(
            args.buffer_size,
            args.index,
            profile=args.profile,
            guards=args.guard,
        )
    except (TypeError, ValueError) as e:
        print(f"raptor-smt-check-oob: {e}", file=sys.stderr)
        return 2

    sys.stdout.write(dumps_display(result))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
