#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Deterministic repository clone step for agent workflows.

Usage: raptor-clone-repo <url> <target-dir> [--depth N | --full | --mirror]

Routes the clone through ``core.git.clone.clone_repository`` so an
agent-driven pipeline (e.g. /crash-analysis) never runs a bare
``git clone`` against an untrusted remote: the helper applies the
repository-URL allowlist, the sandboxed git runner (network egress
pinned to the git hosts, landlocked writes, hardened env), and the
bounded clone timeout.

Default is a full-history clone (crash analysis bisects and inspects
history); pass ``--depth N`` for a shallow clone, or ``--mirror`` for
a bare all-refs mirror (git forensics: dangling / force-pushed
history needs refs a plain clone never fetches).

Exit codes: 0 success, 1 clone/validation failure, 2 usage error.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def main() -> int:
    args = sys.argv[1:]
    depth = None
    full = "--full" in args
    if full:
        args.remove("--full")
    mirror = "--mirror" in args
    if mirror:
        args.remove("--mirror")
    if mirror and "--depth" in args:
        # A mirror is by definition complete; a shallow mirror would
        # betray the forensic purpose, so refuse the combination.
        print("--depth and --mirror are mutually exclusive",
              file=sys.stderr)
        return 2
    if "--depth" in args:
        # --full asks for complete history while --depth asks for a
        # shallow clone; honouring one silently would betray the other,
        # so refuse the contradictory combination outright.
        if full:
            print("--depth and --full are mutually exclusive",
                  file=sys.stderr)
            return 2
        i = args.index("--depth")
        try:
            depth = int(args[i + 1])
        except (IndexError, ValueError):
            print("--depth requires an integer argument", file=sys.stderr)
            return 2
        del args[i:i + 2]
        if depth < 1:
            print("--depth must be >= 1", file=sys.stderr)
            return 2

    if len(args) != 2:
        print(f"Usage: {sys.argv[0]} <url> <target-dir> "
              "[--depth N | --full | --mirror]",
              file=sys.stderr)
        return 2

    url, target = args
    from core.git.clone import clone_repository
    try:
        clone_repository(url, Path(target).resolve(), depth=depth,
                         mirror=mirror)
    except (ValueError, RuntimeError) as e:
        print(f"clone failed: {e}", file=sys.stderr)
        return 1
    print(f"OK: cloned {url} -> {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
