#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Read-only query surface for RAPTOR's internal understand graph."""

from __future__ import annotations

import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

import argparse  # noqa: E402
import json  # noqa: E402

from core.security.log_sanitisation import (  # noqa: E402
    escape_nonprintable,
    sanitise_for_terminal as _sft,
)


def _term_block(value: object, max_len: int = 8_000) -> str:
    """Escape a multi-line hostile-influenced block for terminal
    display: control/BIDI bytes escaped, real newlines preserved,
    length bounded with an explicit elision marker."""
    out = escape_nonprintable(str(value), preserve_newlines=True)
    if len(out) > max_len:
        out = out[:max_len] + f"...[+{len(out) - max_len} chars]"
    return out


def _parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="raptor-graph-query",
        description="Query RAPTOR's project/run SQLite graph memory.",
    )
    src = p.add_mutually_exclusive_group()
    src.add_argument("--db", help="Path to raptor.graph.sqlite")
    src.add_argument("--run-dir", help="Run directory containing graph/")
    src.add_argument("--project", help="Project name whose graph should be queried")
    p.add_argument("--target", help="Target path for snapshot selection/staleness checks")
    p.add_argument("--summary", action="store_true", help="Show graph summary")
    p.add_argument("--reachable-sinks", action="store_true", help="List entry-to-sink reachability edges")
    p.add_argument("--paths", action="store_true", help="List graph-derived entry-to-sink attack paths")
    p.add_argument("--source", help="Filter paths by entry/source ID, name, or location")
    p.add_argument("--sink", help="Filter paths by sink ID, name, or location")
    p.add_argument("--unchecked-only", action="store_true", help="Only show paths with no mapped effective boundary")
    p.add_argument("--by-cwe", help="Filter paths by CWE/CWE-like token")
    p.add_argument("--limit", type=int, default=None,
                   help="Maximum rows to return (per-lane default when omitted)")
    p.add_argument("--diff", action="store_true", help="Diff the latest two graph snapshots")
    p.add_argument("--base-snapshot", help="Base snapshot ID for --diff")
    p.add_argument("--head-snapshot", help="Head snapshot ID for --diff")
    p.add_argument("--threat-context", action="store_true", help="Emit compact graph-backed risk context for threat modelling")
    p.add_argument("--context-map", action="store_true", help="Emit graph as context-map-compatible JSON")
    p.add_argument("--hypothesis-seeds", action="store_true", help="List functions connected to prior findings/hypotheses")
    p.add_argument("--fuzz-targets", action="store_true", help="List graph-derived fuzz target candidates")
    p.add_argument("--dedup-chains", action="store_true", help="Show finding→entry-point dedup chains")
    p.add_argument("--coverage-residual", action="store_true", help="List functions not yet covered by findings")
    p.add_argument("--dashboard", action="store_true", help="Show dashboard summary counts")
    p.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    return p


def _resolve_db(args: argparse.Namespace) -> Path:
    if args.db:
        return Path(args.db)
    if args.project:
        from core.project.project import ProjectManager

        project = ProjectManager().load(args.project)
        if not project:
            raise SystemExit(f"project not found: {args.project}")
        return Path(project.output_dir) / "graph" / "raptor.graph.sqlite"
    from core.understand_graph import graph_path_for_run

    return graph_path_for_run(Path(args.run_dir or "."), args.target)


def main() -> int:
    args = _parser().parse_args()
    if not (
        args.summary or args.reachable_sinks or args.paths or args.context_map
        or args.diff or args.threat_context or args.hypothesis_seeds
        or args.fuzz_targets or args.dedup_chains or args.coverage_residual
        or args.dashboard
    ):
        args.summary = True
    db_path = _resolve_db(args)

    from core.understand_graph import (
        attack_paths,
        build_context_map,
        coverage_residual,
        dashboard_summary,
        fuzz_targets,
        graph_diff,
        graph_summary,
        hypothesis_seeds,
        reachable_sinks,
        scan_dedup_chains,
        threat_model_graph_context,
    )

    # --target / --limit forward to EVERY lane: a dropped --target
    # answers a target-A query with whatever codebase was ingested
    # most recently while claiming target scope, and that text reaches
    # prompt seeding. When --limit is omitted each lane keeps its own
    # default.
    limit_kwargs = {} if args.limit is None else {"limit": args.limit}
    if args.hypothesis_seeds:
        payload = {"seeds": hypothesis_seeds(db_path, args.target, **limit_kwargs)}
    elif args.fuzz_targets:
        payload = {"fuzz_targets": fuzz_targets(db_path, args.target, **limit_kwargs)}
    elif args.dedup_chains:
        payload = {"dedup_chains": scan_dedup_chains(db_path, args.target)}
    elif args.coverage_residual:
        payload = {"residual": coverage_residual(db_path, args.target)}
    elif args.dashboard:
        payload = dashboard_summary(db_path)
    elif args.context_map:
        context_map, stale = build_context_map(db_path, args.target)
        payload = {"context_map": context_map, "stale_files": sorted(stale)}
    elif args.diff:
        payload = graph_diff(
            db_path,
            args.target,
            base_snapshot=args.base_snapshot,
            head_snapshot=args.head_snapshot,
        )
    elif args.paths:
        payload = {
            "paths": attack_paths(
                db_path,
                args.target,
                source=args.source,
                sink=args.sink,
                unchecked_only=args.unchecked_only,
                by_cwe=args.by_cwe,
                limit=args.limit if args.limit is not None else 50,
            )
        }
    elif args.threat_context:
        payload = {
            "graph_context": threat_model_graph_context(
                db_path,
                args.target,
                limit=args.limit if args.limit is not None else 50,
            )
        }
    elif args.reachable_sinks:
        payload = {"reachable_sinks": reachable_sinks(db_path, args.target)}
    else:
        payload = graph_summary(db_path)

    if args.json or args.context_map or args.diff or args.hypothesis_seeds or args.fuzz_targets or args.dedup_chains or args.coverage_residual or args.dashboard:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0

    if not payload.get("exists", True):
        print(f"Graph: not found ({db_path})")
        return 1
    # Everything below interpolates graph-store content into the
    # operator TTY. The store lives in the run/project directory whose
    # write grant sandboxed target code holds, and the kind/count keys
    # are read straight from its rows — like node ids / labels / paths
    # (scanned-tree file and function names, LLM hypothesis text),
    # every lane escapes at the sink; the prompt consumers of the same
    # strings ride the envelope instead.
    if "nodes" in payload:
        print(f"Graph: {_sft(str(payload.get('path', db_path)))}")
        latest = payload.get("latest_snapshot") or {}
        if latest.get("target_path"):
            print(f"Target: {_sft(str(latest['target_path']))}")
        print("Nodes:")
        for kind, count in sorted((payload.get("nodes") or {}).items()):
            print(f"  {_sft(str(kind), max_len=64)}: {count}")
        print("Edges:")
        for kind, count in sorted((payload.get("edges") or {}).items()):
            print(f"  {_sft(str(kind), max_len=64)}: {count}")
        return 0
    if "paths" in payload:
        for item in payload.get("paths", []):
            entry = item.get("entry", {})
            sink = item.get("sink", {})
            status = "unchecked" if item.get("unchecked") else "bounded"
            print(
                f"{_sft(str(entry.get('id') or '?'))} {_sft(str(entry.get('label') or '?'))}"
                f" -> {_sft(str(sink.get('id') or '?'))} {_sft(str(sink.get('label') or '?'))}"
                f" ({status}, {_sft(str(item.get('confidence') or 'candidate'))},"
                # risk_score is computed as an int at query time (never
                # a stored column); escaped anyway so the lane stays
                # safe if that provenance changes.
                f" risk={_sft(str(item.get('risk_score')), max_len=32)})"
            )
            if item.get("missing_boundary"):
                print(f"  missing: {_sft(str(item['missing_boundary']), max_len=500)}")
        return 0
    if "graph_context" in payload:
        print(_term_block(payload.get("graph_context") or "No graph-backed risks found."))
        return 0
    for item in payload.get("reachable_sinks", []):
        src = item.get("source") or item.get("source_file") or "source"
        sink = item.get("sink") or item.get("sink_file") or "sink"
        print(f"{_sft(str(src))} -> {_sft(str(sink))} ({_sft(str(item.get('confidence') or 'candidate'))})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
