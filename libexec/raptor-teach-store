#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Store a teach session's structured concepts to SAGE (TEACH-4).

Usage: raptor-teach-store <target> <teach-json-file>

The teach JSON quotes target-authored source lines verbatim
(``observation`` strings), so it must NEVER ride a shell command
line: the previous instruction-file ``python3 -c "..."`` block pasted
the dict literal into a double-quoted program, letting the shell
expand ``$(...)`` carried in scanned-repo bytes. The JSON is written
to a file (Write tool) and only its PATH arrives here as argv.
"""
import json
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def main() -> int:
    if len(sys.argv) != 3:
        print("Usage: raptor-teach-store <target> <teach-json-file>",
              file=sys.stderr)
        return 1

    target = sys.argv[1]
    json_path = Path(sys.argv[2])
    try:
        teach_json = json.loads(json_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        print(f"raptor-teach-store: cannot read {json_path}: {exc}",
              file=sys.stderr)
        return 1
    if not isinstance(teach_json, dict):
        print(f"raptor-teach-store: {json_path} must contain a JSON object",
              file=sys.stderr)
        return 1

    from core.sage.hooks import store_teach_concepts

    stored = store_teach_concepts(repo_path=target, teach_json=teach_json)
    print(f"Stored {stored} concepts to SAGE")
    return 0


if __name__ == "__main__":
    sys.exit(main())
