#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""CLI shim for the parser-API pack harvester.

Extracts parser/decoder API names from CVE-fix history (local clones of
parsing libraries, or recorded fix-diff directories) into the
parser_apis data pack consumed by core.function_taxonomy.

Run via ``bin/raptor`` (which sets ``CLAUDECODE``) or with
``_RAPTOR_TRUSTED=1`` for direct invocation in tests.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

from core.dataflow.parser_pack_harvest import main  # noqa: E402

sys.exit(main())
