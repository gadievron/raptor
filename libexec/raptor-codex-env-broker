#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Internal same-user session broker; no command execution interface."""
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(REPO_ROOT))
import core.startup.process_init  # noqa: E402,F401
from core.startup.codex_broker import serve  # noqa: E402

if __name__ == "__main__":
    from core.run.cli_outcome import cli_outcome
    with cli_outcome():
        if len(sys.argv) != 2:
            sys.exit(2)
        serve(sys.argv[1])
