#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Coverage query and update tool.

Usage:
  raptor-coverage-summary [<dir>] [--detailed]          Show coverage summary
  raptor-coverage-summary [<dir>] --store               Show persistent-store view
                                                        (category/depth + LLM-review gap)
  raptor-coverage-summary [<dir>] --gaps                List unreviewed items
  raptor-coverage-summary [<dir>] --mark <file:item>    Mark item(s) as reviewed
  raptor-coverage-summary [<dir>] --mark-file <json>    Mark functions from JSON file
  raptor-coverage-summary [<dir>] --unmark <file:item>  Remove item from reviewed
  raptor-coverage-summary [<dir>] --import <path>       Ingest external runtime
      [--format gcov|lcov|coverage.py] [--tool <label>] coverage (gcov/lcov/
                                                        coverage.py) into the store

If <dir> is omitted, uses the active project.
Accepts: project output dir, run dir, target path, or project name.
"""
import sys
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from collections.abc import Callable

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

import logging  # noqa: E402

logger = logging.getLogger(__name__)


def _is_project_dir(d: Path) -> bool:
    if not (d / "checklist.json").exists():
        return False
    for child in d.iterdir():
        if child.is_dir() and (child / ".raptor-run.json").exists():
            return True
    return False


def _is_run_dir(d: Path) -> bool:
    """Run-dir discriminator.

    Pre-fix the predicate matched any directory with EITHER
    `.raptor-run.json` OR `checklist.json` — but `checklist.json`
    is ALSO present in project directories (project-level
    checklist). The bug was masked at the call site by check
    order: `_is_project_dir(d)` is tested FIRST in
    `_resolve_dir`, so a project dir was correctly classified
    despite this predicate claiming True.

    "Saved by check order" is fragile — any future caller that
    skips the project-dir check (or reorders) hits the
    misclassification. Tighten the predicate to require the
    run-specific marker (`.raptor-run.json`) AND the absence of
    a project-level marker. `checklist.json` alone is no longer
    sufficient because it's ambiguous between project and run
    dirs.
    """
    if not (d / ".raptor-run.json").exists():
        return False
    # Negative check: project-dir marker should NOT be present.
    # `_is_project_dir` is the canonical project-dir check; if
    # the dir has both markers, it's a project dir, not a run.
    if _is_project_dir(d):
        return False
    return True


def _resolve_dir(path_arg: str):
    """Resolve to (Project, None) or (None, run_dir) or (None, None)."""
    from core.project.project import Project, ProjectManager

    target_dir = Path(path_arg).resolve()

    if target_dir.exists() and _is_project_dir(target_dir):
        return Project(name="", target="", output_dir=str(target_dir)), None

    if target_dir.exists() and _is_run_dir(target_dir):
        return None, target_dir

    # Try project name
    try:
        mgr = ProjectManager()
        p = mgr.load(path_arg)
        if p:
            return p, None
    except Exception as exc:
        logger.debug("project load failed for %s: %s", path_arg, exc)

    # Try target path → project
    try:
        mgr = ProjectManager()
        project = mgr.find_project_for_target(str(target_dir))
        if project:
            return project, None
    except Exception as exc:
        logger.debug("find_project_for_target failed: %s", exc)

    if target_dir.exists():
        return None, None
    return None, None


def _resolve_active_project():
    try:
        from core.project.project import ProjectManager
        mgr = ProjectManager()
        name = mgr.get_active()
        if name:
            return mgr.load(name)
    except Exception as exc:
        logger.debug("active project resolution failed: %s", exc)
    return None


def _store_inputs(args):
    """Resolve (checklist, run_dirs, store_path, annotations_base)."""
    from core.json import load_json

    project = run_dir = None
    if args:
        project, run_dir = _resolve_dir(args[0])
        if not project and not run_dir:
            d = Path(args[0])
            if d.exists():
                run_dir = d
    else:
        project = _resolve_active_project()

    if project:
        base = Path(project.output_dir)
        try:
            run_dirs = list(project.get_run_dirs(sweep=False))
        except Exception:
            run_dirs = []
        return (load_json(base / "checklist.json"), run_dirs,
                base / "coverage.json", base / "annotations")
    if run_dir:
        return (load_json(run_dir / "checklist.json"), [run_dir],
                run_dir / "coverage.json", run_dir / "annotations")
    return None, [], None, None


def _cmd_gaps(view):
    """Print the LLM-review gap — reviewable units (function/top_level) with no
    LLM review. Globals/macros/typedefs/glue are excluded by design."""
    if not view:
        print("No coverage data.")
        return
    gaps = view.get("llm_gap_functions", [])
    if not gaps:
        print("All reviewable items examined by an LLM.")
        return
    print(f"{len(gaps)} item{'s' if len(gaps) != 1 else ''} with no LLM review:")
    for g in gaps:
        print(f"  {g['file']}:{g['function']}")


def _journal_marks(run_dir, marked, verdict_by_key):
    """Journal marks as review assertions so they are durable and
    hash-aware.

    The run-local coverage-llm.json record suppresses gaps only for
    audits of the SAME run dir; a mark journaled into the project index
    survives run deletion, suppresses cross-run via the hash-verified
    fold, and resurfaces automatically when the function's source
    drifts. Best-effort: no project context (standalone run dir, no
    checklist) keeps the record-only behaviour.

    Returns the number of entries journaled.
    """
    project_dir = run_dir.parent
    if not (project_dir / "checklist.json").exists():
        return 0
    try:
        from core.audit.record import _compute_hash  # collector's exact algorithm
        from core.coverage.journal import (
            ReviewJournalEntry,
            append_entry,
            merge_into_index,
            now_iso,
        )
        from core.json import load_json

        checklist = load_json(project_dir / "checklist.json") or {}
        target = checklist.get("target_path") or ""
        ranges = {}
        for f in checklist.get("files", []):
            # Key-presence semantics, same as _checklist_item_keys and the
            # store fold: an `items` key — even an empty list — supersedes
            # legacy `functions`. A truthiness fallback here would journal
            # line ranges from `functions` entries the fold never credits.
            for it in f.get("items", f.get("functions", [])) or []:
                if it.get("name"):
                    ranges[(f.get("path"), it["name"])] = (
                        it.get("line_start") or 0, it.get("line_end"),
                    )
        for file_path, func_name in marked:
            lo, hi = ranges.get((file_path, func_name), (0, None))
            source_hash = ""
            if target and lo:
                source_hash = _compute_hash(
                    Path(target), file_path, lo, hi,
                ) or ""
            append_entry(run_dir, ReviewJournalEntry(
                ts=now_iso(), run_id=run_dir.name,
                file=file_path, function=func_name,
                verdict=verdict_by_key.get(
                    (file_path, func_name), "clean"),
                source_hash=source_hash,
                line_start=lo, line_end=hi,
                model="operator", producer="mark",
            ))
        return merge_into_index(project_dir, run_dir)
    except Exception as exc:  # noqa: BLE001 — journaling is additive
        print(f"WARNING: mark journaling skipped: {exc}", file=sys.stderr)
        return 0


def _load_run_checklist(run_dir: Path) -> dict | None:
    """checklist.json from the run dir, else its project parent."""
    from core.json import load_json

    for base in (run_dir, run_dir.parent):
        path = base / "checklist.json"
        if path.exists():
            checklist = load_json(path)
            if isinstance(checklist, dict):
                return checklist
    return None


def _checklist_item_keys(checklist: dict) -> set[tuple[str, str]] | None:
    """(file, item-name) pairs from the inventory, or None when it yields
    no keys (nothing to validate against — marks then can't be checked
    and are accepted as-is)."""
    keys: set[tuple[str, str]] = set()
    for f in checklist.get("files", []) or []:
        if not isinstance(f, dict) or not f.get("path"):
            continue
        # Same key-presence semantics as the store fold: an `items` key,
        # even an empty list, supersedes legacy `functions` — the gate
        # must accept exactly what the fold would credit.
        for it in f.get("items", f.get("functions", [])) or []:
            if isinstance(it, dict) and it.get("name"):
                keys.add((f["path"], it["name"]))
    return keys or None


def _build_path_normaliser(
    run_dir: Path,
) -> "tuple[set[tuple[str, str]] | None, Callable[[str], str] | None]":
    """(valid_keys, normalise_path) for the run's checklist.

    Operators spell paths the way tools do (absolute, ./-prefixed,
    relative to another root) while the inventory keys on
    target-relative paths. The store importer resolves
    functions_analysed entries through _to_inventory_path; mark AND
    unmark must accept exactly the spellings the fold would credit and
    resolve to the stored key so the join lands. Returns (None, None)
    when the checklist yields no keys (nothing to normalise against).
    """
    checklist = _load_run_checklist(run_dir)
    if not checklist:
        return None, None
    valid_keys = _checklist_item_keys(checklist)
    if valid_keys is None:
        return None, None
    from core.coverage.importer import _inventory_paths, _to_inventory_path
    from core.coverage.summary import _inventory_name_index
    inv_paths = _inventory_paths(checklist)
    inv_index = _inventory_name_index(inv_paths)

    def normalise_path(p: str) -> str:
        return _to_inventory_path(p, inv_paths, inv_index)

    return valid_keys, normalise_path


def _cmd_mark(mark_targets: list, run_dir: Path | None,
              statuses: dict[tuple[str, str], str] | None = None) -> None:
    """Mark items as reviewed in the coverage record."""
    if not run_dir:
        print("ERROR: cannot determine run directory for --mark.", file=sys.stderr)
        print("Specify a run directory explicitly.", file=sys.stderr)
        sys.exit(1)

    from core.coverage.record import load_records, write_record

    # Load existing LLM record or create new
    records = load_records(run_dir)
    llm_record = None
    for r in records:
        if r.get("tool") == "llm":
            llm_record = r
            break

    if not llm_record:
        from datetime import datetime, timezone
        llm_record = {
            "tool": "llm",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "files_examined": [],
            "functions_analysed": [],
        }

    existing_funcs = {
        (fa.get("file"), fa.get("function"))
        for fa in llm_record.get("functions_analysed", [])
    }

    # Validate marks against the inventory: a mark naming a nonexistent
    # (file, item) pair must not record phantom review credit — the store
    # and journal folds join on the checklist, so a phantom entry claims
    # coverage no gap query can ever surface or withdraw.
    valid_keys, normalise_path = _build_path_normaliser(run_dir)

    statuses = dict(statuses or {})
    added = 0
    marked = []
    unmatched = []
    for target in mark_targets:
        # --mark-file passes structured (file, item) pairs so item names
        # containing ':' (e.g. C++ qualified names) survive intact; the
        # CLI --mark form stays a 'file:item' string.
        if isinstance(target, tuple):
            file_path, func_name = target
        else:
            if ":" not in target:
                print(f"WARNING: skipping '{target}' (expected file:function)",
                      file=sys.stderr)
                continue
            file_path, func_name = target.rsplit(":", 1)
        if normalise_path is not None:
            raw_key = (file_path, func_name)
            file_path = normalise_path(file_path)
            if raw_key in statuses:
                statuses.setdefault((file_path, func_name), statuses[raw_key])
        if valid_keys is not None and (file_path, func_name) not in valid_keys:
            unmatched.append((file_path, func_name))
            continue
        if (file_path, func_name) not in existing_funcs:
            llm_record.setdefault("functions_analysed", []).append(
                {"file": file_path, "function": func_name}
            )
            existing_funcs.add((file_path, func_name))
            marked.append((file_path, func_name))
            added += 1
    for file_path, func_name in unmatched:
        print(f"WARNING: no checklist item matches "
              f"{file_path}:{func_name} — not marked", file=sys.stderr)
    # Marking a function records function-level review only — it must NOT add
    # the file to files_examined (which is the whole-file "tool scanned this
    # file" signal; the store would otherwise mark the entire file reviewed).
    write_record(run_dir, llm_record, tool_name="llm")
    journaled = _journal_marks(run_dir, marked, statuses or {})
    durable = " (journaled to project index)" if journaled else ""
    skipped = f" ({len(unmatched)} unmatched)" if unmatched else ""
    print(f"Marked {added} item{'s' if added != 1 else ''} "
          f"as reviewed{skipped} in {run_dir.name}{durable}")


def _cmd_unmark(unmark_targets, run_dir):
    """Remove functions from the LLM coverage record."""
    if not run_dir:
        print("ERROR: cannot determine run directory for --unmark.", file=sys.stderr)
        sys.exit(1)

    from core.coverage.record import load_records, write_record

    records = load_records(run_dir)
    llm_record = None
    for r in records:
        if r.get("tool") == "llm":
            llm_record = r
            break

    if not llm_record:
        print("No LLM coverage record found.")
        return

    # Unmark must resolve operator path spellings exactly the way mark
    # does — mark stores the checklist-normalised key, so an unmark that
    # kept the raw spelling would remove nothing and leave the journaled
    # review credit standing. The raw key is kept alongside so legacy
    # records stored before normalisation still match.
    _valid_keys, normalise_path = _build_path_normaliser(run_dir)

    to_remove = set()
    for target in unmark_targets:
        if ":" not in target:
            print(f"WARNING: skipping '{target}' (expected file:function)", file=sys.stderr)
            continue
        file_path, func_name = target.rsplit(":", 1)
        to_remove.add((file_path, func_name))
        if normalise_path is not None:
            to_remove.add((normalise_path(file_path), func_name))

    original = len(llm_record.get("functions_analysed", []))
    llm_record["functions_analysed"] = [
        fa for fa in llm_record.get("functions_analysed", [])
        if (fa.get("file"), fa.get("function")) not in to_remove
    ]
    removed = original - len(llm_record["functions_analysed"])

    write_record(run_dir, llm_record, tool_name="llm")
    # Neutralise any journaled mark for the same key: the journal is
    # append-only, so unmark appends a NEWER error-verdict entry under
    # the same (file, function, operator) index key — the index's
    # latest-wins merge replaces the mark row, and error verdicts are
    # skipped by both import_journal and the gap folds, restoring the
    # function to the gap list.
    _neutralise_journaled_marks(run_dir, sorted(to_remove))
    print(f"Removed {removed} item{'s' if removed != 1 else ''} from reviewed in {run_dir.name}")


def _neutralise_journaled_marks(run_dir, keys):
    project_dir = run_dir.parent
    if not (project_dir / "checklist.json").exists():
        return
    try:
        from core.coverage.journal import (
            INDEX_FILENAME,
            ReviewJournalEntry,
            append_entry,
            merge_into_index,
            now_iso,
        )
        from core.json import load_json
        index = load_json(project_dir / INDEX_FILENAME) or {}
        # Per-SITE: the index keys marks by (…, line_start), so a
        # withdrawal must land on the SAME span to evict the mark row
        # — one neutralising entry per journaled mark site.
        journaled: dict = {}
        for row in (index.get("entries") or {}).values():
            if isinstance(row, dict) and row.get("producer") == "mark":
                journaled.setdefault(
                    (row.get("file"), row.get("function")), set(),
                ).add(int(row.get("line_start") or 0))
        touched = False
        for file_path, func_name in keys:
            for line_start in sorted(
                    journaled.get((file_path, func_name), ())):
                append_entry(run_dir, ReviewJournalEntry(
                    ts=now_iso(), run_id=run_dir.name,
                    file=file_path, function=func_name,
                    verdict="error", source_hash="",
                    line_start=line_start,
                    lesson="operator unmark — review assertion withdrawn",
                    model="operator", producer="mark",
                ))
                touched = True
        if touched:
            merge_into_index(project_dir, run_dir)
    except Exception as exc:  # noqa: BLE001 — neutralisation is additive
        print(f"WARNING: unmark journaling skipped: {exc}", file=sys.stderr)


def _cmd_import(import_path, fmt, tool, args):
    """Ingest external runtime coverage (gcov/lcov/coverage.py) into the target's
    durable store. The positional <dir> (if any) resolves the project/run store;
    --import names the coverage artifact. Persists under the store lock."""
    from core.coverage.importer import import_runtime
    from core.coverage.store import CoverageStore, coverage_store_lock

    if not Path(import_path).exists():
        print(f"ERROR: coverage path not found: {import_path}", file=sys.stderr)
        sys.exit(1)
    checklist, _run_dirs, store_path, _ann = _store_inputs(args)
    if not checklist or not store_path:
        print("ERROR: no inventory (checklist.json) for the target — runtime "
              "coverage needs a project/run with an inventory. Specify a project "
              "or run dir.", file=sys.stderr)
        sys.exit(1)
    with coverage_store_lock(store_path):
        store = CoverageStore(store_path)
        n = import_runtime(store, import_path, checklist, fmt=fmt, tool=tool)
        store.save()
    print(f"Imported {n} runtime coverage range(s) from {import_path} -> {store_path}")


def main():
    argv = sys.argv[1:]

    if "-h" in argv or "--help" in argv:
        # Hand-rolled flag walker (no argparse) — pre-fix an operator's
        # --help was silently ignored and the summary ran instead.
        print(__doc__.strip())
        return

    # --import <path> [--format <fmt>] [--tool <label>]: ingest external runtime
    # coverage. Extract the flag+value pairs up front so the path value isn't
    # later mistaken for a positional <dir>.
    def _take_opt(flag, av):
        if flag in av:
            i = av.index(flag)
            if i + 1 >= len(av):
                # A value-taking flag with no value must not silently
                # degrade to the default summary view — the operator
                # asked for an import/format/tool and would get no
                # diagnostic that the request was discarded.
                print(f"ERROR: {flag} requires a value", file=sys.stderr)
                sys.exit(1)
            return av[i + 1], av[:i] + av[i + 2:]
        return None, av
    import_path, argv = _take_opt("--import", argv)
    import_fmt, argv = _take_opt("--format", argv)
    import_tool, argv = _take_opt("--tool", argv)

    detailed = "--detailed" in argv
    show_gaps = "--gaps" in argv
    # `--store` is the default behaviour now; accepted (and stripped as a
    # flag) for back-compat, no separate branch.

    # Extract --mark, --mark-file, --unmark targets
    mark_targets = []
    mark_statuses = {}
    unmark_targets = []
    if "--mark-file" in argv:
        idx = argv.index("--mark-file")
        if idx + 1 >= len(argv):
            # Same contract as _take_opt: a dangling value-taking flag
            # errors instead of silently running the default summary.
            print("ERROR: --mark-file requires a value", file=sys.stderr)
            sys.exit(1)
        mark_file = Path(argv[idx + 1])
        if not mark_file.exists():
            print(f"ERROR: file not found: {mark_file}", file=sys.stderr)
            sys.exit(1)
        from core.json import load_json
        entries = load_json(mark_file)
        if not isinstance(entries, list):
            print("ERROR: mark file must be a JSON array of {file, item} objects",
                  file=sys.stderr)
            sys.exit(1)
        for e in entries:
            f = e.get("file", "")
            name = e.get("item") or e.get("function") or e.get("global") or e.get("macro", "")
            if f and name:
                # Keep the structured pair — flattening to 'file:item'
                # and re-splitting on the last colon mangles item names
                # containing ':' (C++ 'ns::fn') and orphans their
                # per-entry status.
                mark_targets.append((f, name))
                # Optional per-entry verdict for the journaled mark
                # (clean when absent). Journal verdict enum only.
                st = e.get("status")
                if st in ("clean", "suspicious", "finding", "dormant"):
                    mark_statuses[(f, name)] = st
        argv = argv[:idx] + argv[idx + 2:]
    # Process --mark / --unmark in a SINGLE pass so flag order
    # doesn't matter. Pre-fix the if-else sequence below
    # processed `--mark` first then truncated `argv` to
    # `argv[:idx_of_mark]`; if the operator passed
    # `--mark a b --unmark c`, the truncation at step 1
    # discarded everything from `--mark` onward — including
    # the `--unmark c` that came AFTER. Subsequent
    # `if "--unmark" in argv:` then saw a truncated argv
    # WITHOUT --unmark and silently no-op'd. The operator's
    # explicit unmark request was dropped.
    #
    # Two-pass: collect all --mark/--unmark slices first,
    # then do a single truncation at the smallest index so
    # downstream positional-arg extraction sees the same
    # cleaned-up argv it expected.
    def _slurp_after(flag: str) -> list:
        if flag not in argv:
            return []
        i = argv.index(flag)
        out = []
        for a in argv[i + 1:]:
            if a.startswith("--"):
                break
            out.append(a)
        if not out:
            # A --mark/--unmark with no targets must not fall through
            # to the default summary as if nothing was requested.
            print(f"ERROR: {flag} requires at least one file:item argument",
                  file=sys.stderr)
            sys.exit(1)
        return out
    mark_extra = _slurp_after("--mark")
    unmark_extra = _slurp_after("--unmark")
    mark_targets.extend(mark_extra)
    unmark_targets.extend(unmark_extra)
    # Now truncate argv at the FIRST appearance of either flag
    # so positional-arg extraction below isn't confused by the
    # mark/unmark tokens.
    cut_indices = [
        argv.index(f) for f in ("--mark", "--unmark") if f in argv
    ]
    if cut_indices:
        argv = argv[: min(cut_indices)]

    # Remaining positional args (after removing flags)
    args = [a for a in argv if not a.startswith("--")]

    if mark_targets or unmark_targets:
        run_dir = None
        project = None
        if args:
            project, run_dir = _resolve_dir(args[0])
            if not run_dir:
                d = Path(args[0])
                if d.exists() and _is_run_dir(d):
                    run_dir = d
        if not run_dir:
            p = project or _resolve_active_project()
            if p:
                try:
                    dirs = p.get_run_dirs(sweep=False)
                    if dirs:
                        run_dir = dirs[0]
                except Exception as exc:
                    logger.debug("get_run_dirs failed: %s", exc)
        if mark_targets:
            _cmd_mark(mark_targets, run_dir, statuses=mark_statuses)
        if unmark_targets:
            _cmd_unmark(unmark_targets, run_dir)
        return

    if import_path:
        _cmd_import(import_path, import_fmt, import_tool, args)
        return

    # All report views go through the unified store-backed renderer. `--store`
    # is now the default behaviour; the flag is accepted for back-compat.
    from core.coverage.store_summary import coverage_view, render_coverage

    checklist, run_dirs, store_path, annotations_base = _store_inputs(args)

    if show_gaps:
        _cmd_gaps(coverage_view(run_dirs, checklist, store_path, annotations_base))
        return

    report = render_coverage(
        run_dirs, checklist, store_path, annotations_base, detailed=detailed)
    if not report:
        print("No coverage data (missing checklist.json or coverage records).", file=sys.stderr)
        return
    print(report)


if __name__ == "__main__":
    main()
