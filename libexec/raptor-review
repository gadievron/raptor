#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Unified operator CLI for reviewing audit state across all layers.

Assembles mechanical coverage, review journal, context-map roles, and
operator annotations into a single view.  Degrades gracefully when any
layer is absent.

Usage:
  raptor-review [show] <file> [function]   # unified per-function view
  raptor-review findings                   # all findings across runs
  raptor-review gaps                       # what needs review, and why
  raptor-review coverage [file]            # mechanical tool coverage
  raptor-review edges                      # edge obligations, verdicts, blind spots
  raptor-review note <file> <fn> -m "..."  # add operator note
  raptor-review edit <file> <fn>           # edit note in $EDITOR
  raptor-review stale                      # source-drifted operator notes
  raptor-review notes                      # list all operator notes
  raptor-review history <file> <fn>        # all reviews over time
  raptor-review stats                      # entry counts, costs, coverage %
  raptor-review diff [run1 run2]           # verdict changes between two runs
  raptor-review live                       # tail-follow a running audit's journal
  raptor-review compact                    # compact project journal index
  raptor-review verdict <id> fp|tp|retest  # record a human verdict on a finding
                                           # (fp gates on the live-context
                                           #  operator grant, which refuses the
                                           #  dispatch trust markers every
                                           #  shipped launcher route carries —
                                           #  fp does not mint in production;
                                           #  use /annotate for operator FP
                                           #  assertions, tp/retest for
                                           #  re-analysis — both work
                                           #  non-interactively)
  raptor-review digest [run-dir]           # ranked end-of-run summary

Common options:
  --out DIR       Run output directory (default: active project's latest)
  --project DIR   Project directory (default: this session's project — binding, then the last-activated default)
  --target DIR    Source tree root (for stale detection)
  --raw           Output raw JSON instead of formatted text
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.security.log_sanitisation import sanitise_for_terminal as _sft  # noqa: E402
from core.json import load_json, loads  # noqa: E402
from core.security.prompt_output_sanitise import sanitise_string  # noqa: E402

# Byte budgets for run artifacts this CLI renders: context maps /
# gaps / obligations are audit-artifact class; run metadata and the
# journal index are small records.
_MAX_ARTIFACT_BYTES = 64 * 1024 * 1024
_MAX_META_BYTES = 8 * 1024 * 1024


def _line(value, max_chars: int = 200) -> str:
    """Collapse an LLM/journal-derived value to one sanitised line.

    Journal entries (verdict, model, strategies, hypothesis claims),
    annotation bodies, and gap records carry LLM output or scanned-repo
    identifiers. This CLI prints them straight to the operator's
    terminal, so ANSI/BIDI/control bytes and autofetch markup must be
    defanged first — same policy as the markdown report writers.
    """
    text = " ".join(str(value if value is not None else "").split()).strip()
    return sanitise_string(text, max_chars=max_chars)


def _prose(value, max_chars: int = 10_000) -> str:
    """Sanitise a multi-line body (annotation prose) for terminal output."""
    return sanitise_string(str(value if value is not None else ""), max_chars=max_chars)


# ── Layer loaders ────────────────────────────────────────────────────

def _resolve_project_dir(explicit: str | None = None) -> Path | None:
    """Find the active project directory.

    When *explicit* is given (from ``--project``), use it directly.
    Otherwise derive it from the active project's registry JSON.
    """
    if explicit:
        p = Path(explicit)
        if p.is_dir():
            return p
        # Accept a registry NAME like the rest of the operator
        # surface (project doctrine: explicit values are a hard
        # error when invalid, never a silent fallback — pre-fix a
        # bad --project degraded every layer to "no data").
        try:
            from core.json import load_json
            from core.startup import PROJECTS_DIR
            data = load_json(PROJECTS_DIR / f"{explicit}.json")
            if isinstance(data, dict) and data.get("output_dir"):
                candidate = Path(data["output_dir"])
                if candidate.is_dir():
                    return candidate
        except Exception:  # noqa: BLE001 — fall through to the hard error
            pass
        print(f"raptor-review: --project {explicit!r} is neither a "
              "project directory nor a registered project name",
              file=sys.stderr)
        sys.exit(2)
    # The active-project pointer lives at ~/.raptor/projects/.active and
    # is a symlink to the project's <name>.json FILE; the project
    # directory is that JSON's output_dir (the same derivation the run
    # lifecycle's journal merge uses). Pre-fix this looked for a
    # <repo-root>/.active path nothing creates, so without --project
    # every project-level layer (coverage store, journal index)
    # silently read as absent.
    try:
        from core.json import load_json
        from core.startup import PROJECTS_DIR, get_active_name
        name = get_active_name()
        if name:
            data = load_json(PROJECTS_DIR / f"{name}.json")
            if isinstance(data, dict) and data.get("output_dir"):
                candidate = Path(data["output_dir"])
                if candidate.is_dir():
                    return candidate
    except Exception:  # noqa: BLE001 — no active project is a normal state
        pass
    return None


def _project_dir_for(args) -> Path | None:
    """The project dir governing this invocation: explicit ``--project``
    first; else the ``--out`` run's PIN (a run pinned to project P
    reads P's journal index / coverage store / annotations wherever
    the ambient session points — the ambient fallback here was a
    cross-project bleed); ambient only when neither is given.
    """
    explicit = getattr(args, "project", None)
    if explicit:
        return _resolve_project_dir(explicit)
    out = getattr(args, "out", None)
    if out:
        try:
            from core.run.pin import pin_project_dir, resolve_run_pin
            pin = resolve_run_pin(Path(out))
            if pin.authoritative:
                proj = pin_project_dir(Path(out))
                return proj if proj is not None and proj.is_dir() else None
        except Exception:  # noqa: BLE001 — fall to the ambient layer
            pass
    return _resolve_project_dir(None)


# Shared ordering key (core/run/locate.py) — the run's recorded start
# timestamp, mtime fallback, vanished-dir safe. One home with
# raptor-run-status so the two CLIs cannot drift on "latest run".
from core.run.locate import run_started_key as _run_started_key  # noqa: E402


def _resolve_out_dir(args) -> Path | None:
    """Resolve output directory: explicit --out, or latest in project
    (shared newest-first discovery: core/run/locate.py)."""
    if getattr(args, "out", None):
        return Path(args.out)
    project = _project_dir_for(args)
    if not project:
        return None
    from core.run.locate import run_dirs_newest_first
    runs = run_dirs_newest_first(project)
    return runs[0] if runs else None


def _load_context_map(out_dir: Path | None) -> dict | None:
    if not out_dir:
        return None
    cm_path = out_dir / "context-map.json"
    if not cm_path.is_file():
        return None
    return load_json(cm_path, max_bytes=_MAX_ARTIFACT_BYTES)


def _load_journal_entries(out_dir: Path | None):
    if not out_dir:
        return []
    try:
        from core.audit.journal import load_entries
        return load_entries(out_dir)
    except Exception:  # noqa: BLE001 — layer loaders degrade gracefully when absent
        return []


def _load_journal_index(project_dir: Path | None):
    if not project_dir:
        return {}
    try:
        from core.audit.journal import load_index
        return load_index(project_dir)
    except Exception:  # noqa: BLE001 — layer loaders degrade gracefully when absent
        return {}


def _load_coverage_store(project_dir: Path | None):
    if not project_dir:
        return None
    cov_path = project_dir / "coverage.json"
    if not cov_path.is_file():
        return None
    try:
        from core.coverage.store import CoverageStore
        return CoverageStore(cov_path)
    except Exception:  # noqa: BLE001 — layer loaders degrade gracefully when absent
        return None


def _load_annotation(ann_dir: Path | None, file: str, function: str):
    if not ann_dir or not ann_dir.is_dir():
        return None
    try:
        from core.annotations.storage import read_annotation
        return read_annotation(ann_dir, file, function)
    except Exception:  # noqa: BLE001 — layer loaders degrade gracefully when absent
        return None


def _load_suppression_records(
    out_dir: Path | None, file: str, function: str,
) -> list[dict]:
    """Chokepoint records for this function from suppressions.jsonl.

    Covers both dropped findings (binary-oracle, vendored triage) and
    dropped=false survivor records (synthesis-policy refusals) — the
    latter distinguish policy-capped suspicious from ordinary
    suspicious. Tolerant reader: unknown keys ignored, bad lines
    skipped.
    """
    if not out_dir:
        return []
    path = out_dir / "suppressions.jsonl"
    if not path.is_file():
        return []
    records = []
    try:
        # Bounded + regular-file-gated: the file sits inside a run
        # dir whose rw grant sandboxed code holds — attacker bytes.
        # An unbounded read_text() was an OOM lever and a FIFO there
        # a plantable hang.
        import os as _os
        import stat as _stat
        _st = _os.stat(path)
        if not _stat.S_ISREG(_st.st_mode) or _st.st_size > 64 * 1024 * 1024:
            return []
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rec = loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            if rec.get("file_path") == file and rec.get("function") == function:
                records.append(rec)
    except OSError:
        return []
    return records


def _load_readjudication_records(
    out_dir: Path | None, file: str, function: str,
) -> tuple[list[dict], int]:
    """Re-adjudication queue records for this function from
    readjudication-queue.jsonl (core.project.readjudication), plus
    the queue's GLOBAL suppressed count from its truncation marker.

    A record means a recorded disproof at this site was contradicted
    by a later independent signal — queued, never auto-overturned.
    The suppressed count is surfaced even when this function has no
    records: a capped queue may have refused exactly this function's
    contradiction, so silence would be dishonest. Same tolerant-reader
    + hostile-artifact discipline as :func:`_load_suppression_records`
    (the queue lives in the same agent-writable run dir; only
    positive int-typed suppressed fields count).
    """
    if not out_dir:
        return [], 0
    path = out_dir / "readjudication-queue.jsonl"
    if not path.is_file():
        return [], 0
    records = []
    suppressed = 0
    try:
        import os as _os
        import stat as _stat
        _st = _os.stat(path)
        if not _stat.S_ISREG(_st.st_mode) or _st.st_size > 64 * 1024 * 1024:
            return [], 0
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rec = loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            if rec.get("action") == "truncated":
                value = rec.get("suppressed")
                if (isinstance(value, int) and not isinstance(value, bool)
                        and value > 0):
                    suppressed += value
                continue
            if rec.get("action") != "queued":
                continue
            site = rec.get("site")
            site = site if isinstance(site, dict) else {}
            if site.get("file") == file and site.get("function") == function:
                records.append(rec)
    except OSError:
        return [], 0
    return records, suppressed


def _annotations_dir(out_dir: Path | None) -> Path | None:
    """Annotation base for READS — the run pin decides the project
    level (record.py's resolver, shared with the orchestrator and
    validate writers). A bare marker+parent probe here read
    annotations at a DIFFERENT level than the writers for --out and
    standalone runs, so operator notes landed where no view showed
    them."""
    if not out_dir:
        return None
    from core.audit.record import _resolve_annotations_dir
    ann = _resolve_annotations_dir(out_dir)
    return ann if ann.is_dir() else None


def _context_map_role(cm: dict | None, file: str, function: str) -> str | None:
    """Extract the structural role of a function from context-map.json."""
    if not cm:
        return None
    for section, role in [
        ("entry_points", "entry_point"),
        ("sink_details", "sink"),
        ("boundary_details", "trust_boundary"),
    ]:
        for item in cm.get(section) or []:
            if not isinstance(item, dict):
                continue
            item_file = item.get("file", "")
            item_name = item.get("name", item.get("function", ""))
            if item_file == file and item_name == function:
                return role
            if ((item_file.endswith(f"/{file}") or file.endswith(f"/{item_file}"))
                    and item_name == function):
                return role
    return None


# ── Subcommands ──────────────────────────────────────────────────────

def cmd_show(args) -> None:
    """Show unified view for a file or function."""
    out_dir = _resolve_out_dir(args)
    project_dir = _project_dir_for(args)
    cm = _load_context_map(out_dir)
    ann_dir = _annotations_dir(out_dir)

    entries = _load_journal_entries(out_dir)
    # Always fold the project index: a function reviewed only in a
    # PRIOR run has no entry in the current run's journal, and the
    # per-key fallback below never fires if the index is only loaded
    # when the run journal is entirely empty. Per-run entries still
    # win per function — the index is the fallback, matching
    # findings/history/edges.
    index = _load_journal_index(project_dir)

    if args.function:
        _show_function(
            args.file, args.function, cm, entries, index, ann_dir, args,
            out_dir=out_dir,
        )
    else:
        _show_file(args.file, cm, entries, index, ann_dir, args)


def _show_function(file, function, cm, entries, index, ann_dir, args, out_dir=None):
    # Shared injective key (file component percent-encoded) — a raw
    # f-string key misses journal entries for paths containing ':'
    # or '%'.
    from core.coverage.journal import make_function_key
    key = make_function_key(file, function)
    role = _context_map_role(cm, file, function)
    ann = _load_annotation(ann_dir, file, function)
    suppressions = _load_suppression_records(out_dir, file, function)

    journal_entry = None
    for e in reversed(entries):
        if e.key == key:
            journal_entry = e
            break
    if not journal_entry and key in index:
        journal_entry = index[key]

    if getattr(args, "raw", False) and journal_entry:
        # ensure_ascii on every --json lane: JSON escapes C0 but
        # passes C1 terminal controls (single-byte CSI/OSC) raw when
        # off — dumps_display is exactly that, and journal/finding
        # content is LLM-derived. Still valid JSON for consumers.
        print(json.dumps(journal_entry.to_dict(), indent=2,
                         ensure_ascii=True, default=str))
        return

    header = f"─── {_line(file)} :: {_line(function)} "
    print(header + "─" * max(0, 60 - len(header)))
    print()

    if role:
        print(f"  Role:     {_line(role)}")

    if journal_entry:
        conf = f" ({_line(journal_entry.confidence, max_chars=40)})" if journal_entry.confidence else ""
        model = _line(journal_entry.model or "unknown", max_chars=60)
        ts_short = _line(journal_entry.ts[:10] if journal_entry.ts else "", max_chars=20)
        print(f"  Verdict:  {_line(journal_entry.verdict, max_chars=40)}{conf} — {model}, {ts_short}")
        if journal_entry.strategy_id or journal_entry.strategies:
            strats = ", ".join(_line(s, max_chars=60) for s in journal_entry.strategies) if journal_entry.strategies else ""
            sid = _line(journal_entry.strategy_id or "", max_chars=60)
            print(f"  Strategy: {sid} [{strats}]" if sid else f"  Strategy: [{strats}]")
    else:
        print("  Verdict:  (no review recorded)")

    if journal_entry and getattr(journal_entry, "body_offload", None):
        # Slim-tier stub (journal compact --slim-clean): the prose
        # body / hypotheses / snapshot lists live in the run sidecar.
        # Constant text plus the fixed sidecar name — nothing here is
        # row-derived, so no escaping is needed.
        print("  Offloaded: body/hypotheses in "
              "review-journal-bodies.jsonl "
              "(journal compact --slim-clean; --raw shows the "
              "pointer)")

    if journal_entry and journal_entry.hypotheses:
        print()
        print("  Hypotheses:")
        for h in journal_entry.hypotheses:
            status = h.get("status", "?")
            mark = {"confirmed": "+", "disproven": "x", "exploring": "?"}.get(status, "?")
            print(f"    {mark} {_line(status, max_chars=40):<12} {_line(h.get('claim', ''))}")

    if journal_entry and journal_entry.reading_list_items:
        print()
        print("  Unresolved questions:")
        for q in journal_entry.reading_list_items:
            print(f"    - {_line(q)}")

    if suppressions:
        print()
        print("  Chokepoint records:")
        for rec in suppressions:
            verdict = _line(str(rec.get("verdict", "")), max_chars=40)
            dropped = rec.get("dropped", True)
            kind = "dropped" if dropped else "survived (policy-capped)"
            print(f"    {verdict} [{kind}]")
            reason = str(rec.get("reason", ""))
            if reason:
                print(f"      {_line(reason, max_chars=160)}")

    readjudication, readj_suppressed = _load_readjudication_records(
        out_dir, file, function)
    if readjudication:
        print()
        print("  Re-adjudication queued (recorded disproof contradicted "
              "by a later signal — nothing auto-overturned):")
        for rec in readjudication:
            claim = rec.get("new_claim")
            claim = claim if isinstance(claim, dict) else {}
            disproof = rec.get("disproof")
            disproof = disproof if isinstance(disproof, dict) else {}
            mech = ", ".join(str(m) for m in claim.get("mechanism") or [])
            print(f"    new {_line(mech or '?', max_chars=80)} claim from "
                  f"{_line(str(claim.get('source', '?')), max_chars=80)} vs "
                  f"{_line(str(disproof.get('status', 'disproof')), max_chars=40)} from "
                  f"{_line(str(disproof.get('source', '?')), max_chars=80)}")
            reconsider = str(disproof.get("would_reconsider_if", ""))
            if reconsider:
                print(f"      would reconsider if: "
                      f"{_line(reconsider, max_chars=160)}")
            if rec.get("mechanism_match") is False:
                print(f"      {_line(str(rec.get('mechanism_note', 'mechanism mismatch')), max_chars=160)}")
    if readj_suppressed:
        # The queue is capped and the caps are global — a truncated
        # queue may have refused THIS function's contradiction, so the
        # marker surfaces here even with no per-function records.
        print()
        print(f"  Re-adjudication queue truncated: {readj_suppressed} "
              f"further contradiction(s) not recorded (record caps) — "
              f"this function may have unrecorded contradictions.")

    if ann:
        print()
        print("  Operator note:")
        body = getattr(ann, "body", "")
        if body:
            for line in _prose(body.strip()).splitlines():
                print(f"    {line}")
    print()


def _show_file(file, cm, entries, index, ann_dir, args):
    all_entries = {}
    for e in entries:
        if e.file == file:
            existing = all_entries.get(e.function)
            if not existing or e.ts > existing.ts:
                all_entries[e.function] = e
    for e in index.values():
        if e.file == file and e.function not in all_entries:
            all_entries[e.function] = e

    count = len(all_entries)
    header = f"─── {_line(file)} ({count} reviewed functions) "
    print(header + "─" * max(0, 60 - len(header)))
    print()

    roles = {"entry_point": 0, "sink": 0, "trust_boundary": 0}
    if cm:
        for section, role in [("entry_points", "entry_point"), ("sink_details", "sink"), ("boundary_details", "trust_boundary")]:
            for item in cm.get(section) or []:
                if isinstance(item, dict):
                    f = item.get("file", "")
                    if f == file or f.endswith(f"/{file}") or file.endswith(f"/{f}"):
                        roles[role] += 1
        role_parts = [f"{v} {k.replace('_', ' ')}s" for k, v in roles.items() if v]
        if role_parts:
            print(f"  Roles:    {', '.join(role_parts)}")

    findings = [e for e in all_entries.values() if e.verdict == "finding"]
    if findings:
        print(f"  Findings: {len(findings)}")
    else:
        print("  Findings: 0")

    if all_entries:
        print()
        print("  Reviews:")
        for fn in sorted(all_entries):
            e = all_entries[fn]
            conf = f" ({_line(e.confidence, max_chars=40)})" if e.confidence else ""
            model = _line((e.model or "")[:12], max_chars=20)
            print(f"    {_line(fn, max_chars=80):<30} {_line(e.verdict, max_chars=40)}{conf}  {model}")
    print()


def cmd_findings(args):
    """List all findings across runs."""
    out_dir = _resolve_out_dir(args)
    project_dir = _project_dir_for(args)

    entries = _load_journal_entries(out_dir)
    index = _load_journal_index(project_dir)

    all_findings = {}
    for e in entries:
        if e.verdict in ("finding", "suspicious"):
            existing = all_findings.get(e.key)
            if not existing or e.ts > existing.ts:
                all_findings[e.key] = e
    for key, e in index.items():
        if e.verdict in ("finding", "suspicious") and key not in all_findings:
            all_findings[key] = e

    if getattr(args, "raw", False):
        print(json.dumps([e.to_dict() for e in all_findings.values()],
                 indent=2, ensure_ascii=True, default=str))
        return

    if not all_findings:
        print("  No findings.")
        return

    print(f"  {len(all_findings)} finding(s)")
    print()
    for key in sorted(all_findings):
        e = all_findings[key]
        cwe = _line(e.cwe or "", max_chars=20)
        model = _line((e.model or "")[:12], max_chars=20)
        ts_short = _line(e.ts[:10] if e.ts else "", max_chars=20)
        print(f"  {_line(e.file)}:{_line(e.function, max_chars=80):<20} {cwe:<10} {_line(e.verdict, max_chars=40):<10} {model}  {ts_short}")


def cmd_gaps(args) -> None:
    """Show what needs review and why."""
    out_dir = _resolve_out_dir(args)
    if not out_dir:
        print("  No output directory found. Run an audit first.", file=sys.stderr)
        sys.exit(1)

    gaps_path = out_dir / "gaps.json"
    if not gaps_path.is_file():
        print("  No gaps.json found in output directory.", file=sys.stderr)
        sys.exit(1)

    data = load_json(gaps_path, max_bytes=_MAX_ARTIFACT_BYTES)
    # Run artifacts are attacker bytes (sandboxed code holds the run
    # dir's write grant) — a non-object top level or a non-list
    # "gaps" must take the read-failure path, not a traceback.
    if not isinstance(data, dict):
        print("  Failed to read gaps.json.", file=sys.stderr)
        sys.exit(1)

    gaps = data.get("gaps", [])
    if not isinstance(gaps, list):
        gaps = []
    gaps = [g for g in gaps if isinstance(g, dict)]
    edge_lines = _edge_gap_lines(out_dir)
    if not gaps and not edge_lines:
        print("  No gaps — all functions reviewed.")
        return

    if getattr(args, "raw", False):
        print(json.dumps(gaps, indent=2, ensure_ascii=True, default=str))
        return

    print(f"  {len(gaps)} function(s) need review")
    print()
    print(f"  {'Priority':<10} {'File':<30} {'Function':<25} {'Strategies'}")
    print(f"  {'─' * 9:<10} {'─' * 29:<30} {'─' * 24:<25} {'─' * 20}")
    for g in gaps[:50]:
        strats = ", ".join(_line(s, max_chars=40) for s in g.get("strategies", [])[:3])
        pri = _line(g.get('priority', 0), max_chars=20)
        fn = _line(g.get('file', ''))
        nm = _line(g.get('name', ''), max_chars=80)
        print(f"  {pri:<10} {fn:<30} {nm:<25} {strats}")
    for line in edge_lines:
        print(line)


def _edge_gap_lines(out_dir: Path) -> list:
    """Edge-obligation gap state for --edges runs (absent file → no
    section). Tier-1 gaps rank ABOVE function gaps in urgency; they
    render as their own block. Tier-2 shows the folded-pending count."""
    raw = load_json(
        out_dir / "edge-obligations.json", max_bytes=_MAX_ARTIFACT_BYTES,
    )
    if not isinstance(raw, dict):
        return []
    # Tier lists are run-dir bytes too: keep only dict records so a
    # planted scalar can't detonate the key lookups below.
    t1 = raw.get("tier1")
    t2 = raw.get("tier2")
    tier1 = [r for r in t1 if isinstance(r, dict)] if isinstance(t1, list) else []
    tier2 = [r for r in t2 if isinstance(r, dict)] if isinstance(t2, list) else []
    reviewed = set()
    verdicted_folds = set()
    try:
        from core.audit.edge_review import edge_key  # noqa: PLC0415
        from core.coverage.journal import load_entries
        for e in load_entries(out_dir):
            if getattr(e, "edge_callee", None) and e.verdict != "error":
                reviewed.add(e.key)
            for ev in getattr(e, "edge_verdicts", None) or []:
                if isinstance(ev, dict) and ev.get("callee"):
                    verdicted_folds.add(
                        (e.file, e.function, str(ev["callee"])))
        # Inside the try: a record missing its caller/callee keys
        # raises in edge_key — degrade the section like every other
        # layer instead of an unhandled traceback.
        unreviewed = [r for r in tier1 if edge_key(r) not in reviewed]
        pending2 = [
            r for r in tier2
            if (r.get("caller_file"), r.get("caller"),
                str(r.get("callee"))) not in verdicted_folds
        ]
    except Exception:  # noqa: BLE001 — layers degrade gracefully
        return []
    if not unreviewed and not pending2:
        return []
    lines = ["", f"  Edge obligations ({len(unreviewed)} tier-1 "
                 f"unreviewed, {len(pending2)} tier-2 pending)"]
    for r in unreviewed[:15]:
        loc = _line(
            f"{r.get('caller_file')}:{r.get('caller')} -> "
            f"{r.get('callee_file')}:{r.get('callee')}", max_chars=100)
        why = _line(str(r.get("reason", "")), max_chars=40)
        lines.append(f"    edge      {loc}  {why}")
    if len(unreviewed) > 15:
        lines.append(f"    (+{len(unreviewed) - 15} more tier-1 — see "
                     "edge-obligations.json)")
    if pending2:
        lines.append(
            f"    {len(pending2)} tier-2 edge contract(s) pending "
            "(folded into caller reviews)")
    return lines


def cmd_history(args):
    """Show all reviews of a function over time."""
    out_dir = _resolve_out_dir(args)
    project_dir = _project_dir_for(args)
    from core.coverage.journal import make_function_key
    key = make_function_key(args.file, args.function)

    entries = [e for e in _load_journal_entries(out_dir) if e.key == key]

    idx = _load_journal_index(project_dir)
    if key in idx and not any(e.ts == idx[key].ts for e in entries):
        entries.append(idx[key])

    entries.sort(key=lambda e: e.ts)

    if not entries:
        print(f"  No reviews recorded for {key}")
        return

    if getattr(args, "raw", False):
        print(json.dumps([e.to_dict() for e in entries],
                 indent=2, ensure_ascii=True, default=str))
        return

    for e in entries:
        ts_short = _line(e.ts[:16].replace("T", " ") if e.ts else "?", max_chars=20)
        conf = f" ({_line(e.confidence, max_chars=40)})" if e.confidence else ""
        model = _line((e.model or "?")[:12], max_chars=20)
        strats = ", ".join(_line(s, max_chars=60) for s in e.strategies[:3]) if e.strategies else ""
        print(f"  {ts_short}  {_line(e.verdict, max_chars=40)}{conf:<8} {model:<14} {strats}")


def cmd_stats(args):
    """Show entry counts, costs, coverage percentages."""
    out_dir = _resolve_out_dir(args)
    entries = _load_journal_entries(out_dir)

    if not entries:
        print("  No journal entries found.")
        return

    # Post-loop mechanical echo rows (one $0 row per pattern-scan
    # finding, journalled for cross-layer visibility) are not LLM
    # reviews — counted separately so verdict tallies aren't inflated.
    from core.coverage.journal import is_mechanical_echo

    echo_rows = sum(1 for e in entries if is_mechanical_echo(e))
    verdicts: dict[str, int] = {}
    total_cost = 0.0
    total_duration = 0.0
    models: set[str] = set()
    for e in entries:
        if is_mechanical_echo(e):
            continue
        verdicts[e.verdict] = verdicts.get(e.verdict, 0) + 1
        total_cost += e.cost_usd or 0.0
        total_duration += e.duration_s or 0.0
        if e.model:
            models.add(e.model)

    print(f"  Entries:  {len(entries)}")
    if echo_rows:
        print(
            f"  Mechanical echo rows: {echo_rows} "
            "(post-loop pattern scans — excluded from verdicts)"
        )
    print(f"  Models:   {', '.join(_line(m, max_chars=60) for m in sorted(models)) or '(none)'}")
    print(f"  Cost:     ${total_cost:.2f}")
    print(f"  Duration: {total_duration:.0f}s ({total_duration / 60:.1f}m)")
    print()
    print("  Verdicts:")
    for v in sorted(verdicts):
        print(f"    {_line(v, max_chars=40):<15} {verdicts[v]}")


def cmd_notes(args):
    """List all operator annotations."""
    out_dir = _resolve_out_dir(args)
    ann_dir = _annotations_dir(out_dir)
    if not ann_dir or not ann_dir.is_dir():
        print("  No annotations directory found.")
        return

    try:
        from core.annotations.storage import iter_all_annotations
    except ImportError:
        print("  Annotation storage not available.", file=sys.stderr)
        return

    count = 0
    for ann in iter_all_annotations(ann_dir):
        if ann.metadata.get("source") != "human":
            continue
        status = _line(ann.metadata.get("status", ""), max_chars=40)
        body_preview = _line((ann.body or "")[:60], max_chars=80)
        print(f"  {_line(ann.file)}:{_line(ann.function, max_chars=80):<25} {status:<12} {body_preview}")
        count += 1

    if count == 0:
        print("  No operator notes found.")


def _write_base(args) -> str | None:
    """Annotation base for WRITES, derived from the resolved out dir
    (and through it the run's project pin) exactly like the read side
    (_annotations_dir) — never from the ambient active project. The
    delegate's own default is the ACTIVE project's annotations dir,
    so without an explicit --base a note filed against project B's
    run landed under project A: B's audit never consumed it and
    `show` never displayed it."""
    out_dir = _resolve_out_dir(args)
    if out_dir is None:
        return None
    from core.audit.record import _resolve_annotations_dir
    return str(_resolve_annotations_dir(out_dir))


def cmd_note(args):
    """Add an operator note (delegates to raptor-annotate)."""
    import subprocess
    libexec = Path(__file__).resolve().parent
    cmd = [
        sys.executable, str(libexec / "raptor-annotate"),
        "add", args.file, args.function,
    ]
    if args.body:
        cmd.extend(["-m", args.body])
    if getattr(args, "status", None):
        cmd.extend(["--status", args.status])
    base = getattr(args, "base", None) or _write_base(args)
    if base:
        cmd.extend(["--base", base])
    env = os.environ.copy()
    env["_RAPTOR_TRUSTED"] = "1"
    # No --source: the delegate stamps the inherited fds' TTY context
    # and derives the default from it, so an interactive /review note
    # lands as human and an agent-driven one as agent.
    sys.exit(subprocess.call(cmd, env=env))


def cmd_edit(args):
    """Edit an operator note (delegates to raptor-annotate)."""
    import subprocess
    libexec = Path(__file__).resolve().parent
    cmd = [
        sys.executable, str(libexec / "raptor-annotate"),
        "edit", args.file, args.function,
    ]
    base = getattr(args, "base", None) or _write_base(args)
    if base:
        cmd.extend(["--base", base])
    env = os.environ.copy()
    env["_RAPTOR_TRUSTED"] = "1"
    sys.exit(subprocess.call(cmd, env=env))


def cmd_stale(args):
    """List stale reviews.

    ``--source`` selects which store to check:
      * ``annotation`` (default) — human operator notes (delegates
        to ``raptor-annotate stale``).
      * ``journal`` — LLM review entries in the project-level
        journal index. Recomputes each entry's source hash and
        lists entries where the current source differs from the
        recorded hash (source drift since the review).
      * ``both`` — run both.
    """
    source = getattr(args, "source", None) or "annotation"

    if source in ("annotation", "both"):
        import subprocess
        libexec = Path(__file__).resolve().parent
        cmd = [sys.executable, str(libexec / "raptor-annotate"), "stale"]
        if getattr(args, "target", None):
            cmd.extend(["--target", args.target])
        env = os.environ.copy()
        env["_RAPTOR_TRUSTED"] = "1"
        rc = subprocess.call(cmd, env=env)
        if source == "annotation":
            sys.exit(rc)

    if source in ("journal", "both"):
        _stale_journal(args)


def _stale_source_root(
    args: argparse.Namespace, project_dir: Path,
) -> Path | None:
    """Resolve the SOURCE tree root that journal hashes anchor to.

    Journal entries record ``file`` relative to the scanned source
    tree, so staleness must re-hash against that tree. The project
    dir itself is the OUTPUT dir — hashing there finds no source
    files, every recomputed hash comes back None, and drifted
    reviews silently read as fresh. Resolution: explicit
    ``--target`` first, then the registry ``target`` of the project
    whose ``output_dir`` this is, then the newest run's recorded
    ``target_path``.
    """
    target = getattr(args, "target", None)
    if target:
        return Path(target)
    try:
        from core.startup import PROJECTS_DIR
        resolved = project_dir.resolve()
        for reg in sorted(PROJECTS_DIR.glob("*.json")):
            data = load_json(reg, max_bytes=_MAX_META_BYTES)
            if not isinstance(data, dict):
                continue
            out = data.get("output_dir")
            tgt = data.get("target")
            if out and tgt and Path(out).resolve() == resolved:
                p = Path(tgt)
                if p.is_dir():
                    return p
    except OSError:
        pass
    try:
        runs = sorted(
            [d for d in project_dir.iterdir()
             if d.is_dir() and (d / ".raptor-run.json").is_file()],
            key=lambda d: d.stat().st_mtime,
            reverse=True,
        )
        for run in runs:
            meta = load_json(run / ".raptor-run.json",
                             max_bytes=_MAX_META_BYTES)
            if isinstance(meta, dict) and meta.get("target_path"):
                p = Path(str(meta["target_path"]))
                if p.is_dir():
                    return p
    except OSError:
        pass
    return None


def _stale_journal(args) -> None:
    """List journal entries whose source hash no longer matches the
    file on disk.

    Amendment §6 (Phase 3.5): symmetric to ``/annotate stale``.
    Operators previously had no way to find stale LLM reviews —
    this closes that gap.
    """
    project_dir = _project_dir_for(args)
    if not project_dir:
        print("  No active project.", file=sys.stderr)
        sys.exit(1)

    from core.audit.journal import load_index
    from core.audit.record import _compute_hash

    target_path = _stale_source_root(args, project_dir)
    if target_path is None:
        # Refuse loudly rather than hash against a wrong root: a
        # silent "0 stale" against the output dir hides every
        # drifted review.
        print(
            "  Cannot resolve the source tree for staleness hashing "
            "(no registry target for this project). Pass --target "
            "<repo-root>.",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        entries = load_index(project_dir)
    except Exception as exc:  # noqa: BLE001
        print(f"  Corrupt journal index: {_sft(str(exc), max_len=300)}", file=sys.stderr)
        sys.exit(1)

    stale = []
    for entry in entries.values():
        if not entry.source_hash:
            continue
        current = _compute_hash(
            target_path, entry.file, entry.line_start,
            entry.line_end,
        )
        if current and current != entry.source_hash:
            stale.append((entry, current))

    if not stale:
        print(f"  {len(entries)} journal entries, 0 stale.")
        return

    print(f"  {len(entries)} journal entries, {len(stale)} stale:")
    for entry, current in sorted(stale, key=lambda e: (e[0].file, e[0].function)):
        print(
            f"    {_line(entry.file)}:{_line(entry.function, max_chars=80)}  "
            f"verdict={_line(entry.verdict, max_chars=40)}  "
            f"was={entry.source_hash[:12]}...  "
            f"now={current[:12]}..."
        )


def cmd_edges(args):
    """Edge obligations: tier-1 review state, tier-2 pending, blind spots."""
    out_dir = _resolve_out_dir(args)
    if not out_dir:
        print("No run directory found (pass --out or activate a project).")
        return
    ob_path = out_dir / "edge-obligations.json"
    if not ob_path.is_file():
        print("No edge-obligations.json in this run (run /audit --edges).")
        return
    ob = load_json(ob_path, max_bytes=_MAX_ARTIFACT_BYTES)
    if ob is None:
        print("edge-obligations.json unreadable.")
        return
    if getattr(args, "raw", False):
        print(json.dumps(ob, indent=2, ensure_ascii=True, default=str))
        return

    reviewed = {}
    edge_key = None
    try:
        from core.audit.edge_review import edge_key
        from core.coverage.journal import load_entries, load_index
        entries = list(load_entries(out_dir))
        # Cross-run edge reuse journals verdicts in PRIOR runs — fold
        # the project index too, per-run entries winning on conflict,
        # or a reused run reads as entirely "unreviewed" here while
        # the report says otherwise.
        project_dir = _project_dir_for(args)
        if project_dir is not None:
            index_entries = list(load_index(project_dir).values())
        else:
            index_entries = []
        for e in index_entries + entries:
            if getattr(e, "edge_callee", None) and e.verdict != "error":
                reviewed[e.key] = e.verdict
    except Exception:  # noqa: BLE001 — journal layer degrades gracefully
        pass

    tier1 = ob.get("tier1") or []
    tier2 = ob.get("tier2") or []
    blind = ob.get("blind_spots") or []
    stats = ob.get("stats") or {}
    print(f"─── Edge obligations ({_line(out_dir.name, 60)}) ───")
    print(f"\n  Tier-1 (dedicated units): {len(tier1)}")
    for rec in tier1:
        try:
            verdict = (reviewed.get(edge_key(rec), "unreviewed")
                       if edge_key else "?")
        except Exception:  # noqa: BLE001
            verdict = "?"
        loc = _line(f"{rec.get('caller_file')}:{rec.get('caller')} -> "
                    f"{rec.get('callee')}", 90)
        print(f"    {loc:90}  {_line(str(verdict), 12)}  "
              f"[{_line(str(rec.get('reason', '')), 40)}]")
    print(f"\n  Tier-2 (folded into caller reviews): {len(tier2)} — "
          "cleared by each caller's function review")
    print(f"\n  Blind spots: {len(blind)} call site(s) the static graph "
          "cannot follow (first 10):")
    for b in blind[:10]:
        print(f"    {_line(str(b.get('file')), 40)}:"
              f"{_line(str(b.get('caller') or '-'), 30)}  "
              f"{_line(str(b.get('kind')), 20)}  "
              f"{_line(str(b.get('name')), 40)}")
    degraded = stats.get("degraded") or []
    if degraded:
        print(f"\n  Degraded: {', '.join(_line(d, 40) for d in degraded)}")
    if stats.get("dispatch_resolved"):
        print(f"  Dispatch sites resolved to tier-1: "
              f"{stats['dispatch_resolved']}")


def _resolve_diff_runs(args, project_dir):
    """Resolve the two run dirs to diff: explicit names/paths, else the
    two most recent runs in the project (older first)."""
    named = list(getattr(args, "runs", None) or [])
    resolved = []
    for name in named[:2]:
        p = Path(name)
        if p.is_dir():
            resolved.append(p)
        elif project_dir and (project_dir / name).is_dir():
            resolved.append(project_dir / name)
        else:
            print(f"Run not found: {name}", file=sys.stderr)
            return None, None
    if len(resolved) == 2:
        return resolved[0], resolved[1]
    if not project_dir:
        return None, None
    runs = sorted(
        [d for d in project_dir.iterdir()
         if d.is_dir() and (d / ".raptor-run.json").is_file()
         and (d / "review-journal.jsonl").is_file()],
        key=_run_started_key,
    )
    if len(resolved) == 1:
        others = [r for r in runs if r != resolved[0]]
        return (others[-1], resolved[0]) if others else (None, None)
    if len(runs) < 2:
        return None, None
    return runs[-2], runs[-1]


def cmd_diff(args):
    """Verdict changes between two runs' journals."""
    project_dir = _project_dir_for(args)
    run_a, run_b = _resolve_diff_runs(args, project_dir)
    if run_a is None or run_b is None:
        print("Need two runs with journals to diff (pass two run "
              "dir names/paths, or have >=2 journalled runs in the "
              "active project).")
        return
    try:
        from core.audit.journal import latest_entries
        a = latest_entries(run_a)
        b = latest_entries(run_b)
    except Exception:  # noqa: BLE001 — degrade like the other layer loaders
        a, b = {}, {}
    changed = []
    new_reviews = []
    for key, entry in sorted(b.items()):
        prior = a.get(key)
        if prior is None:
            new_reviews.append(entry)
        elif prior.verdict != entry.verdict:
            changed.append((prior, entry))
    if getattr(args, "raw", False):
        print(json.dumps({
            "run_a": run_a.name, "run_b": run_b.name,
            "changed": [
                {"file": e.file, "function": e.function,
                 "from": p_.verdict, "to": e.verdict, "model": e.model}
                for p_, e in changed
            ],
            "new": [
                {"file": e.file, "function": e.function,
                 "verdict": e.verdict, "model": e.model}
                for e in new_reviews
            ],
        }, indent=2, ensure_ascii=True, default=str))
        return
    print(f"─── {_line(run_a.name, 60)} → "
          f"{_line(run_b.name, 60)} ───")
    print("\n  Changed verdicts:")
    if not changed:
        print("    (none)")
    for prior, entry in changed:
        loc = _line(f"{entry.file}:{entry.function}", 60)
        print(f"    {loc:60}  {_line(prior.verdict, 12)} → "
              f"{_line(entry.verdict, 12)}")
    print("\n  New reviews:")
    if not new_reviews:
        print("    (none)")
    for entry in new_reviews:
        loc = _line(f"{entry.file}:{entry.function}", 60)
        print(f"    {loc:60}  {_line(entry.verdict, 12)}  "
              f"{_line(entry.model or '', 24)}")


def cmd_live(args) -> None:
    """Tail-follow a running audit's journal; exits when the run
    reaches a terminal status."""
    import time
    out_dir = _resolve_out_dir(args)
    if not out_dir:
        print("No run directory found (pass --out or activate a project).")
        return
    journal = out_dir / "review-journal.jsonl"
    meta = out_dir / ".raptor-run.json"

    def _status() -> str:
        data = load_json(meta, max_bytes=_MAX_META_BYTES)
        if isinstance(data, dict):
            return data.get("status", "unknown")
        return "unknown"

    print(f"{_line(out_dir.name, 80)} — {_line(_status(), 20)}")
    pos = 0
    try:
        while True:
            if journal.is_file():
                with open(journal, encoding="utf-8") as fh:
                    fh.seek(pos)
                    # Bounded per poll: the journal sits in a run dir
                    # whose write grant sandboxed code holds — an
                    # unbounded read() was an OOM lever (same budget
                    # as the other run-artifact readers here). A
                    # legitimately large journal simply drains across
                    # successive polls.
                    chunk = fh.read(_MAX_ARTIFACT_BYTES)
                # Only consume complete lines — a writer may be
                # mid-append; the partial tail is re-read next poll.
                if chunk and not chunk.endswith("\n"):
                    cut = chunk.rfind("\n") + 1
                    if cut == 0 and len(chunk) >= _MAX_ARTIFACT_BYTES:
                        # A single line larger than the whole budget
                        # can never complete — advance past what was
                        # read so the tail never stalls on it (the
                        # remainder parses as a skipped bad line).
                        pos += len(chunk.encode("utf-8"))
                        chunk = ""
                    else:
                        chunk = chunk[:cut]
                pos += len(chunk.encode("utf-8"))
                for line in chunk.splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        e = loads(line)
                    except ValueError:
                        continue
                    loc = _line(
                        f"{e.get('file', '')}:{e.get('function', '')}", 60)
                    cost = e.get("cost_usd")
                    cost_s = f"${cost:.2f}" if isinstance(
                        cost, (int, float)) else ""
                    print(f"  {_line(e.get('ts', ''), 27):27}  {loc:60}  "
                          f"{_line(e.get('verdict', ''), 12):12}  {cost_s}")
            status = _status()
            if status != "running":
                print(f"  run {_line(status, 20)}.")
                return
            time.sleep(2.0)
    except KeyboardInterrupt:
        return


def cmd_coverage(args):
    """Show mechanical tool coverage for a project run."""
    project_dir = _project_dir_for(args)
    store = _load_coverage_store(project_dir)
    if store is None:
        print("  No coverage data found.")
        return

    file_filter = getattr(args, "file", None)
    all_files = store.files()
    if file_filter:
        all_files = [f for f in all_files if file_filter in f]
        if not all_files:
            print(f"  No coverage records matching '{file_filter}'.")
            return

    for path in all_files:
        cov = store.file_coverage(path)
        print(f"  {_line(path)}: {cov:.0f}%")

    print(f"\n  {len(all_files)} file(s) with coverage data.")


def cmd_compact(args) -> None:
    """Compact the project journal index.

    Re-homes rows whose on-disk key predates the current
    ``index_key`` format (span suffix, producer segment). Row CONTENT
    is untouched — fields are the source of truth, keys are opaque
    handles — so the move is lossless; latest-ts wins when the new
    home is already occupied, which merges stale legacy duplicates
    away. A latest-per-function collapse would be destructive here:
    the index deliberately keeps multi-model / multi-strategy
    history, so eviction is never part of compaction. Unreadable
    rows stay in place — compaction must never drop history it
    cannot parse.
    """
    project_dir = _project_dir_for(args)
    if not project_dir:
        print("  No active project.", file=sys.stderr)
        sys.exit(1)

    from core.audit.journal import INDEX_FILENAME
    index_path = project_dir / INDEX_FILENAME
    if not index_path.is_file():
        print("  No journal index to compact.")
        return

    from core.coverage.journal import (
        IndexUnreadable,
        IndexWriteOverBudget,
        _flock,
        _load_index,
        _write_index,
        rehome_legacy_keys,
    )

    # Same lock every index writer takes (merge_into_index) — a
    # compaction racing a run-completion merge must not clobber it.
    # Load INSIDE the lock so the rewrite is based on current bytes.
    # The load + rewrite go through the journal module's own writer
    # gates (_load_index(for_write=True) / _write_index) rather than a
    # re-implemented copy — compaction is a WRITER, so it inherits the
    # full refusal discipline (unreadable file, non-object container,
    # non-serializable preserved rows) instead of drifting behind it.
    with _flock(index_path):
        try:
            entries = _load_index(index_path, for_write=True)
        except IndexUnreadable as e:
            print(f"  Corrupt index — not compacting: {e}",
                  file=sys.stderr)
            sys.exit(1)

        before = len(entries)
        # The journal module's own walk — compaction and the
        # run-completion merge must re-home (and quarantine) rows
        # identically, so there is exactly one implementation.
        rehomed = rehome_legacy_keys(entries)

        if rehomed:
            try:
                _write_index(index_path, entries)
            except IndexWriteOverBudget as e:
                # The write gate refuses rather than freeze the index
                # (an over-budget file degrades every reader to empty
                # and every writer to refusal); the on-disk index is
                # untouched.
                print(f"  Index rewrite refused — not compacting: {e}",
                      file=sys.stderr)
                sys.exit(1)
            print(f"  Compacted: {before} -> {len(entries)} entries "
                  f"({rehomed} legacy key(s) re-homed).")
        else:
            print(f"  Index already compact ({before} entries).")


def cmd_digest(args) -> None:
    """Ranked end-of-run summary for one run (shared digest reader)."""
    run_dir = Path(args.run_dir) if getattr(args, "run_dir", None) \
        else _resolve_out_dir(args)
    if not run_dir:
        print("  No run found — pass a run dir or activate a project.",
              file=sys.stderr)
        sys.exit(1)
    if not (Path(run_dir) / ".raptor-run.json").is_file():
        print(f"  {_line(str(run_dir), max_chars=200)} is not a run "
              "directory (no .raptor-run.json).", file=sys.stderr)
        sys.exit(2)
    from core.run.digest import read_run_digest, render_run_digest
    digest = read_run_digest(Path(run_dir))
    if getattr(args, "raw", False):
        print(json.dumps(digest.to_dict(), indent=2, ensure_ascii=True,
                         default=str))
        return
    # Renderer output is escaped at render (core/run/digest.py).
    print(render_run_digest(digest))


def _verdict_run_dirs(args) -> list:
    """Run dirs the verdict verb resolves finding ids against:
    the explicit ``--out`` run, else every run in the governing
    project, newest first (same enumeration as the latest-run
    resolver)."""
    out = getattr(args, "out", None)
    if out:
        return [Path(out)]
    project = _project_dir_for(args)
    if not project:
        return []
    from core.run.locate import run_dirs_newest_first
    return run_dirs_newest_first(project)


def _project_registry_target(args, run_dir) -> Path | None:
    """The governing project's registered target tree, when the run
    actually BELONGS to that project (run dir inside its output dir —
    an ambient active project must not veto an unrelated --out run).
    Best-effort — None means no cross-check possible."""
    project_dir = _project_dir_for(args)
    if not project_dir:
        return None
    try:
        if not Path(run_dir).resolve().is_relative_to(
                Path(project_dir).resolve()):
            return None
    except (OSError, ValueError):
        return None
    try:
        from core.startup import PROJECTS_DIR
        for reg in Path(PROJECTS_DIR).glob("*.json"):
            data = load_json(reg, max_bytes=_MAX_META_BYTES)
            if not isinstance(data, dict):
                continue
            out = data.get("output_dir")
            if not (isinstance(out, str) and out):
                continue
            if Path(out).resolve() != Path(project_dir).resolve():
                continue
            target = data.get("target")
            if isinstance(target, str) and target \
                    and Path(target).is_dir():
                return Path(target)
            return None
    except Exception:  # noqa: BLE001 — registry problems mean "no cross-check"
        pass
    return None


def _verdict_repo_root(args, ref) -> Path | None:
    """Source tree the verdict's source hash is computed against:
    explicit ``--target`` first, else the ``target_path`` sealed in
    the finding's run manifest — corroborated against the governing
    project's registered target when one is known (the manifest sits
    in the child-writable run dir; a swapped target_path must not
    silently steer which tree gets hashed)."""
    explicit = getattr(args, "target", None)
    if explicit:
        p = Path(explicit)
        if not p.is_dir():
            print(f"raptor-review: --target {_line(explicit)} is not a "
                  "directory", file=sys.stderr)
            sys.exit(2)
        return p
    try:
        from core.run import load_run_metadata
        meta = load_run_metadata(ref.run_dir) or {}
        tp = meta.get("target_path")
        if isinstance(tp, str) and tp and Path(tp).is_dir():
            resolved = Path(tp)
            project_target = _project_registry_target(args, ref.run_dir)
            if project_target is not None and \
                    project_target.resolve() != resolved.resolve():
                print("  ⚠️  the run manifest's target_path "
                      f"({_line(tp, max_chars=200)}) disagrees with "
                      "the project's registered target — pass "
                      "--target <repo> to name the tree explicitly.",
                      file=sys.stderr)
                return None
            return resolved
    except Exception:  # noqa: BLE001 — manifest problems fall to "unknown"
        pass
    return None


def _operator_provenance(args) -> tuple:
    """``(source, note, warning, operator)`` for the verdict row.

    Same doctrine as /annotate: ``source`` defaults to ``human`` when
    the invocation is interactive-TTY, else ``agent``; an explicit
    ``--source human`` from a non-TTY invocation is demoted to
    ``agent`` with a warning (the non-tty stamp would contradict it —
    readers demote such records anyway). The note records the full
    invocation-context stamp for the auditor.

    ``operator`` feeds the fp verb's gate and is the full live-context
    operator-grant discipline
    (``core.annotations.provenance.live_context_grants_operator`` —
    the same chokepoint the coverage --mark path stamps with), NOT the
    bare TTY stamp: a pty makes ``isatty`` true by design, and an
    in-session agent invocation is interactive-TTY on the launcher's
    terminal while carrying the dispatch environment marker — the
    exact shapes the grant demotes. Both facts come from ONE detected
    context so the gate can never disagree with the audited stamp.
    """
    from core.annotations.provenance import (
        ENV_MARKERS_KEY,
        INTERACTIVE_TTY,
        PARENTS_KEY,
        PROVENANCE_KEY,
        SID_KEY,
        TTY_KEY,
        detect_invocation_context,
        live_context_grants_operator,
    )
    ctx = detect_invocation_context()
    interactive = ctx[PROVENANCE_KEY] == INTERACTIVE_TTY
    operator = live_context_grants_operator(ctx)
    requested = getattr(args, "source", None)
    warning = None
    if requested == "human" and not interactive:
        source = "agent"
        warning = ("--source human requested from a non-TTY invocation — "
                   "recording source=agent (a non-tty stamp contradicts "
                   "the human claim; readers demote such records)")
    elif requested:
        source = requested
    else:
        source = "human" if interactive else "agent"
    note = (f"operator-verdict source={source} "
            f"tty={ctx[TTY_KEY]} provenance={ctx[PROVENANCE_KEY]} "
            f"sid={ctx[SID_KEY]} envm={ctx[ENV_MARKERS_KEY]} "
            f"parents={ctx[PARENTS_KEY]}")
    return source, note, warning, operator


def _record_operator_verdict(run_dir, finding, verdict, reason, source):
    """Disk-side audit record for the verb, via the suppressions
    single-writer (dropped=false — an operator verdict never drops a
    finding from THIS run; it steers future ones). Best-effort like
    every other producer."""
    from core.analysis.reach_chokepoint import record_suppression
    record_suppression(
        run_dir,
        finding=finding,
        verdict=f"operator_{verdict}",
        reason=reason or "operator verdict (no reason given)",
        dropped=False,
        extra={"source": source},
    )


def _report_failed_edits(failed_paths) -> bool:
    """Surface findings files a manual_override edit could NOT
    rewrite. Returns True when any failed — callers exit nonzero: an
    edit that silently did not happen reads as success."""
    if not failed_paths:
        return False
    print(f"  ⚠️  could not rewrite {len(failed_paths)} findings "
          "file(s) (unreadable, over the byte budget, or write "
          "failure):", file=sys.stderr)
    for p in failed_paths:
        print(f"        {_line(str(p), max_chars=200)}", file=sys.stderr)
    return True


def _forget_or_report(forget_fn, *args, **kwargs) -> int:
    """Run a verdict-row clear, failing CLOSED on every partial
    outcome: a truncated store walk, an enumeration failure, or a
    server that refused some deprecations must never report
    'cleared' while a suppressing row survives. Exits 1 before any
    disk edit; returns the cleared count on full success."""
    from core.sage.hooks import VerdictWalkTruncated
    try:
        result = forget_fn(*args, **kwargs)
    except VerdictWalkTruncated as e:
        print(f"  Could not enumerate the SAGE verdict store "
              f"({_line(str(e), max_chars=200)}) — nothing was "
              "cleared or changed. Re-run when the store is "
              "reachable end to end.", file=sys.stderr)
        sys.exit(1)
    if result is None:
        # Reachable client, failed enumeration (non-truncation) —
        # never fall through as if the store held nothing.
        print("  Could not enumerate the SAGE verdict store (listing "
              "failed — see debug logs) — nothing was cleared or "
              "changed.", file=sys.stderr)
        sys.exit(1)
    cleared, failed = result
    if failed:
        print(f"  ⚠️  {failed} verdict row(s) could not be deprecated "
              f"(server refused; {cleared} cleared). The surviving "
              "row(s) keep suppressing this finding — re-run when "
              "the store accepts deprecations. No disk records were "
              "changed.", file=sys.stderr)
        sys.exit(1)
    return cleared


def cmd_verdict(args) -> None:
    """Record a human FP/TP/retest verdict on a finding.

    Authority asymmetry: ``fp`` is refused unless the live invocation
    context earns the OPERATOR grant
    (``live_context_grants_operator`` — not a bare TTY check: a pty
    makes ``isatty`` true by design) — its row suppresses the finding
    cross-run with pipeline authority, so it is reserved for human
    terminal judgment. ``tp`` and ``retest`` stay available
    non-interactively: they are fail-safe (their only effect is that
    the finding gets RE-analyzed), and their provenance stamp records
    the invocation context either way.
    """
    from core.run.verdicts import (
        finding_coords,
        finding_rule_id,
        resolve_finding,
        set_manual_override,
    )

    run_dirs = _verdict_run_dirs(args)
    if not run_dirs:
        print("  No runs found — pass --out <run-dir> or activate a "
              "project.", file=sys.stderr)
        sys.exit(1)

    matches, suggestions = resolve_finding(run_dirs, args.finding_id)
    if not matches:
        print(f"  No finding with id {_line(args.finding_id, max_chars=120)!r} "
              f"in {len(run_dirs)} run(s).", file=sys.stderr)
        if suggestions:
            print("  Did you mean:", file=sys.stderr)
            for s in suggestions:
                print(f"    {_line(s, max_chars=120)}", file=sys.stderr)
        sys.exit(2)

    verb = args.verdict
    ref = matches[0]  # newest run first — SAGE keys are run-agnostic
    rel, fn, line = finding_coords(ref.finding)
    rule = finding_rule_id(ref.finding)
    reason = (args.reason or "").strip()
    source, prov_note, prov_warning, operator = \
        _operator_provenance(args)
    if prov_warning:
        print(f"  ⚠️  {prov_warning}", file=sys.stderr)

    from core.sage.hooks import SUPPRESS_TTL_DAYS

    # Operator-grant gate — fp only, decided BEFORE anything touches
    # SAGE or disk. A CLI fp row is MAC-identical to a pipeline row
    # and suppresses this finding cross-run for the whole TTL; the
    # pipeline's own agent-authored rows are minted at a governed
    # chokepoint behind an actual analysis verdict, while this verb
    # is an id-addressed assertion channel on the preapproved libexec
    # surface — human judgment is the gate that keeps it
    # operator-tier, and the bar is the live-context operator-grant
    # chokepoint (live_context_grants_operator, same as the coverage
    # --mark writer), not a bare isatty check: an in-session agent on
    # the launcher's pty IS interactive-TTY and could otherwise mint
    # the standing suppression itself. tp/retest stay available
    # non-interactively (fail-safe asymmetry: they only ever cause
    # RE-analysis).
    if verb == "fp" and not operator:
        print("  Refused: the fp verb requires an operator context "
              "(the live-context grant discipline: an interactive "
              "terminal at an operator shell, no agent-session or "
              "dispatch environment marker — "
              "core.annotations.provenance."
              "live_context_grants_operator). A false-positive "
              "verdict suppresses this finding on future runs for "
              f"{SUPPRESS_TTL_DAYS} days — that standing "
              "suppression is reserved for human judgment (the "
              "annotation provenance doctrine), and a bare TTY is "
              "not evidence of one (a pty wrapper or an agent "
              "session's own terminal makes isatty true by design). "
              "Nothing was stored or changed. Use 'tp'/'retest' "
              "(both stay available non-interactively — they only "
              "cause re-analysis), or record the review via "
              "/annotate.",
              file=sys.stderr)
        sys.exit(2)

    note = prov_note + (f" reason={_line(reason, max_chars=200)}"
                        if reason else "")

    from core.sage.hooks import (
        SUPPRESS_TTL_DAYS,
        SUPPRESS_VERDICTS,
        finding_verdict_source_hash,
        forget_finding_verdicts,
        operator_client,
        store_finding_verdict,
    )

    client = operator_client()
    sage_absent_msg = (
        "SAGE is not reachable — the cross-run verdict store requires "
        "the SAGE sidecar (there is no disk-side verdict store). "
        "Install/start it with libexec/raptor-sage-setup, then re-run."
    )

    # Source hash: needs the repo and the pipeline's raw coordinates.
    repo_root = _verdict_repo_root(args, ref)
    src_hash = ""
    hash_note = None
    if repo_root and rel and fn and rule:
        # Validate the record's path stays inside the tree before any
        # read — findings files are attacker bytes and a traversal rel
        # must not turn the hash into an arbitrary-file oracle. The
        # STORE still uses the record's raw strings (the pipeline
        # fingerprints on them).
        from core.paths import to_repo_relative
        if to_repo_relative(rel, repo_root, outside_root="none") is None:
            hash_note = "finding path escapes the target tree"
        else:
            src_hash = finding_verdict_source_hash(repo_root, rel, line)
            if not src_hash:
                hash_note = "source file unreadable under the target tree"
    elif not repo_root:
        hash_note = ("target tree unknown — pass --target <repo> "
                     "(no target_path in the run manifest)")
    else:
        hash_note = "finding record lacks rule/file/function coordinates"

    header = {"fp": "False Positive", "tp": "True Positive",
              "retest": "Retest"}[verb]
    loc = f"{_line(rel or '?', max_chars=120)}:{line}"
    print(f"  Verdict:  {header}")
    print(f"  Finding:  {_line(ref.finding_id, max_chars=120)}  "
          f"{loc}  {_line(fn or '?', max_chars=80)}"
          + (f"  [{_line(rule, max_chars=80)}]" if rule else ""))

    if verb == "fp":
        if not src_hash:
            print(f"  Cannot record: {hash_note}.", file=sys.stderr)
            sys.exit(1)
        if client is None:
            print(f"  {sage_absent_msg}", file=sys.stderr)
            sys.exit(1)
        # SAGE store FIRST — if it refuses, the command fails with
        # zero disk mutation (a cleared force-through beside a failed
        # store would silently re-enable suppression the operator
        # never consented to lose).
        ok = store_finding_verdict(
            str(repo_root), rule, rel, fn, src_hash, "false_positive",
            note=note, client=client,
        )
        if not ok:
            print("  Store failed — SAGE refused the row (see logs). "
                  "Nothing was changed.", file=sys.stderr)
            sys.exit(1)
        # A standing manual_override force-through contradicts an
        # operator FP — clear it so the new verdict actually takes.
        cleared_paths, failed_paths = set_manual_override(matches, False)
        _record_operator_verdict(
            ref.run_dir, ref.finding, "false_positive", reason, source)
        print(f"  Stored:   false_positive verdict row "
              f"(source={source})")
        if cleared_paths:
            print(f"  Cleared:  manual_override on "
                  f"{len(cleared_paths)} findings file(s)")
        if _report_failed_edits(failed_paths):
            print("  The false_positive row IS stored; re-run fp "
                  "once the findings file is writable to clear the "
                  "remaining force-through.", file=sys.stderr)
            sys.exit(1)
        if line > 0:
            print(f"  Effect:   future /agentic and /codeql runs on this "
                  f"repo skip the LLM call for this finding while its "
                  f"source is unchanged (TTL {SUPPRESS_TTL_DAYS} days). "
                  f"Undo with: raptor-review verdict "
                  f"{_line(ref.finding_id, max_chars=120)} retest")
        else:
            print("  Effect:   recorded for the knowledge base only — "
                  "line-less findings never auto-suppress.")
        return

    if verb == "tp":
        cleared = None
        stored = False
        if client is not None:
            # The SAGE domain is repo-scoped — without a known target
            # tree there is nothing addressable to clear; say so
            # rather than reporting a normal-looking "Cleared: 0".
            if rule and rel and fn and repo_root:
                cleared = _forget_or_report(
                    forget_finding_verdicts,
                    str(repo_root), rule, rel, fn,
                    verdicts=SUPPRESS_VERDICTS,
                    reason="operator true_positive verdict",
                    client=client,
                )
            else:
                print("  ⚠️  target tree unknown or coordinates "
                      "missing — prior suppressing SAGE verdict rows "
                      "(if any) were NOT cleared; pass --target "
                      "<repo>.", file=sys.stderr)
            if src_hash:
                stored = store_finding_verdict(
                    str(repo_root), rule, rel, fn, src_hash,
                    "true_positive", note=note, client=client,
                )
        changed, failed_paths = set_manual_override(
            matches, True, reason or "operator true_positive verdict")
        _record_operator_verdict(
            ref.run_dir, ref.finding, "true_positive", reason, source)
        if client is None:
            print(f"  ⚠️  {sage_absent_msg} Any prior suppressing SAGE "
                  "verdict rows were NOT cleared.", file=sys.stderr)
        else:
            if cleared is not None:
                print(f"  Cleared:  {cleared} prior suppressing SAGE "
                      "verdict row(s)")
            if stored:
                print(f"  Stored:   true_positive verdict row "
                      f"(source={source})")
            elif hash_note:
                print(f"  Note:     no verdict row stored ({hash_note})")
        if changed:
            print(f"  Set:      manual_override on {len(changed)} "
                  "findings file(s):")
            for p in changed:
                print(f"              {_line(str(p), max_chars=200)}")
        elif not any(m.editable for m in matches):
            print("  Note:     this finding only appears in analysis "
                  "reports (no editable findings file) — the cleared "
                  "SAGE verdict alone makes the next run re-analyze it")
        elif not failed_paths:
            print("  Note:     no findings file needed a manual_override "
                  "change")
        if _report_failed_edits(failed_paths):
            sys.exit(1)
        print("  Effect:   future runs re-analyze this finding; passes "
              "that consume these findings files (/validate, /analyze, "
              "project views) bypass reachability, guard-dominance, and "
              "SAGE prior-verdict suppression for it.")
        return

    # retest — clear everything back to neutral.
    cleared = None
    if client is not None and rule and rel and fn:
        key_root = str(repo_root) if repo_root else None
        if key_root:
            cleared = _forget_or_report(
                forget_finding_verdicts,
                key_root, rule, rel, fn,
                reason="operator retest verdict", client=client,
            )
        else:
            print("  ⚠️  target tree unknown — cannot address the "
                  "repo-scoped SAGE domain; pass --target <repo> to "
                  "clear stored rows.", file=sys.stderr)
    elif client is None:
        print(f"  ⚠️  {sage_absent_msg} Stored SAGE verdict rows (if "
              "any) were NOT cleared.", file=sys.stderr)
    else:
        print("  ⚠️  finding record lacks rule/file/function "
              "coordinates — stored SAGE verdict rows (if any) were "
              "NOT cleared.", file=sys.stderr)
    changed, failed_paths = set_manual_override(matches, False)
    _record_operator_verdict(
        ref.run_dir, ref.finding, "retest", reason, source)
    if cleared is not None:
        print(f"  Cleared:  {cleared} stored SAGE verdict row(s)")
    if changed:
        print(f"  Cleared:  manual_override on {len(changed)} findings "
              "file(s)")
    if _report_failed_edits(failed_paths):
        sys.exit(1)
    print("  Effect:   the next run re-analyzes this finding from "
          "scratch (no stored verdict, no force-through).")


# ── Argument parsing ─────────────────────────────────────────────────

# Flags that consume a following value. The default-subcommand sniffer
# must skip those values — pre-fix `raptor-review --project /x stats`
# picked `/x` (a flag VALUE) as the first positional, decided it wasn't
# a known subcommand, and prepended "show", so `stats` was parsed as
# show's <file> argument.
_VALUE_FLAGS = frozenset({
    "--out", "--project", "--target", "--status", "--base",
    "--source", "-m", "--body",
})


def _first_positional(argv_rest: list) -> str | None:
    """First true positional, skipping values consumed by flags.

    ``--flag value`` consumes the next token; ``--flag=value`` carries
    its value inline and consumes nothing.
    """
    skip = False
    for a in argv_rest:
        if skip:
            skip = False
            continue
        if a.startswith("-") and a != "-":
            if a in _VALUE_FLAGS:
                skip = True
            continue
        return a
    return None


def main():
    # SUPPRESS, not None/False: ``common`` parents BOTH the main
    # parser and every subparser, and a subparser re-applies its
    # defaults over the namespace — `--project X <subcmd>` (flag
    # before the subcommand) parsed fine and then had the value
    # silently clobbered back to the default. With SUPPRESS the
    # subparser only touches the attribute when the flag actually
    # appears after the subcommand; every reader already goes through
    # getattr(args, ..., default).
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--out", default=argparse.SUPPRESS,
                        help="Output directory")
    common.add_argument("--project", default=argparse.SUPPRESS,
                        help="Project directory")
    common.add_argument("--raw", action="store_true",
                        default=argparse.SUPPRESS, help="JSON output")

    parser = argparse.ArgumentParser(
        prog="raptor-review",
        description="Unified review CLI — queries all layers.",
        parents=[common],
    )

    sub = parser.add_subparsers(dest="command")

    p_show = sub.add_parser("show", parents=[common], help="Unified view for file/function")
    p_show.add_argument("file")
    p_show.add_argument("function", nargs="?", default=None)

    sub.add_parser("findings", parents=[common], help="All findings across runs")
    sub.add_parser("gaps", parents=[common], help="What needs review")

    p_hist = sub.add_parser("history", parents=[common], help="Review history for a function")
    p_hist.add_argument("file")
    p_hist.add_argument("function")

    sub.add_parser("stats", parents=[common], help="Entry counts, costs")
    sub.add_parser("notes", parents=[common], help="List operator annotations")

    p_note = sub.add_parser("note", parents=[common], help="Add operator note")
    p_note.add_argument("file")
    p_note.add_argument("function")
    p_note.add_argument("-m", "--body", default=None)
    p_note.add_argument("--status", default=None)
    p_note.add_argument(
        "--base", default=None,
        help="annotation base dir (default: active project)",
    )

    p_edit = sub.add_parser("edit", parents=[common], help="Edit operator note")
    p_edit.add_argument("file")
    p_edit.add_argument("function")
    p_edit.add_argument(
        "--base", default=None,
        help="annotation base dir (default: active project)",
    )

    p_stale = sub.add_parser(
        "stale", parents=[common],
        help="Find stale reviews (--source annotation|journal|both)",
    )
    p_stale.add_argument("--target", default=None)
    p_stale.add_argument(
        "--source", default="annotation",
        choices=["annotation", "journal", "both"],
        help="Which store to check for staleness (default: annotation)",
    )

    sub.add_parser("edges", parents=[common],
                   help="Edge obligations, verdicts, blind spots")

    p_diff = sub.add_parser(
        "diff", parents=[common],
        help="Verdict changes between two runs (default: two most recent)")
    p_diff.add_argument("runs", nargs="*", default=[])

    sub.add_parser(
        "live", parents=[common],
        help="Tail-follow a running audit's journal")

    sub.add_parser("compact", parents=[common], help="Compact project journal index")

    p_cov = sub.add_parser("coverage", parents=[common], help="Mechanical tool coverage")
    p_cov.add_argument("file", nargs="?", default=None)

    p_dig = sub.add_parser(
        "digest", parents=[common],
        help="Ranked end-of-run summary for a run")
    p_dig.add_argument("run_dir", nargs="?", default=None)

    p_verd = sub.add_parser(
        "verdict", parents=[common],
        help="Record a human FP/TP/retest verdict on a finding. "
             "fp gates on the live-context operator grant, which "
             "refuses the dispatch trust markers every shipped "
             "launcher route carries — fp does not mint in "
             "production (setting _RAPTOR_TRUSTED=1 to reach this "
             "CLI is itself a refused marker, so the preamble's "
             "bypass hint does not help here); use /annotate for "
             "operator FP assertions, tp/retest for re-analysis")
    p_verd.add_argument("finding_id")
    p_verd.add_argument("verdict", choices=["fp", "tp", "retest"])
    p_verd.add_argument("-m", "--reason", default=None,
                        help="why (recorded with the verdict)")
    p_verd.add_argument("--target", default=None,
                        help="source tree root (default: the run "
                             "manifest's target_path)")
    p_verd.add_argument("--source", default=None,
                        choices=["human", "agent"],
                        help="verdict source (default: human on an "
                             "interactive TTY, else agent)")

    known_commands = {
        "show", "findings", "gaps", "history", "stats", "notes",
        "note", "edit", "stale", "compact", "coverage", "diff", "live",
        "edges", "verdict", "digest",
    }
    argv_rest = sys.argv[1:]
    first_positional = _first_positional(argv_rest)

    if first_positional and first_positional not in known_commands:
        argv_rest = ["show"] + argv_rest
    args = parser.parse_args(argv_rest)

    if not args.command:
        parser.print_help()
        sys.exit(0)

    dispatch = {
        "show": cmd_show,
        "findings": cmd_findings,
        "gaps": cmd_gaps,
        "history": cmd_history,
        "stats": cmd_stats,
        "notes": cmd_notes,
        "note": cmd_note,
        "edit": cmd_edit,
        "stale": cmd_stale,
        "compact": cmd_compact,
        "coverage": cmd_coverage,
        "diff": cmd_diff,
        "live": cmd_live,
        "edges": cmd_edges,
        "verdict": cmd_verdict,
        "digest": cmd_digest,
    }

    handler = dispatch.get(args.command)
    if handler:
        handler(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
