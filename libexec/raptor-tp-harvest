#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""True-positive harvest flywheel — confirmed findings to rule candidates + labels.

    raptor-tp-harvest <run-dir> [--status] [--no-candidates] [--json]
    raptor-tp-harvest <run-dir> --label <harvest-id> --provenance {public,own-target}
                      --bug-class <class> --rationale <text> --repo <id>
                      [--cve ...] [--fix-commit ...] [--sha ...] [--labels-base ...]

Walks a completed run's confirmed/exploitable findings and emits, per
finding: a harvest record (mechanism + span identity + evidence
pointers), a run-local Semgrep rule CANDIDATE (never auto-enabled),
and a disclosure-backlog pointer. Corpus labels are provenance-gated
per finding via --label (default: not labelable). Idempotent per run,
keyed on finding identity; audit trail in tp-harvest/harvest-manifest.json.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def main() -> int:
    from core.tp_harvest.cli import main as cli_main

    return cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
