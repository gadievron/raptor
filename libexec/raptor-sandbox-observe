#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Run a command under sandbox(observe=True) and print what it touched.

Operator-friendly companion to the programmatic API:

  raptor-sandbox-observe -- /usr/bin/true
  raptor-sandbox-observe --json -- claude --version
  raptor-sandbox-observe --keep --out /tmp/probe -- ./scan-target

Implemented as a shim over core.sandbox.observe_cli._cli_main rather
than `python -m core.sandbox.observe_cli` to avoid the runpy double-
import warning that fires when core/sandbox/__init__.py transitively
imports core.sandbox.observe_cli before runpy executes it as __main__.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

from core.sandbox.observe_cli import _cli_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(_cli_main())
