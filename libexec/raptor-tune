#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Show or update RAPTOR resource tuning.

Usage:
  raptor-tune                Show resolved tuning values
  raptor-tune max            Rewrite tuning.json to use all available resources
  raptor-tune balanced       Rewrite tuning.json with conservative values
  raptor-tune default        Rewrite tuning.json to shipped defaults
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

from core.json import load_json_with_comments  # noqa: E402
from core.tuning import (  # noqa: E402
    _DEFAULTS,
    _detect_available_cpus,
    _rewrite_tuning,
    load_tuning,
)

_REPO_ROOT = Path(__file__).resolve().parents[1]
_TUNING_PATH = _REPO_ROOT / "tuning.json"


def _system_info() -> dict:
    try:
        pages = os.sysconf("SC_PHYS_PAGES")
        page_size = os.sysconf("SC_PAGE_SIZE")
        total_ram_mb = pages * page_size // (1024 * 1024)
    except (ValueError, OSError):
        total_ram_mb = None
    cpus = _detect_available_cpus()
    return {"total_ram_mb": total_ram_mb, "cpus": cpus}


def _max_values() -> dict:
    """Use all available resources."""
    info = _system_info()
    cpus = info["cpus"] or 4
    ram = info["total_ram_mb"]
    codeql_ram_mb = max(2048, min(ram // 2, 32768)) if ram else 16384
    codeql_worker_ram_cap = max(1, ram // codeql_ram_mb) if ram else 1
    return {
        "codeql_ram_mb": codeql_ram_mb,
        "codeql_threads": cpus,
        "joern_heap_mb": max(1024, ram // 2) if ram else 8192,
        "max_semgrep_workers": max(2, cpus),
        "max_codeql_workers": max(1, min(cpus // 2, 8, codeql_worker_ram_cap)),
        "max_fuzz_parallel": max(1, cpus // 2),
        # "use all available resources" extends to the LLM account:
        # max asserts the account's quota belongs to this host's runs.
        "llm_account_posture": "solo",
    }


def _balanced_values() -> dict:
    """Leave headroom for other workloads."""
    info = _system_info()
    cpus = info["cpus"] or 4
    ram = info["total_ram_mb"]
    return {
        "codeql_ram_mb": max(2048, min(ram // 8, 8192)) if ram else 4096,
        "codeql_threads": max(1, cpus // 2),
        "joern_heap_mb": max(1024, min(ram // 8, 8192)) if ram else 2048,
        "max_semgrep_workers": max(1, cpus // 4),
        "max_codeql_workers": 1,
        "max_fuzz_parallel": 1,
        "llm_account_posture": "shared",
    }


def _default_values() -> dict:
    out = dict(_DEFAULTS)
    # Profiles OWN the posture (each profile IS a sharing stance:
    # balanced/default leave headroom, max claims everything), so a
    # retune resets a hand-edited posture rather than preserving it
    # like the operator-only passthrough keys. The preserved
    # max_llm_workers override still beats posture at read time, so
    # an operator's explicit worker count survives any retune.
    out["llm_account_posture"] = "shared"
    return out


def _with_defaults(producer):
    """Wrap a profile producer so its output is layered over `_DEFAULTS`.

    Each profile listed below explicitly sets six tuning keys (the
    current `_DEFAULTS` set). When a new key is added to `_DEFAULTS`
    (e.g. a future `max_validate_workers`), pre-fix the profile
    output stayed at six keys — the new key was missing from
    `tuning.json` until an operator re-ran `raptor-tune default` or
    edited the file by hand. Worse, callers reading `tuning.json`
    directly might fall back to a hardcoded zero / empty value
    rather than the `_DEFAULTS` value, since they bypassed
    `core.tuning`'s normalisation layer.

    Layer `_DEFAULTS` UNDER the profile-specific values so every
    `_DEFAULTS` key is always present; the profile-specific value
    wins when both define the same key.
    """
    def _layered():
        out = dict(_DEFAULTS)
        out.update(producer())
        return out
    return _layered


_PROFILES = {
    "max": (_with_defaults(_max_values), "use all available resources"),
    "balanced": (_with_defaults(_balanced_values), "leave headroom for other workloads"),
    "default": (_default_values, "shipped defaults"),
}

def _write_tuning(values: dict) -> None:
    """Rewrite tuning.json for a preset via core.tuning's canonical writer.

    Layer the preset values over the CURRENT file contents so valid
    operator-set keys the presets don't produce (the passthrough keys
    such as max_llm_workers / throttle_cooldown_s) survive the rewrite
    — a retune must not silently delete unrelated operator config.
    Delegating to core.tuning's writer also gets its key order,
    comments, and atomic tmp+rename for free, so this CLI can never
    drift from the substrate's own rewrite behaviour or leave a torn
    file for a concurrent load_tuning() to read.
    """
    existing = load_json_with_comments(_TUNING_PATH)
    merged = dict(existing) if isinstance(existing, dict) else {}
    merged.update(values)
    _rewrite_tuning(merged, _TUNING_PATH)


def _show() -> None:
    """Show resolved tuning values with source info."""
    t = load_tuning()
    info = _system_info()
    raw = load_json_with_comments(_TUNING_PATH) or {}

    ram_label = f"{info['total_ram_mb']} MB" if info["total_ram_mb"] else "unknown"
    print(f"Hardware: {info['cpus']} CPUs, {ram_label} RAM")
    print(f"Config:   {_TUNING_PATH}")
    print()

    fields = [
        ("codeql_enabled", t.codeql_enabled, ""),
        ("codeql_ram_mb", t.codeql_ram_mb, "MB"),
        ("codeql_threads", t.codeql_threads, "CPUs"),
        ("codeql_max_disk_cache_mb", t.codeql_max_disk_cache_mb, "MB"),
        ("joern_enabled", t.joern_enabled, ""),
        ("joern_heap_mb", t.joern_heap_mb, "MB"),
        ("joern_cpg_timeout_s", t.joern_cpg_timeout_s, "s"),
        ("joern_query_timeout_s", t.joern_query_timeout_s, "s"),
        ("max_semgrep_workers", t.max_semgrep_workers, ""),
        ("max_codeql_workers", t.max_codeql_workers, ""),
        ("max_fuzz_parallel", t.max_fuzz_parallel, ""),
        ("max_inventory_workers", t.max_inventory_workers, ""),
        ("max_json_memo_mb", t.max_json_memo_mb, "MB"),
    ]
    for name, value, unit in fields:
        raw_val = raw.get(name, _DEFAULTS.get(name))
        if raw_val == "auto":
            shown = value
            if name == "codeql_threads" and value == 0:
                shown = f"all {info['cpus']}" if info["cpus"] else "all"
            display = f"auto ({shown}{' ' + unit if unit else ''})"
        else:
            display = f"{value}{' ' + unit if unit else ''}"
        print(f"  {name:25s} {display}")

    # Passthrough keys are consumed raw by core/llm/concurrency.py —
    # show the file values (or their documented defaults) so the
    # operator can see what a profile set without opening the file.
    passthrough = [
        ("max_llm_workers", raw.get("max_llm_workers", "auto"), ""),
        ("llm_account_posture", raw.get("llm_account_posture", "shared"), ""),
        ("throttle_cooldown_s", raw.get("throttle_cooldown_s", 30), "s"),
    ]
    for name, value, unit in passthrough:
        print(f"  {name:25s} {value}{' ' + unit if unit else ''}")


def main() -> int:
    args = sys.argv[1:]

    if not args:
        _show()
        return 0

    profile = args[0]
    if profile in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    if profile not in _PROFILES:
        print(f"Unknown profile: {profile}", file=sys.stderr)
        print(f"Available: {', '.join(_PROFILES)}", file=sys.stderr)
        return 1

    gen_fn, description = _PROFILES[profile]
    values = gen_fn()
    _write_tuning(values)
    print(f"tuning.json updated: {description}")
    print()

    # _DEFAULTS iterates in its declaration order — the same order the
    # canonical writer emits (profile-set extra keys such as
    # llm_account_posture follow, matching the writer's key order).
    echo_keys = list(_DEFAULTS) + [
        k for k in values if k not in _DEFAULTS]
    for key in echo_keys:
        val = values[key]
        print(f"  {key:25s} {val}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
