#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Pre-Claude startup check — project auto-detect and mismatch prompt.

Usage: raptor-startup-check [--caller-dir <dir>] [-p <project>]

Called by bin/raptor before exec claude. Handles:
  - -p <project> flag: activate the named project (bookmark bump)
  - Auto-detect: caller dir matches a project target — resolved for
    THIS SESSION only; the machine-wide bookmark is NOT moved
  - Mismatch: if the bookmark's target differs from caller dir, prompt

OUTPUT CONTRACT: every human-facing line — the
interactive mismatch menu included — goes to STDERR. Stdout carries
machine lines only, the LAST being the seed sentinel the launcher
parses:

    RAPTOR_SEEDED_BY=<flag|auto|bookmark|use|create|adopt>
    RAPTOR_RESOLVED_PROJECT=<name|->

The launcher seeds the session's registry entry from that value and
NEVER re-reads the symlink (the pre-fix re-read raced concurrent
symlink writers: an explicit -p could seed another session's project).
This script operates on the BOOKMARK layer only — a session does not
exist yet, and resolving through the layered chokepoint here would let
an ENCLOSING claude session's binding leak into the new launch.

Exit 0 on success (continue to claude), non-zero on abort; the
launcher seeds '-' and continues on any failure.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def _find_project_for(directory, exclude=None):
    """Find a project whose target matches directory."""
    from core.project import ProjectManager
    project = ProjectManager().find_project_for_target(directory)
    if project and project.name != exclude:
        return project.name
    return None


def _bookmark_name():
    """The last-activated bookmark — the raw symlink target. This
    script deliberately BYPASSES the layered resolution: no session
    exists yet, and an enclosing claude session's binding must not
    steer a fresh launch."""
    from core.startup import ACTIVE_LINK
    try:
        target = os.readlink(ACTIVE_LINK)
    except OSError:
        return None
    if target.endswith(".json") and "/" not in target and "\\" not in target:
        return target[:-5]
    return None


def _load_active():
    """Load bookmark project name, target, output_dir. Returns dict or None."""
    from core.startup import PROJECTS_DIR
    from core.json import load_json
    name = _bookmark_name()
    if not name:
        return None
    data = load_json(PROJECTS_DIR / f"{name}.json")
    if not data:
        return None
    return {
        "name": name,
        "target": data.get("target", ""),
        "output_dir": data.get("output_dir", ""),
    }


def _activate(name):
    """Activate a project by setting the .active symlink."""
    from core.project import ProjectManager
    mgr = ProjectManager()
    project = mgr.load(name)
    if not project:
        return False
    mgr.set_active(name)
    return True


def _check_mismatch(caller_dir):
    """If the bookmark's target doesn't match caller dir, prompt.
    Returns the resolved project name for the seed ('-' = session-only
    none), or None when no prompt was needed."""
    active = _load_active()
    if not active or not active["target"]:
        return None

    try:
        resolved_caller = Path(caller_dir).resolve()
        resolved_target = Path(active["target"]).resolve()
    except OSError:
        return None

    if resolved_caller == resolved_target:
        return None

    # Check if caller dir matches a different project
    other = _find_project_for(caller_dir, exclude=active["name"])
    if not other:
        return None

    # This menu is an authorization surface (it decides which project
    # binds the session) and target PATHS have no charset constraint
    # (adopted / machine-created `corpus-*` targets are external
    # input), so render them with non-printables escaped. Project
    # NAMES are _validate_name-constrained and print as-is.
    from core.security.log_sanitisation import sanitise_for_terminal
    shown_target = sanitise_for_terminal(str(active["target"]))
    shown_caller = sanitise_for_terminal(str(caller_dir))

    print(f"""
  Last-activated project is {active['name']} ({shown_target})
  You are in {other}'s target directory ({shown_caller})

  Continue this session with:
    1) {active['name']}
    2) {other}
    3) no project (this session only)

  or enter anything else to quit
""", file=sys.stderr)
    # Non-TTY → take the default ("1", keep current active) without
    # prompting. Pre-fix `input()` blocked indefinitely or consumed
    # whatever stdin happened to be feeding the process — for
    # interactive launches that's fine, but the script also runs
    # under hooks / CI / piped invocations where:
    #
    # * stdin is redirected from a file: the next byte got
    #   consumed as the choice, producing surprising behaviour
    #   (random project switches mid-script-pipeline)
    # * stdin is /dev/null: input() raised EOFError immediately;
    #   the existing except caught it but then we silently exited
    #   the whole script instead of just defaulting the prompt
    # * stdin is a tty but the operator didn't even know they
    #   had a stale active project (no signal that anything was
    #   waiting for them)
    #
    # `sys.stdin.isatty()` is the canonical test. If false, default
    # silently and continue.
    if not sys.stdin.isatty():
        choice = "1"
    else:
        try:
            sys.stderr.write("  Choice [1]: ")
            sys.stderr.flush()
            choice = input().strip() or "1"
        except (EOFError, KeyboardInterrupt):
            sys.exit(3)  # operator quit — launcher aborts on 3

    if choice == "1":
        return active["name"]
    if choice == "2":
        if _activate(other):
            print(f"  Switched to {other}", file=sys.stderr)
            return other
        return active["name"]
    if choice == "3":
        # Session-only clear: the machine-wide
        # bookmark is untouched — other sessions and future launches
        # keep their default. The launcher seeds '-' for THIS session.
        print("  No project for this session "
              "(last-activated default unchanged)", file=sys.stderr)
        return "-"
    sys.exit(3)  # operator quit — launcher aborts on 3


def main():
    caller_dir = None
    project_flag = None
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == "--caller-dir" and i + 1 < len(sys.argv):
            caller_dir = sys.argv[i + 1]
            i += 2
        elif arg in ("-p", "--project") and i + 1 < len(sys.argv):
            project_flag = sys.argv[i + 1]
            i += 2
        else:
            i += 1

    resolved = "-"
    seeded_by = "bookmark"
    try:
        # Legacy .auto marker (retired: provenance now lives in the
        # session entry's seeded_by field) — clean up any leftover.
        from core.startup import PROJECTS_DIR
        auto_marker = PROJECTS_DIR / ".auto"
        if auto_marker.exists():
            auto_marker.unlink()

        # Handle -p flag: explicit activation = bookmark bump, same
        # semantics as /project use.
        if project_flag:
            if not _activate(project_flag):
                print(f"  Project '{project_flag}' not found",
                      file=sys.stderr)
                sys.exit(1)
            resolved, seeded_by = project_flag, "flag"
        else:
            active = _load_active()
            if not active and caller_dir:
                # Auto-detect resolves for THIS SESSION ONLY: the
                # machine-wide bookmark is NOT moved —
                # one session launching inside a project tree must not
                # re-default every other no-entry session and future
                # launch on the machine.
                auto_name = _find_project_for(caller_dir)
                if auto_name:
                    print(f"  Auto-detected project: {auto_name} "
                          f"(this session)", file=sys.stderr)
                    resolved, seeded_by = auto_name, "auto"
            elif active:
                switched = None
                if caller_dir:
                    switched = _check_mismatch(caller_dir)
                resolved = switched if switched else active["name"]
                seeded_by = "bookmark"

        # Sweep stale runs in the resolved project
        if resolved != "-":
            from core.project import ProjectManager
            p = ProjectManager().load(resolved)
            if p:
                p.sweep_stale_runs()

    except Exception as e:
        # Non-fatal — continue to Claude; the launcher seeds whatever
        # the sentinel carries ('-' unless resolution got further).
        print(f"  Startup check warning: {e}", file=sys.stderr)
    finally:
        # THE machine contract: the launcher parses the
        # LAST stdout line; everything human went to stderr above.
        print(f"RAPTOR_SEEDED_BY={seeded_by}")
        print(f"RAPTOR_RESOLVED_PROJECT={resolved}")


if __name__ == "__main__":
    main()
