#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Run lifecycle — records start and stop timestamps/status.

Usage:
  raptor-run-lifecycle start <command> --target <path> [--out <dir>]
  raptor-run-lifecycle complete <output_dir> [--model <id>] [--command <name>]
  raptor-run-lifecycle fail <output_dir> [message] [--command <name>]
  raptor-run-lifecycle cancel <output_dir> [--command <name>]
  raptor-run-lifecycle interrupt <output_dir> [message] [--command <name>]

start: resolves output directory, writes .raptor-run.json with status=running
complete: updates status=completed
fail: updates status=failed with optional error message
cancel: updates status=cancelled
interrupt: updates status=interrupted (supervisor stop; resumable —
  e.g. `raptor-audit resume <output_dir>` for audit runs)

--command on the terminal actions asserts ownership: the value is the
command the CALLER believes it is finalising. When it does not match
the run's recorded command, the transition is refused (exit 1) and the
run's status is left untouched. This is the mechanical guard against a
sub-step finalising a run it does not own — e.g. an in-session
/understand --map running with --out pointed at an /audit-owned dir
must pass `--command understand`, which refuses against the audit run
instead of stamping it completed hours before the audit finishes.
Omitting --command preserves the legacy unchecked surface.

This script only writes metadata. Coverage, cleanup, and reporting
are handled by their respective tools.
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.run.metadata import complete_run, fail_run, start_run  # noqa: E402
from core.run.output import TargetMismatchError, get_output_dir  # noqa: E402


def _pop_flag(rest: list, name: str):
    """Extract ``<name> <value>`` from *rest* in place; None if absent.

    Shared by the terminal actions, whose surfaces mix a positional
    message with optional flags — argparse would reject the free-form
    message text the callers already pass.
    """
    if name not in rest:
        return None
    i = rest.index(name)
    if i + 1 < len(rest):
        value = rest[i + 1]
        del rest[i:i + 2]
        return value
    del rest[i:i + 1]  # dangling flag — treat as absent
    return None


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)

    action = sys.argv[1]

    if action == "start":
        # Use argparse instead of the hand-rolled walker. Pre-fix the
        # walker had three subtle gaps:
        #
        # 1. `--target` with no following value: the `i + 1 < len(sys.argv)`
        #    guard kept target_path as None, then the else at the bottom
        #    advanced i by 1 — but the operator's bug ("--target" at end,
        #    no value) was silently swallowed. Argparse errors with a
        #    clear "expected one argument" message at parse time.
        # 2. `--target X positional_arg` ordering: walker accepted both
        #    forms, but `positional_arg --target X` ALSO accepted and
        #    used the positional first (then --target overrode), which
        #    invited surprises about WHICH path actually won when the
        #    operator was using both forms in scripts. Argparse
        #    rejects unknown positional args by default — the operator
        #    types one path either via flag or positional, not both.
        # 3. Unknown flags (typo `--targt`) silently consumed by the
        #    final else branch — operator's intended `--target` was
        #    never set, target_path stayed None, downstream
        #    `get_output_dir` ran without target context. Argparse
        #    errors on unknown flags by default.
        import argparse as _argparse
        parser = _argparse.ArgumentParser(
            prog="raptor-run-lifecycle start",
            description="Start a run lifecycle for a RAPTOR command",
        )
        parser.add_argument("command", help="Command name (scan|agentic|...)")
        parser.add_argument("positional_target", nargs="?", default=None,
                            help="Target path (alternative to --target)")
        parser.add_argument("--target", dest="target_flag", default=None,
                            help="Target path (preferred form)")
        parser.add_argument("--out", dest="explicit_out", default=None,
                            help="Explicit output directory override")
        parser.add_argument(
            "--max-cost-usd", dest="max_cost_usd", default=None,
            type=float,
            help="Per-run USD budget cap; pre-flight gate refuses "
                 "to start when scorecard estimate exceeds the cap",
        )
        parser.add_argument(
            "--wait", action="store_true",
            help="Queue behind an in-progress run on the same project "
                 "instead of refusing immediately",
        )
        # `sys.argv[2:]` so the `start` subcommand isn't re-parsed.
        # On bad args argparse raises SystemExit after printing a
        # clean usage message to stderr.
        args = parser.parse_args(sys.argv[2:])

        # `--target` takes precedence over the positional form so a
        # script that explicitly passes `--target X` always wins.
        # Pre-fix the walker did "first one wins" via `or`, which is
        # ordering-dependent.
        target_path = args.target_flag or args.positional_target

        try:
            out_dir = get_output_dir(args.command, target_path=target_path,
                                     explicit_out=args.explicit_out)
        except TargetMismatchError as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

        # Run-start contention (managed project dirs only): a live run
        # owned by another session refuses IMMEDIATELY with the holder
        # named; --wait queues. Crashed runs (dead recorded pid) never
        # block — see core.run.metadata._live_conflicting_run.
        from core.project.oplock import OpLockContention
        try:
            start_run(out_dir, args.command, target=target_path,
                      wait_for_project=args.wait)
        except OpLockContention as e:
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

        # Pre-flight cost gate (scorecard-derived). When
        # --max-cost-usd is set, compare against the scorecard
        # estimate. Shared implementation lives in raptor.py so the
        # two entry points cannot drift; the estimate line goes to
        # stderr so stdout stays single-line OUTPUT_DIR= for callers
        # that parse it. The gate runs BEFORE the sentinel prints:
        # callers treat OUTPUT_DIR= as "the run started, write here",
        # so a gate refusal (exit 1, run marked failed) must not hand
        # them a directory to write into.
        if args.max_cost_usd is not None and target_path:
            try:
                from raptor import _preflight_cost_gate
                if _preflight_cost_gate(
                    str(target_path), args.max_cost_usd, out_dir,
                    estimate_stream=sys.stderr,
                ):
                    sys.exit(1)
            except SystemExit:
                raise
            except Exception as e:  # noqa: BLE001
                sys.stderr.write(f"  (estimate skipped: {e})\n")

        print(f"OUTPUT_DIR={out_dir}")

    elif action == "complete":
        if len(sys.argv) < 3:
            print("Usage: raptor-run-lifecycle complete <output_dir> "
                  "[--model <id>] [--command <name>]",
                  file=sys.stderr)
            sys.exit(1)
        # Optional --model: the ambient harness model only the agent knows
        # (RAPTOR's Python can't read /model — no env var). The /understand
        # skill instructs the agent to pass its own model id here.
        # Optional --command: ownership claim (see module docstring).
        rest = list(sys.argv[3:])
        claim = _pop_flag(rest, "--command")
        model = _pop_flag(rest, "--model")
        try:
            # Ownership gate FIRST — before the journal merge below
            # touches the (possibly foreign) run's project index.
            from core.run.metadata import ensure_run_command
            ensure_run_command(Path(sys.argv[2]), claim)
            manifest = None
            if model:
                from core.run.provenance import harness_model_entry
                entry = harness_model_entry(model)
                if entry:
                    manifest = {"models": [entry]}
            # The review-journal → project-index merge happens inside
            # ``complete_run`` (the completion chokepoint), so it fires
            # for direct Python callers as well as this shim.
            complete_run(Path(sys.argv[2]), manifest=manifest,
                         expected_command=claim)
        except Exception as e:  # noqa: BLE001 — CLI boundary: report and exit
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    elif action == "fail":
        if len(sys.argv) < 3:
            print("Usage: raptor-run-lifecycle fail <output_dir> [message] "
                  "[--command <name>]", file=sys.stderr)
            sys.exit(1)
        rest = list(sys.argv[3:])
        claim = _pop_flag(rest, "--command")
        message = rest[0] if rest else "unknown error"
        try:
            fail_run(Path(sys.argv[2]), message, expected_command=claim)
        except Exception as e:  # noqa: BLE001 — CLI boundary: report and exit
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    elif action == "cancel":
        if len(sys.argv) < 3:
            print("Usage: raptor-run-lifecycle cancel <output_dir> "
                  "[--command <name>]", file=sys.stderr)
            sys.exit(1)
        rest = list(sys.argv[3:])
        claim = _pop_flag(rest, "--command")
        try:
            from core.run.metadata import cancel_run
            cancel_run(Path(sys.argv[2]), expected_command=claim)
        except Exception as e:  # noqa: BLE001 — CLI boundary: report and exit
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    elif action == "interrupt":
        if len(sys.argv) < 3:
            print("Usage: raptor-run-lifecycle interrupt <output_dir> "
                  "[message] [--command <name>]",
                  file=sys.stderr)
            sys.exit(1)
        rest = list(sys.argv[3:])
        claim = _pop_flag(rest, "--command")
        message = rest[0] if rest else None
        try:
            # ``interrupt_run`` gates ownership (expected_command)
            # and merges the journal into the project index itself —
            # an interrupted run's verdicts are real reviews and must
            # reach sibling runs and the resume.
            from core.run.metadata import interrupt_run
            interrupt_run(Path(sys.argv[2]), message,
                          expected_command=claim)
        except Exception as e:  # noqa: BLE001 — CLI boundary: report and exit
            print(f"ERROR: {e}", file=sys.stderr)
            sys.exit(1)

    else:
        print(f"Unknown action: {action}", file=sys.stderr)
        print("Actions: start, complete, fail, cancel, interrupt", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
