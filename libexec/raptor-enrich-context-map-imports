#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Enrich context-map.json with mechanically-extracted imports from
checklist.json call_graph data.

Usage: raptor-enrich-context-map-imports <understand_dir>

Reads per-file ``call_graph.imports`` from the inventory and writes
a flat ``imports`` array into context-map.json.  Ground-truth module
names — no LLM enumeration.  Idempotent.
"""
import argparse
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.artifacts.context_map_budget import (  # noqa: E402
    enforce_context_map_budget,
)
from core.json import load_json, save_json  # noqa: E402
from core.orchestration.context_map_imports import (  # noqa: E402
    enrich_context_map_imports,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="raptor-enrich-context-map-imports",
        description=(
            "Enrich context-map.json with mechanically-extracted imports "
            "from checklist.json call_graph data."
        ),
    )
    parser.add_argument("understand_dir", help="path to /understand run dir")
    args = parser.parse_args()

    understand_dir = Path(args.understand_dir).resolve()
    if not understand_dir.is_dir():
        print(
            f"raptor-enrich-context-map-imports: {understand_dir} is "
            "not a directory", file=sys.stderr,
        )
        return 1

    context_map_path = understand_dir / "context-map.json"
    if not context_map_path.exists():
        print(
            f"raptor-enrich-context-map-imports: {context_map_path} "
            "does not exist", file=sys.stderr,
        )
        return 1

    context_map = load_json(context_map_path)
    if not isinstance(context_map, dict):
        print(
            f"raptor-enrich-context-map-imports: {context_map_path} "
            "is not a JSON object", file=sys.stderr,
        )
        return 1

    checklist = load_json(understand_dir / "checklist.json") or {}
    if not isinstance(checklist, dict):
        print(
            "raptor-enrich-context-map-imports: checklist.json missing "
            "or invalid; skipping", file=sys.stderr,
        )
        return 0

    target_path = checklist.get("target_path")
    if not target_path:
        print(
            "raptor-enrich-context-map-imports: checklist missing "
            "target_path; skipping", file=sys.stderr,
        )
        return 0

    from core.run.metadata import corroborate_target_path
    mismatch = corroborate_target_path(understand_dir, target_path)
    if mismatch:
        print(
            f"raptor-enrich-context-map-imports: {mismatch}; refusing "
            "recovered target", file=sys.stderr,
        )
        return 1

    count = enrich_context_map_imports(context_map, checklist)
    if count:
        # The imports array can be large on big polyglot targets — keep
        # the write inside the consumer byte cap, or strict downstream
        # readers refuse the oversize map.
        enforce_context_map_budget(context_map)
        save_json(context_map_path, context_map)
        print(
            f"raptor-enrich-context-map-imports: {count} import(s) "
            f"written to {context_map_path}"
        )
    else:
        print(
            "raptor-enrich-context-map-imports: no imports found in "
            "checklist call_graph data",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
