#!/usr/bin/python3 -I
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""RAPTOR seatbelt outer-watcher shim for the macOS sandbox-exec path.

-I (isolated mode) is belt-and-braces: get_safe_env() strips PYTHON* env
already, but -I makes python ignore PYTHON* regardless, so an attacker-
influenced PYTHONPATH can't inject a sitecustomize.py into OUR interpreter
between execve and main(). This shim runs UNSANDBOXED (outside the seatbelt
profile), so it can read its stdlib freely — the profile-readability concern
applies only to the in-sandbox trampoline, which is /bin/sh, not python.

Why this exists
---------------
The macOS backend (`core/sandbox/_macos_spawn.py`) runs the target under
`sandbox-exec -p <profile> -- <target>`. That gives isolation but leaves
two gaps the Linux backend already closes:

  1. Fail-loud setup detection. If `sandbox-exec` fails to APPLY the
     profile it exits before running the target. We want an UNSPOOFABLE
     positive proof that the target was reached INSIDE the sandbox, so a
     profile-apply failure can't masquerade as a normal "0 findings" run.

  2. Orphan teardown. macOS has no pid-namespace (so no kernel cascade when
     an init dies) and no PR_SET_PDEATHSIG. If the orchestrator is hard-
     killed (SIGKILL/OOM/crash) mid-run, the blocking subprocess.run can't
     clean up and `sandbox-exec` + target reparent to launchd and leak.

Design (two cooperating pieces)
-------------------------------
This file is the OUTER watcher. It runs unsandboxed as subprocess.run's
direct child, and is handed the full sandbox-exec invocation as its argv:

    raptor-seatbelt-shim  sandbox-exec -p <profile> -- \
        /bin/sh -c 'printf K >&3; exec 3>&-; exec "$@"' rdy <target...>

It forks that command into its OWN process group and watches the
orchestrator-liveness ("death") pipe. When the orchestrator dies, every
copy of the death-pipe write end closes, the outer shim reads EOF and
SIGKILLs the sandbox process group (replacing the Linux pid-ns cascade
with an explicit killpg — the outer shim has signal rights because it runs
OUTSIDE the seatbelt profile). It also wires the status-pipe write end to
fd 3 in the child before exec, so the in-sandbox /bin/sh trampoline can
write the readiness byte through it.

The INNER trampoline is `/bin/sh` (constructed by _macos_spawn), NOT this
shim: it writes one readiness byte to fd 3 (proving the profile applied —
sh ran inside it), closes fd 3 (`exec 3>&-`, so the untrusted target never
inherits the status pipe), then execs the target. /bin/sh is chosen
because its startup dependencies (exec /bin/sh + libSystem + the dyld
shared cache) are a strict SUBSET of any dynamically-linked target's — so
"no readiness byte" can only mean the profile cannot run the target
either, i.e. a genuine setup failure. (The profile is pinned to always
permit /bin/sh; see seatbelt.build_profile.) A python trampoline would add
stdlib-read dependencies the target lacks, creating a false-failure mode
under restrict_reads.

This is the macOS analogue of the `_spawn.py` exec-status pipe (the
Linux fork-backend path).
"""

from __future__ import annotations

import faulthandler
import signal
import sys

faulthandler.enable()
if hasattr(signal, "SIGUSR1"):
    faulthandler.register(signal.SIGUSR1, all_threads=True, file=sys.stderr)

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

# Fixed fd the in-sandbox /bin/sh trampoline writes the readiness byte to.
# The outer shim dup2's the status pipe onto this fd (inheritable) in the
# child before exec, so it survives sandbox-exec's exec into /bin/sh. Kept
# in sync with the `>&3` in _macos_spawn's trampoline.
_STATUS_CHILD_FD = 3

# Outer-shim exit code when the death pipe goes EOF (orchestrator died) and
# the shim tears the sandbox process group down. Nobody meaningful reaps it
# (the orchestrator is gone); distinct from target codes for log clarity.
_DEATH_TEARDOWN_EXIT = 137

# Outer-shim exit code when a grant-path identity pin stops matching and
# the shim SIGKILLs the sandbox tree (see the pin block below). Distinct
# from the 125/126/127 exec conventions and the death-teardown code.
_PIN_VIOLATION_EXIT = 121

# ─── grant-path identity pins ───────────────────────────────────────
# The spawn side (core/sandbox/_macos_spawn.py) snapshots (dev, ino)
# for every caller-granted path at profile-emission time and hands the
# list here via _RAPTOR_GRANT_PINS (consumed + stripped like the fd
# markers). SBPL grants are path STRINGS: a directory renamed into a
# granted path inherits its grant, and on current macOS even a symlink
# swapped into it routes writes through (both confirmed live) — the
# seatbelt kernel side offers no inode binding, so this watcher
# enforces the pin procedurally: verify in the child right before
# exec, then re-verify every watcher poll tick; on mismatch report
# b"P" on the status pipe and SIGKILL the whole sandbox tree.
# HONEST RESIDUAL, two halves: (a) writes issued between a swap and
# the next poll tick land before the kill (~0.1s cadence; longer only
# while a process-table snapshot stalls the loop); (b) detection needs
# the swap to PERSIST across a tick — an unsandboxed same-UID
# accomplice that swaps and restores within one tick lands its window
# of writes and the run returns clean (outside this sandbox's threat
# boundary; documented, not defended).
# The hardened profiles' `(deny signal (target others))` keeps the
# sandboxed target from killing THIS watcher to suppress the check.
# Keep the mismatch semantics in sync with _macos_spawn's
# _grant_pin_mismatch (this shim runs `python -I` with no repo on
# sys.path and cannot import it).


def _resolve_grant_pins():
    """[(path, dev, ino), ...] from _RAPTOR_GRANT_PINS, else []."""
    raw = os.environ.get("_RAPTOR_GRANT_PINS")
    if not raw:
        return []
    import json
    try:
        pins = json.loads(raw)
    except ValueError:
        return []
    out = []
    if isinstance(pins, list):
        for p in pins:
            if (isinstance(p, dict)
                    and isinstance(p.get("path"), str)
                    and isinstance(p.get("dev"), int)
                    and isinstance(p.get("ino"), int)):
                out.append((p["path"], p["dev"], p["ino"]))
    return out


def _pin_violation(pins):
    """First (path, reason) whose pinned identity no longer holds, or
    None. One lstat decides all three tamper shapes: vanished path,
    symlink now at the path (catches a relocate-and-link-back to the
    original inode too), different object renamed in (dev/ino)."""
    import stat as _stat
    for path, dev, ino in pins:
        try:
            st = os.lstat(path)
        except OSError:
            return (path, "no longer exists")
        if _stat.S_ISLNK(st.st_mode):
            return (path, "is now a symlink")
        if (st.st_dev, st.st_ino) != (dev, ino):
            return (path, "changed identity (dev/ino)")
    return None
# ─── end grant-path identity pins ───────────────────────────────────

# ─── post-exit descendant sweep ─────────────────────────────────────
# The killpg-based teardown only reaches processes that stayed in the
# sandbox process group; the allow-default seatbelt profile does not
# deny setsid, so a fork+setsid descendant leaves the group and — with
# no pid-namespace cascade on macOS — survived normal completion
# outright. The sweep walks the process table (`ps -axo pid,ppid,pgid`;
# macOS has no /proc) from THIS shim, collects descendants transitively
# via the ppid chain (setsid changes pgid/session, not ppid) plus any
# member of the sandbox process group, and SIGKILLs them on every exit
# path.
#
# This is an inline copy of core/sandbox/_macos_spawn.py's sweep (keep
# in sync): the shim runs `python -I` with no repo on sys.path and
# cannot import it.
#
# Known blind spot, by construction: a descendant whose intermediate
# ancestors already exited reparents to launchd (ppid 1) and a fresh
# snapshot can no longer attribute it. The watcher loop therefore keeps
# a CUMULATIVE lineage ledger across its periodic snapshots (every
# _SNAPSHOT_INTERVAL_S): every descendant ever attributed stays known
# after it reparents (pre-ledger, only the LATEST table fed the sweep,
# so an early-seen descendant whose link had broken by the final
# snapshot was forgotten), and every attributed pid is also kept as a
# CANDIDATE PROCESS GROUP — a descendant that calls setsid leads a new
# group whose pgid equals its own pid, so children it forks after the
# setsid (the classic double-fork daemoniser) attribute through the
# group id even once the intermediate is dead, provided any snapshot
# saw the intermediate alive. Residual, documented not hidden: a
# double-fork daemoniser whose intermediate is born, forks, and dies
# entirely BETWEEN two snapshot ticks leaves a survivor no ps-polling
# design can attribute (the intermediate's pid — the only link — was
# never observed); the ledger narrows the window to one snapshot
# interval, it cannot close it. Such a survivor remains INSIDE the
# seatbelt profile (sandbox state is inherited across fork/setsid), so
# confinement holds; the leak is a resource/persistence residual.
# Pid-reuse note for the candidate groups: an unrelated process could
# only match a dead descendant's group by recycling that exact pid AND
# calling setsid within the run — the same accepted theoretical class
# as the recycled-group-leader window below (sequential pid
# allocation).
#
# launchd-submitted jobs are OUTSIDE this universe by construction:
# they are children of launchd, never of this shim, so no ppid/pgid
# walk can attribute them. The hardened profiles close the submission
# vector itself (mach-lookup allowlist-deny — launchctl cannot reach
# launchd from inside the sandbox); no sweep-side backstop is
# attempted because label enumeration cannot be attributed to this
# run safely.

# Absolute paths only: ps output drives the descendant-collection →
# SIGKILL list, and this watcher runs UNsandboxed — a PATH-resolved
# `ps` could fabricate a table attributing arbitrary same-UID pids to
# the sandbox tree. macOS ships /bin/ps; /usr/bin/ps covers other
# layouts. No bare fallback.
_PS_CANDIDATES = ("/bin/ps", "/usr/bin/ps")
_PS_ARGS = ["-axo", "pid=,ppid=,pgid="]
_SWEEP_MAX_PASSES = 3
_SNAPSHOT_INTERVAL_S = 0.5


def _parse_ps_table(text):
    """`ps -axo pid=,ppid=,pgid=` output → (pid, ppid, pgid) int
    tuples. Unparseable lines are skipped — the sweep is best-effort."""
    table = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        try:
            table.append((int(parts[0]), int(parts[1]), int(parts[2])))
        except ValueError:
            continue
    return table


def _collect_descendants(table, root_pid, extra_pgids=(), protect=()):
    """Pure kill-list derivation: (pid, ppid, pgid) table in → pid set
    out. Transitive ppid closure from root_pid, plus members of
    extra_pgids (and their ppid-descendants). Never returns root_pid,
    pids <= 1, anything in protect, or processes with no ancestry/group
    link to the root. Each pid is visited at most once, so a
    cyclic/garbage table cannot hang the walk."""
    kids = {}
    pgid_members = {}
    for pid, ppid, pgid in table:
        kids.setdefault(ppid, []).append(pid)
        pgid_members.setdefault(pgid, []).append(pid)
    out = set()
    visited = {root_pid}
    stack = [root_pid]
    for pg in extra_pgids:
        for pid in pgid_members.get(pg, ()):
            if pid not in visited:
                visited.add(pid)
                out.add(pid)
                stack.append(pid)
    while stack:
        cur = stack.pop()
        for child in kids.get(cur, ()):
            if child in visited:
                continue
            visited.add(child)
            out.add(child)
            stack.append(child)
    banned = set(protect)
    banned.add(root_pid)
    return {p for p in out if p > 1 and p not in banned}


def _ps_snapshot():
    """(pid, ppid, pgid) table from ps, or None when unavailable."""
    import subprocess
    for ps in _PS_CANDIDATES:
        try:
            proc = subprocess.run(
                [ps] + _PS_ARGS, capture_output=True, text=True,
                timeout=10, check=False,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        if proc.returncode == 0:
            return _parse_ps_table(proc.stdout)
    return None


def _kill_pid(pid):
    """SIGKILL one pid, best-effort. Module-level for hermetic tests."""
    try:
        os.kill(pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass


def _sweep_orphans(child_pid, live_table, snapshot_fn=None,
                   kill_fn=None, max_passes=_SWEEP_MAX_PASSES,
                   known_pids=None, extra_pgids=()):
    """SIGKILL every process still attributable to this shim's tree,
    independent of process group. Best-effort, bounded to max_passes
    snapshot+kill rounds (later rounds catch children forked while an
    earlier round was killing).

    ``live_table`` is the watcher loop's latest while-alive snapshot:
    descendants recorded there are still killed after reparenting to
    launchd, provided they still exist AND still carry the pgid the
    snapshot saw (cheap pid-reuse guard — a recycled pid lands in a
    different process group). ``known_pids`` (pid -> last-seen pgid)
    is the watcher's CUMULATIVE lineage ledger — same guard semantics,
    but spanning every snapshot of the run, not just the last one.
    ``extra_pgids`` are candidate sandbox-owned process groups beyond
    the direct child's (each attributed descendant's pid: its group if
    it setsid'd) — members attribute through the group id even when
    the group leader is already dead. Returns the swept pid set.

    The attribution walk is rooted at the SANDBOX LEADER (child_pid),
    never at this shim: the shim's only other children are its own
    transient `ps` snapshot helpers, which list themselves in the very
    table they produce — rooting at the shim would attribute them,
    feed their pids into the cumulative ledger as candidate process
    groups, and turn recycled pids into false-kill candidates for the
    operator's unrelated processes. Nothing legitimate ever reparents
    TO the shim (macOS has no subreaper), so rooting at the leader
    loses no real descendant.
    """
    snapshot_fn = snapshot_fn or _ps_snapshot
    kill_fn = kill_fn or _kill_pid
    self_pid = os.getpid()
    protect = {self_pid, os.getppid()}
    sandbox_pgids = (child_pid, *tuple(extra_pgids))
    # The sandbox process group itself first — normal completion never
    # ran the death-pipe killpg, so group members with dead parents
    # (in-group orphans) are reaped here. Best-effort; a same-pid
    # recycled group leader within the reap-to-sweep window is a
    # theoretical (sequential pid allocation) mis-kill we accept.
    try:
        os.killpg(child_pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
    known = dict(known_pids or {})
    if live_table:
        live_pgids = {pid: pgid for pid, _ppid, pgid in live_table}
        for pid in _collect_descendants(
                live_table, child_pid,
                extra_pgids=sandbox_pgids, protect=protect):
            known[pid] = live_pgids.get(pid)
    swept = set()
    for _ in range(max_passes):
        table = snapshot_fn()
        if not table:
            break
        current_pgid = {pid: pgid for pid, _ppid, pgid in table}
        targets = _collect_descendants(
            table, child_pid, extra_pgids=sandbox_pgids, protect=protect)
        for pid, seen_pgid in known.items():
            if (pid not in targets and pid in current_pgid
                    and current_pgid[pid] == seen_pgid):
                targets.add(pid)
        targets = {p for p in targets if p > 1 and p not in protect}
        if not targets:
            break
        for pid in sorted(targets):
            kill_fn(pid)
        for pid in targets:
            known.setdefault(pid, current_pgid.get(pid))
        swept |= targets
    if swept:
        sys.stderr.write(
            "raptor-seatbelt-shim: post-exit sweep SIGKILLed "
            f"{len(swept)} orphaned sandbox descendant(s)\n"
        )
    return swept
# ─── end post-exit descendant sweep ─────────────────────────────────


def _resolve_death_fd():
    """Resolve the orchestrator-liveness ("death") pipe read-end fd, or None.

    Validated via fstat; set non-blocking so the post-select read can never
    stall the shim. This fd is held ONLY by the outer shim (never crosses
    into the sandbox) and carries no data — it is a one-bit liveness signal.
    """
    raw = os.environ.get("_RAPTOR_DEATH_FD")
    if not raw:
        return None
    try:
        fd = int(raw)
        os.fstat(fd)
    except (ValueError, OSError):
        return None
    try:
        os.set_blocking(fd, False)
    except OSError:
        return None
    return fd


def _resolve_status_fd():
    """Resolve the status pipe write-end fd (a plain int), or None."""
    raw = os.environ.get("_RAPTOR_STATUS_FD")
    if not raw:
        return None
    try:
        fd = int(raw)
        os.fstat(fd)
    except (ValueError, OSError):
        return None
    return fd


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        sys.stderr.write("raptor-seatbelt-shim: missing sandbox-exec argv\n")
        return 2

    # --keep-trust-markers (from the spawn side ONLY): keep the trust
    # markers in the target env — the keep-trust dispatch contract.
    # run_untrusted_networked(keep_trust_markers=True) — the
    # sole sanctioned keep-trust minting site, used for RAPTOR's own
    # claude -p skill dispatches — needs the dispatched child to keep
    # _RAPTOR_TRUSTED/CLAUDECODE so it can drive libexec/ helpers past
    # their inline trust gates. Out-of-band by design: an env-based
    # keep flag could be smuggled in any caller-supplied env dict; an
    # argv flag can only come from the code that builds this command
    # line.
    keep_trust_markers = False
    if argv[0] == "--keep-trust-markers":
        argv = argv[1:]
        keep_trust_markers = True
        if not argv:
            sys.stderr.write(
                "raptor-seatbelt-shim: missing sandbox-exec argv after "
                "--keep-trust-markers\n"
            )
            return 2

    death_fd = _resolve_death_fd()
    status_fd = _resolve_status_fd()
    grant_pins = _resolve_grant_pins()

    # Forward common termination signals to the child group rather than
    # dying and orphaning it.
    child_holder = {}

    def _forward(sig, _frame):
        pid = child_holder.get("pid")
        if pid:
            try:
                os.killpg(pid, sig)
            except (ProcessLookupError, OSError):
                try:
                    os.kill(pid, sig)
                except (ProcessLookupError, OSError):
                    pass

    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT):
        try:
            signal.signal(s, _forward)
        except (OSError, ValueError):
            pass

    child = os.fork()
    if child == 0:
        # Child: become a NEW process-group leader so the outer shim can
        # killpg the whole sandbox subtree in one shot. Close the death fd
        # first (the child never watches it; closing first also frees the
        # number in case it collided with _STATUS_CHILD_FD). Then place the
        # status write end on the fixed fd the /bin/sh trampoline writes to,
        # inheritable so it survives sandbox-exec's exec, and drop the
        # original number so the untrusted target can't inherit it.
        if death_fd is not None:
            try:
                os.close(death_fd)
            except OSError:
                pass
        if status_fd is not None:
            try:
                if status_fd != _STATUS_CHILD_FD:
                    os.dup2(status_fd, _STATUS_CHILD_FD, inheritable=True)
                    os.close(status_fd)
                else:
                    os.set_inheritable(_STATUS_CHILD_FD, True)
            except OSError:
                pass
        try:
            os.setpgid(0, 0)
        except OSError:
            pass
        # Strip RAPTOR-internal markers so NOTHING crosses into the sandbox.
        # The trust marker authorizes THIS (unsandboxed) dispatch shim only —
        # it must not be visible to the sandboxed target. The fd markers are
        # already consumed (death fd closed above; status fd dup'd onto fd 3)
        # and are stripped unconditionally. Popping here means sandbox-exec
        # -> /bin/sh -> target inherit a clean env with no _RAPTOR_* names.
        #
        # The legacy env-based keep flag is stripped unconditionally and
        # never trusted — the keep decision arrives via the argv flag,
        # which only the spawn side can set.
        os.environ.pop("_RAPTOR_KEEP_TRUST_MARKERS", None)
        # Grant pins: consumed by this shim (child pre-exec check here,
        # watcher polling in the parent branch) — never visible to the
        # sandboxed target.
        os.environ.pop("_RAPTOR_GRANT_PINS", None)
        # Last check before handing the granted paths a live sandbox:
        # a swap in the spawn→exec window must abort the run, not run
        # the target against a retargeted grant. Report P on the
        # status pipe (already dup2'd onto the fixed fd above) so the
        # orchestrator raises instead of reading rc 121 as a target
        # exit.
        if grant_pins:
            _bad = _pin_violation(grant_pins)
            if _bad is not None:
                # The status pipe sits on the fixed fd only when the
                # spawn side wired one — never write to a bare fd 3.
                if status_fd is not None:
                    try:
                        os.write(_STATUS_CHILD_FD, b"P")
                    except OSError:
                        pass
                sys.stderr.write(
                    f"raptor-seatbelt-shim: grant-path pin violated "
                    f"before exec: {_bad[0]} {_bad[1]}\n"
                )
                os._exit(_PIN_VIOLATION_EXIT)
        # Keep this tuple in sync with core.config's TARGET_ENV_STRIP_SET
        # (this shim runs `python -I` with no repo on sys.path and cannot
        # import core): trust markers, the
        # session credential, and the framework-identity tells (checkout
        # path, output layout, target-kind override — pure "inside
        # RAPTOR" fingerprints no target legitimately consumes) never
        # reach target code. The keep-trust dispatch arm keeps the
        # markers and credential by design so RAPTOR's own dispatched
        # children can drive libexec helpers.
        _strip = (
            ("_RAPTOR_STATUS_FD", "_RAPTOR_DEATH_FD") if keep_trust_markers
            else ("_RAPTOR_STATUS_FD", "_RAPTOR_DEATH_FD",
                  "_RAPTOR_TRUSTED", "CLAUDECODE",
                  "RAPTOR_SESSION_PID", "RAPTOR_SESSION_TOKEN",
                  "RAPTOR_ALLOW_DEGRADED_UNTRUSTED",
                  "RAPTOR_DIR", "RAPTOR_OUT_DIR", "RAPTOR_TARGET_KIND",
                  "RAPTOR_SCORECARD_PATH",
                  "RAPTOR_SANITIZER_CUT", "RAPTOR_SANITIZER_CUT_NO_LEXICAL",
                  "RAPTOR_SANITIZER_CUT_PARITY_LOG",
                  "RAPTOR_SANITIZER_CUT_AUDIT_DIR")
        )
        for _m in _strip:
            os.environ.pop(_m, None)
        # Re-apply quarantined loader variables (LD_*/DYLD_*) for the
        # sandboxed target only. The spawn side moved them out of this
        # shim's live env (an unsandboxed trusted dispatcher) into the
        # JSON payload; the exec below is where the caller intended
        # them to apply. SIP behaviour across sandbox-exec is
        # unchanged either way.
        _restore_raw = os.environ.pop("_RAPTOR_ENV_RESTORE", None)
        if _restore_raw:
            import json as _json
            try:
                _restore = _json.loads(_restore_raw)
            except ValueError:
                _restore = None
            if isinstance(_restore, dict):
                for _rk, _rv in _restore.items():
                    if isinstance(_rk, str) and isinstance(_rv, str) \
                            and (_rk.startswith(("LD_", "DYLD_"))
                                 or _rk in ("GCONV_PATH",
                                            "GLIBC_TUNABLES")):
                        os.environ[_rk] = _rv
        try:
            os.execvp(argv[0], argv)
        except FileNotFoundError:
            os._exit(127)
        except PermissionError:
            os._exit(126)
        os._exit(125)

    child_holder["pid"] = child
    # The watcher KEEPS its status write end: it is the reporting
    # channel for the sandbox-group pid (G, below) and grant-pin
    # violations (P). EOF promptness for the orchestrator is
    # unchanged — it drains the pipe only after this shim exits (its
    # communicate() waits on us), at which point every write-end copy
    # is closed.
    # Mirror the child into its own pgrp from the parent side too, to close
    # the fork→setpgid race (whichever wins, the child leads group == child).
    try:
        os.setpgid(child, child)
    except OSError:
        pass
    # Report the sandbox process-group leader to the orchestrator.
    # Written before any target code can run, so a watcher killed
    # later cannot have skipped it: the parent's backstop sweep uses
    # it to killpg-attribute group members after this shim is gone
    # (the ppid walk from a dead shim pid attributes nothing).
    if status_fd is not None:
        try:
            os.write(status_fd, b"G%d\n" % child)
        except OSError:
            pass

    # Latest while-alive process-table snapshot, refreshed by the reap
    # loop below, plus the CUMULATIVE lineage ledger (see the sweep
    # block comment): "pids" maps every descendant ever attributed to
    # its last-seen pgid; "pgids" keeps each attributed pid as a
    # candidate process group (its group if it setsid'd), so a
    # double-fork daemon whose intermediate was seen alive in ANY
    # snapshot stays attributable after the intermediate dies.
    live_holder = {"table": None}
    lineage = {"pids": {}, "pgids": set()}
    _protect = {os.getpid(), os.getppid()}

    def _note_lineage(table):
        # Rooted at the sandbox LEADER, never at this shim: the shim's
        # own transient ps helpers (ppid = shim) list themselves in the
        # very snapshot they produce, and attributing them would feed
        # non-sandbox pids into the cumulative candidate-group set —
        # amplifying recycled-pid false kills over a long run (see
        # _sweep_orphans's rooting note).
        if not table:
            return
        cur = {pid: pgid for pid, _ppid, pgid in table}
        extra = (child, *tuple(lineage["pgids"]))
        for pid in _collect_descendants(
                table, child, extra_pgids=extra, protect=_protect):
            lineage["pids"][pid] = cur.get(pid)
            lineage["pgids"].add(pid)

    def _forced_teardown(exit_code):
        # Snapshot the still-alive tree, SIGKILL the sandbox process
        # group, then the process directly (covers the window before
        # the child's setpgid), reap briefly, sweep the group-escapee
        # descendants, and exit. Shared by the death-pipe teardown
        # (orchestrator gone) and the grant-pin violation teardown.
        try:
            fresh = _ps_snapshot()
        except Exception:
            fresh = None
        try:
            _note_lineage(fresh)
        except Exception:
            pass
        for killer in (lambda: os.killpg(child, signal.SIGKILL),
                       lambda: os.kill(child, signal.SIGKILL)):
            try:
                killer()
            except (ProcessLookupError, OSError):
                pass
        try:
            os.waitpid(child, 0)
        except (ChildProcessError, OSError):
            pass
        try:
            _sweep_orphans(child, fresh or live_holder["table"],
                           known_pids=lineage["pids"],
                           extra_pgids=lineage["pgids"])
        except Exception:
            sys.stderr.write(
                "raptor-seatbelt-shim: teardown descendant sweep failed\n")
        os._exit(exit_code)

    def _teardown_and_exit():
        # Orchestrator gone (death-pipe EOF).
        _forced_teardown(_DEATH_TEARDOWN_EXIT)

    def _pin_teardown_and_exit(bad):
        # A granted path's identity pin stopped matching: report P so
        # the orchestrator raises (never returns this run as genuine),
        # say why on stderr, and take the whole sandbox tree down.
        if status_fd is not None:
            try:
                os.write(status_fd, b"P")
            except OSError:
                pass
        sys.stderr.write(
            f"raptor-seatbelt-shim: grant-path pin violated mid-run: "
            f"{bad[0]} {bad[1]} — SIGKILLing the sandbox tree\n"
        )
        _forced_teardown(_PIN_VIOLATION_EXIT)

    # Unified reap loop (with or without the liveness pipe): 0.1s poll,
    # WNOHANG reap, periodic while-alive snapshot. The pre-fix
    # no-death-fd branch used a blocking waitpid, which could never
    # keep a live snapshot; the poll costs one ps every
    # _SNAPSHOT_INTERVAL_S and preserves the signal-forwarding
    # behaviour (handlers interrupt the sleep/select just as they
    # interrupted the blocking waitpid).
    import time as _time
    if death_fd is not None:
        import select as _select
    status = None
    last_snap = 0.0
    while status is None:
        now = _time.monotonic()
        # Grant-pin re-verify on every poll tick (~0.1s): the bounded
        # residual window between a swap and this check is documented
        # at the pin block above. Runs BEFORE the snapshot (whose ps
        # child can stall up to its timeout) and BEFORE the reap check
        # below, so a violation on the run's last tick still reports P
        # and a slow ps never widens the pin window at tick entry.
        if grant_pins:
            _bad = _pin_violation(grant_pins)
            if _bad is not None:
                _pin_teardown_and_exit(_bad)
        if now - last_snap >= _SNAPSHOT_INTERVAL_S:
            last_snap = now
            try:
                table = _ps_snapshot()
            except Exception:
                table = None
            if table:
                live_holder["table"] = table
                try:
                    _note_lineage(table)
                except Exception:
                    pass
        if death_fd is not None:
            try:
                ready, _, _ = _select.select([death_fd], [], [], 0.1)
            except InterruptedError:
                ready = ()
            if ready:
                try:
                    alive = os.read(death_fd, 256)
                except BlockingIOError:
                    alive = b"x"        # spurious wake, not EOF
                except OSError:
                    alive = b""         # fd error → fail safe to teardown
                if not alive:
                    _teardown_and_exit()
        else:
            try:
                _time.sleep(0.1)
            except InterruptedError:
                pass
        try:
            reaped, st = os.waitpid(child, os.WNOHANG)
        except InterruptedError:
            continue
        except ChildProcessError:
            # The child was already reaped elsewhere — the descendant
            # sweep below must still run (skipping it left fork+setsid
            # orphans alive on exactly this abnormal path).
            status = None
            break
        if reaped == child:
            status = st

    # Post-exit orphan sweep on the NORMAL-completion path: pre-fix,
    # normal completion just reaped the direct child, so a fork+setsid
    # descendant (allow-default seatbelt permits setsid) survived the
    # run outright — outliving the sandbox, the orchestrator, and both
    # killpg teardown groups. Best-effort; never changes the mirrored
    # exit status.
    try:
        _sweep_orphans(child, live_holder["table"],
                       known_pids=lineage["pids"],
                       extra_pgids=lineage["pgids"])
    except Exception:
        sys.stderr.write(
            "raptor-seatbelt-shim: post-exit descendant sweep failed\n")

    if status is None:
        return 254
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 255


if __name__ == "__main__":
    sys.exit(main())
