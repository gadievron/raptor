# ─── cases: boundary cases (kernel / process / network / tool) ─────────

def case_trust_mask_hostile(ctx: Ctx) -> None:
    """Process boundary: the raptor-cc-trust-check CLI contract on a
    hostile repo — blocking verdict via exit code, secrets masked in the
    stdout that lands in retained CI logs, --dry-run / --trust overrides.
    """
    env = ctx.env_t0()
    cc = str(_RAPTOR_DIR / "libexec" / "raptor-cc-trust-check")
    fx = str(ctx.fixture_hostile)
    dry = ctx.run("trust-mask-hostile", [cc, "--dry-run", "--", fx],
                  env=env, timeout=60, check=False)
    assert dry.returncode == 0, f"--dry-run must exit 0 (got {dry.returncode})"
    block = ctx.run("trust-mask-hostile", [cc, "--", fx],
                    env=env, timeout=60, check=False)
    assert block.returncode == 2, (
        f"hostile config must block with exit 2 (got {block.returncode})"
    )
    trust = ctx.run("trust-mask-hostile", [cc, "--trust", "--dry-run", "--", fx],
                    env=env, timeout=60, check=False)
    assert trust.returncode == 0, (
        f"--trust --dry-run must exit 0 (got {trust.returncode})"
    )
    log = ctx.log_text("trust-mask-hostile")
    for needle in ("apiKeyHelper", "env LD_PRELOAD", "SessionStart hook",
                   "stdio server", "url server"):
        assert needle in log, f"trust report missing finding label {needle!r}"
    for secret in ("sk-FAKE", "s3cretFAKE", "collector.invalid/exfil", "user:"):
        assert secret not in log, (
            f"secret leaked into trust-scan output: {secret!r}"
        )
    assert "mcp.invalid/***" in log, "MCP URL not masked to scheme+host"


def case_seccomp_truncation_probe(ctx: Ctx) -> None:
    """Kernel boundary: the seccomp socket-family deny must compare only
    the low 32 bits (MASKED_EQ). The kernel truncates socket()'s family
    arg to int, so a 64-bit-EQ filter lets ``AF_UNIX | 1<<32`` through
    as plain AF_UNIX — the truncation bypass this probe pins closed.
    Runs the adversarial child through the real spawn path
    (libexec/raptor-run-sandboxed → core.sandbox full profile)."""
    env = ctx.env_t0()
    avail = ctx.run("seccomp-truncation-probe", [
        sys.executable, "-c",
        "import sys\n"
        "from core.sandbox.seccomp import check_seccomp_available\n"
        "sys.exit(0 if check_seccomp_available() else 3)",
    ], env=env, timeout=120, check=False)
    if avail.returncode != 0:
        raise Skip("seccomp unavailable on this host")
    rs = str(_RAPTOR_DIR / "libexec" / "raptor-run-sandboxed")
    env["OUTPUT_DIR"] = str(ctx.out_dir("seccomp-probe"))
    control = ctx.run("seccomp-truncation-probe", [rs, "/bin/true"],
                      env=env, timeout=300, check=False)
    assert control.returncode == 0, (
        f"sandbox control run (/bin/true) failed: rc={control.returncode}"
    )
    # argtypes widened to 64-bit: ctypes' default c_int conversion would
    # truncate in USERSPACE and make the probe vacuous — the register
    # must carry the full untruncated value into the syscall for the
    # filter comparison to be exercised.
    probe = (
        "import ctypes, sys\n"
        "libc = ctypes.CDLL(None, use_errno=True)\n"
        "libc.socket.argtypes = [ctypes.c_ulonglong] * 3\n"
        "libc.socket.restype = ctypes.c_int\n"
        "r = libc.socket(int(sys.argv[1]), 1, 0)\n"
        "sys.exit(0 if r < 0 else 42)\n"
    )
    plain = ctx.run("seccomp-truncation-probe",
                    [rs, "python3", "-c", probe, "1"],
                    env=env, timeout=300, check=False)
    assert plain.returncode == 0, (
        f"plain AF_UNIX socket() was not refused (rc={plain.returncode}; "
        f"42 = socket succeeded)"
    )
    trunc = ctx.run("seccomp-truncation-probe",
                    [rs, "python3", "-c", probe, str(1 | (1 << 32))],
                    env=env, timeout=300, check=False)
    assert trunc.returncode == 0, (
        f"truncation bypass OPEN: socket(AF_UNIX | 1<<32) was not refused "
        f"(rc={trunc.returncode}; 42 = socket succeeded)"
    )


_EGRESS_HARNESS = r"""
import os, sys
sys.path.insert(0, os.environ["RAPTOR_DIR"])
from core.sandbox.context import run_untrusted_networked
from core.sandbox.python_paths import python_runtime_tool_paths

out = sys.argv[1]
probe = (
    "import sys, urllib.request\n"
    "try:\n"
    "    urllib.request.urlopen(sys.argv[1], timeout=10)\n"
    "except Exception as e:\n"
    "    m = str(e)\n"
    "    print('PROBE_ERR:', m)\n"
    "    sys.exit(0 if ('403' in m or 'Forbidden' in m) else 43)\n"
    "print('PROBE_OK')\n"
    "sys.exit(42)\n"
)
tool_paths = list(python_runtime_tool_paths())
for host in ("64:ff9b::a9fe:a9fe", "::ffff:169.254.169.254"):
    r = run_untrusted_networked(
        [sys.executable, "-c", probe, f"https://[{host}]/"],
        output=out, proxy_hosts=[host], tool_paths=tool_paths,
        capture_output=True, text=True, timeout=120)
    print(f"probe {host}: rc={r.returncode}")
    print((r.stdout or "") + (r.stderr or ""))
    if r.returncode != 0:
        sys.exit(1)
print("EGRESS_DENY_OK")
"""


def case_egress_embedded_ipv4_deny(ctx: Ctx) -> None:
    """Network boundary: the egress proxy's gate 2 must extract IPv4
    addresses EMBEDDED in IPv6 forms (NAT64 64:ff9b::/96, IPv4-mapped
    ::ffff:) and refuse non-global targets BEFORE dialing. Hermetic: the
    target hosts are allowlisted so gate 1 passes, the literals resolve
    without DNS, and the deny is a policy 403 — no internet required."""
    env = ctx.env_t0()
    avail = ctx.run("egress-embedded-ipv4-deny", [
        sys.executable, "-c",
        "import sys\n"
        "from core.sandbox.probes import check_net_available\n"
        "sys.exit(0 if check_net_available() else 3)",
    ], env=env, timeout=180, check=False)
    if avail.returncode != 0:
        raise Skip("netns/userns network isolation unavailable on this host")
    # Strip operator proxy vars: with an upstream proxy configured the
    # egress proxy tunnels through it (upstream does DNS) and gate 2 is
    # bypassed by design — the direct path is where gate 2 enforces.
    for k in ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
              "http_proxy", "https_proxy", "all_proxy", "no_proxy"):
        env.pop(k, None)
    out = ctx.out_dir("egress-deny")
    proc = ctx.run("egress-embedded-ipv4-deny",
                   [sys.executable, "-c", _EGRESS_HARNESS, str(out)],
                   env=env, timeout=420, check=False)
    log = ctx.log_text("egress-embedded-ipv4-deny")
    assert proc.returncode == 0, (
        f"embedded-IPv4 egress probe not refused with a policy deny "
        f"(rc={proc.returncode}; log tail)\n" + log[-500:]
    )
    assert "EGRESS_DENY_OK" in log
    # Gate-2 deny line — proves a policy refusal, not a timeout.
    assert "resolved to blocked IP" in log, (
        "expected the proxy's gate-2 deny log line"
    )


def case_env_ef_through_scrub(ctx: Ctx) -> None:
    """Process boundary: RAPTOR_EF_* must survive from the operator's
    environment into a real child process (the shape the libexec
    feasibility chain uses) and drive AnalysisConfig.from_env() there,
    while the retired bare RAPTOR_* spellings stay inert.

    Also MEASURES (without failing) whether RaptorConfig.get_safe_env()
    keeps the RAPTOR_EF_ family: today it does not — a feasibility
    config read inside a scrub-spawned child would silently lose the
    operator's knob. Surfaced as a diagnostic line, not an assertion,
    because no production feasibility path currently spawns through the
    scrub; flip to an assertion if one ever does."""
    snippet = (
        "from packages.exploit_feasibility.config import AnalysisConfig\n"
        "c = AnalysisConfig.from_env()\n"
        "d = AnalysisConfig()\n"
        "print('EF_DIRECT', c.timeout_fast, c.verbose)\n"
        "print('EF_DEFAULTS_MATCH', c.timeout_fast == d.timeout_fast, "
        "c.verbose == d.verbose)\n"
    )
    env = ctx.env_t0()
    env.update({"RAPTOR_EF_TIMEOUT_FAST": "7", "RAPTOR_TIMEOUT_FAST": "99",
                "RAPTOR_EF_VERBOSE": "yes", "RAPTOR_VERBOSE": "true"})
    ctx.run("env-ef-through-scrub", [sys.executable, "-c", snippet],
            env=env, timeout=120)
    env_legacy = ctx.env_t0()
    env_legacy.update({"RAPTOR_TIMEOUT_FAST": "99", "RAPTOR_VERBOSE": "true"})
    ctx.run("env-ef-through-scrub", [sys.executable, "-c", snippet],
            env=env_legacy, timeout=120)
    ctx.run("env-ef-through-scrub", [
        sys.executable, "-c",
        "from core.config import RaptorConfig\n"
        "env = RaptorConfig.get_safe_env()\n"
        "print('EF_SCRUB_KEPT', 'RAPTOR_EF_TIMEOUT_FAST' in env)\n",
    ], env=env, timeout=120)
    log = ctx.log_text("env-ef-through-scrub")
    assert "EF_DIRECT 7 True" in log, (
        "RAPTOR_EF_TIMEOUT_FAST/RAPTOR_EF_VERBOSE did not reach the child's "
        "AnalysisConfig.from_env()"
    )
    # Legacy-only child must see pure defaults (not 99 / not flipped).
    assert "EF_DEFAULTS_MATCH True True" in log, (
        "bare RAPTOR_TIMEOUT_FAST/RAPTOR_VERBOSE still drive the EF config"
    )
    if "EF_SCRUB_KEPT True" not in log:
        print("      env-ef-through-scrub: get_safe_env() drops RAPTOR_EF_* "
              "(operator knob would be lost across scrub-spawned children)")


