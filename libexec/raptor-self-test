def case_sca_render_gate(ctx: Ctx) -> None:
    src = ctx.artifacts.get("sca_findings")
    if src is None:
        raise Skip("sca scan case did not run")
    # The fixture produces medium hygiene findings: the CI gate must
    # pass at a higher threshold and trip at a lower one.
    hi = ctx.run("sca-render-gate", [
        sys.executable, "raptor.py", "sca", "render", str(src),
        "--fail-on-hygiene", "critical",
    ], env=ctx.env_t0(), timeout=120, check=False)
    lo = ctx.run("sca-render-gate", [
        sys.executable, "raptor.py", "sca", "render", str(src),
        "--fail-on-hygiene", "low",
    ], env=ctx.env_t0(), timeout=120, check=False)
    assert hi.returncode == 0, "gate tripped with no critical findings"
    assert lo.returncode != 0, "gate failed to trip on medium findings"


