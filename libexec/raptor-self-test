        "pipeline proceeded past language detection on a manifest-only repo"
    )
    assert proc.returncode == 1, (
        f"documented failure exit is 1 (got {proc.returncode})"
    )


def case_sbom_license_shape(ctx: Ctx) -> None:
    """Entry-point→filesystem boundary: the real sca CLI run must thread
    the project's manifest-declared license (MIT in the fixture's
    package.json) through the pipeline into the CycloneDX SBOM's
    metadata.component, and produce the SPDX SBOM when --spdx is passed.
    Document-shape details (dep entries never carry the project license,
    DESCRIBES relationships) are unit-tested; this case only proves the
    thread-through across the CLI. Isolated HOME + --offline keep the
    run hermetic (no registry license data can appear)."""
    out = ctx.out_dir("sbom")
    ctx.run("sbom-license-shape", [
        sys.executable, "raptor.py", "sca", str(ctx.fixture_sca),
        "--out", str(out), "--offline", "--no-llm", "--no-progress",
        "--no-resolve-transitive", "--spdx", "--html",
    ], env=ctx.env_t0(isolated_home=True), timeout=600, check=False)
    cdx_files = list(out.rglob("sbom.cdx.json"))
    assert cdx_files, f"no sbom.cdx.json under {out}"
    cdx = json.loads(cdx_files[0].read_text())
    licenses = cdx.get("metadata", {}).get("component", {}).get("licenses")
    assert licenses, "project license missing from metadata.component"
    assert "MIT" in json.dumps(licenses), (
        f"expected MIT in metadata.component.licenses, got {licenses!r}"
    )
    spdx_files = list(out.rglob("sbom.spdx.json"))
    assert spdx_files, f"--spdx did not produce sbom.spdx.json under {out}"


def case_ci_gates(ctx: Ctx) -> None:
    """Process boundary: every CI gate runs clean against this checkout
    — env docs, vocab lists, command metadata, miswiring/dead-code scan,
    prompt-envelope audit. A wrong baseline edit fails here, not in
    unit tests."""
    env = ctx.env_t0()
    gates = [
        [sys.executable, ".github/scripts/check_env_docs.py"],
        [sys.executable, ".github/scripts/check_vocab_lists.py"],
        [sys.executable, ".github/scripts/check_command_metadata.py"],
        [sys.executable, ".github/scripts/check_miswiring.py"],
