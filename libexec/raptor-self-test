    ]
    for argv in gates:
        ctx.run("ci-gates", argv, env=env, cwd=_RAPTOR_DIR, timeout=600)


# libexec scripts that legitimately have no --help. Each entry was
# classified by reading the script; the case still runs them with
# --help and asserts no Python traceback (import rot still surfaces).
_ALLOW_NO_HELP = {
    # exec-only wrappers: argv IS the command to run
    "raptor-pid1-shim": "pid-1 reaper shim; execs its argv verbatim",
    "raptor-seatbelt-shim": "macOS sandbox-exec watcher; execs its argv",
    # bash gates / installers with usage-on-misuse only
    "raptor-cc-trust-check": "trust gate; usage on unknown flag, exit 3",
    "raptor-sage-setup": "installer; usage on unknown flag, exit 3; "
                         "--help exits 0",
    # positional-only CLIs that print usage (or a clear error) on misuse
    "raptor-clone-repo": "usage on missing positionals, exit 2",
    "raptor-fetch-attachment": "usage on missing positionals, exit 2",
    "raptor-lifecycle-hook": "prints action list on unknown action",
    "raptor-run-feasibility": "usage on missing positionals, exit 1",
    "raptor-run-lifecycle": "prints action list on unknown action",
    "raptor-validate-schema": "usage + type list on misuse, exit 3",
    "raptor-validation-helper": "stage usage on unknown stage, exit 1",
    "raptor-enrich-context-map-taint": "positional workdir; errors on "
                                       "missing context-map.json",
    "raptor-normalize-context-map": "positional dir; errors on non-dir arg",
    "raptor-render-diagrams": "positional out-dir; errors on missing dir",
    "raptor-r2-sandboxed": "refuses short argv by design (exit 100)",
    # silent-by-design helpers
    "raptor-enrich-context-map-frida": "no-ops silently without frida "
                                       "evidence in the workdir",
    "raptor-startup-check": "pre-launch hook; ignores args, exits 0",
}

def _raptor_py_modes() -> list:
    """Full raptor.py mode list, derived from raptor.py's own registry
    (mirrors show_mode_help's mode-set union) so a newly added mode is
    covered automatically instead of silently missing from the sweep."""
    import raptor
    handler_only_modes = {"describe", "doctor", "sca", "frida"}
    return sorted(set(raptor._mode_help_scripts()) | handler_only_modes)


def case_cli_help_surface(ctx: Ctx) -> None:
    """Process boundary: every executable libexec/raptor-* script plus
    raptor.py and each of its modes answers --help without argparse or
    import rot. Conventional CLIs must exit 0 with usage text; the
    _ALLOW_NO_HELP set (classified per script) is only required not to
    traceback."""
    env = ctx.env_t0()
    failures, lines = [], []
    scripts = sorted(
        p for p in (_RAPTOR_DIR / "libexec").iterdir()
        if p.is_file() and p.name.startswith("raptor-")
        and os.access(p, os.X_OK)
    )
    targets = [([str(p)], p.name) for p in scripts]
    for mode in [None, *_raptor_py_modes()]:
        argv = [sys.executable, str(_RAPTOR_DIR / "raptor.py")]
        if mode:
            argv.append(mode)
        targets.append((argv, f"raptor.py {mode or ''}".strip()))
    for argv, name in targets:
        try:
            proc = subprocess.run(
                argv + ["--help"], env=env, cwd=str(_RAPTOR_DIR),
                capture_output=True, text=True, timeout=120, check=False,
            )
            out = (proc.stdout or "") + (proc.stderr or "")
            rc: int | str = proc.returncode
        except subprocess.TimeoutExpired:
            out, rc = "", "timeout"
        base = name.split("/")[-1]
        lines.append(f"{name}: rc={rc} bytes={len(out)}")
        if "Traceback (most recent call last)" in out or rc == "timeout":
            failures.append(f"{name}: rc={rc} {out[-200:]!r}")
        elif base not in _ALLOW_NO_HELP and (rc != 0 or len(out) < 10):
            failures.append(f"{name}: rc={rc} bytes={len(out)}")
    ctx.append_log("cli-help-surface", "\n".join(lines) + "\n")
    assert not failures, (
        f"{len(failures)} CLI surface(s) broken on --help: "
        + " | ".join(failures[:5])
    )


def _write_stub_sarif(path: Path) -> Path:
    """Minimal one-finding SARIF for agentic --sarif entries when the
    scan case's artifact isn't available (e.g. --only flag-matrix)."""
    path.write_text(json.dumps({
        "version": "2.1.0",
        "runs": [{
            "tool": {"driver": {"name": "raptor-self-test",
                                "rules": [{"id": "st-cmd-injection"}]}},
            "results": [{
                "ruleId": "st-cmd-injection", "level": "error",
                "message": {"text": "command injection (fixture)"},
                "locations": [{"physicalLocation": {
                    "artifactLocation": {"uri": "app.py"},
                    "region": {"startLine": 13},
                }}],
            }],
        }],
    }))
    return path


def case_flag_matrix(ctx: Ctx) -> None:
    """Entry-point boundary: cheap, safe flag combinations actually
    executed against the fixtures (not just --help), each pinned by exit
    code plus a per-entry marker. Every listed flag was verified against
    the target's parser before inclusion.

    Dropped from the requested table (flag absent on the target parser):
      * ``doctor --json`` — doctor accepts only --strict / --verbose
      * ``sca render --html`` — --html is a scan-mode flag (exercised by
        the sbom-license-shape case); the render subcommand has no such
        flag
      * ``raptor-review list`` — no ``list`` subcommand; the review
        surface is covered by review-empty-graceful / review-notes
    """
    env = ctx.env_t0()
    base = ctx.out_dir("flag-matrix")
    # Always the single-finding stub — NOT the scan case's real SARIF:
    # these entries pin flag plumbing, and a deterministic one-finding
    # input keeps each agentic run time-bounded (the real-SARIF import
    # path is covered by agentic-sarif-import). Stem + suffix: fixture
    # input, not a production artifact (miswiring detector hygiene).
    sarif = _write_stub_sarif(base / ("stub" + ".sarif"))
    fx = str(ctx.fixture)
    agentic_common = [
        sys.executable, "raptor.py", "agentic", "--repo", fx,
        "--sarif", str(sarif), "--skip-dedup",
        "--no-exploits", "--no-patches",
    ]
    # (name, argv, ok_rcs, substring-in-log | None, produced-file | None,
    #  isolated_home, timeout)
    entries: list[tuple] = [
        ("scan-policy-out",
         [sys.executable, "raptor.py", "scan", "--repo", fx,
          "--out", str(base / "scan"), "--policy-groups", "secrets",
          "--no-codeql", "--no-cocci"],
         (0,), None, base / "scan" / "combined.sarif", False, 600),
        ("agentic-sequential",
         [*agentic_common, "--out", str(base / "ag-seq"), "--sequential"],
         (0,), "sequential-mode", None, False, 600),
        ("agentic-no-binary-oracle",
         [*agentic_common, "--out", str(base / "ag-nbo"),
          "--no-binary-oracle"],
         (0,), None, base / "ag-nbo" / "raptor_agentic_report.json",
         False, 600),
        ("fuzz-export-seed-corpus",
         [sys.executable, "raptor.py", "fuzz",
          "--export-seed-corpus", str(base / "seeds")],
         (0,), None, base / "seeds" / "manifest.json", False, 300),
        ("describe-json",
         [sys.executable, "raptor.py", "describe", "--target", fx, "--json"],
         (0,), '"target_path"', None, False, 300),
        ("coverage-detailed",
         [str(_RAPTOR_DIR / "libexec" / "raptor-coverage-summary"),
          "--detailed"],
         (0,), None, None, True, 60),
        ("coverage-gaps",
         [str(_RAPTOR_DIR / "libexec" / "raptor-coverage-summary"),
          "--gaps"],
         (0,), None, None, True, 60),
    ]
    if ctx.fixture_bin is not None:
        entries.insert(3, (
            "agentic-binary-auto",
            [*agentic_common, "--out", str(base / "ag-auto"),
             "--binary-auto"],
            (0,), "binary-oracle: auto-detected", None, False, 600))
    failures = []
    for name, argv, ok_rcs, needle, artifact, iso_home, timeout in entries:
        log_name = f"flag-matrix-{name}"
        e = ctx.env_t0(isolated_home=True) if iso_home else env
        proc = ctx.run(log_name, argv, env=e, timeout=timeout, check=False)
        log = ctx.log_text(log_name)
        if proc.returncode not in ok_rcs:
            failures.append(f"{name}: rc={proc.returncode}")
        elif needle and needle not in log:
            failures.append(f"{name}: marker {needle!r} missing")
        elif artifact and not artifact.is_file():
            failures.append(f"{name}: expected artifact missing {artifact}")
        # --no-binary-oracle must actually suppress the auto-detect banner.
        if (name == "agentic-no-binary-oracle"
                and "binary-oracle: auto-detected" in log):
            failures.append(f"{name}: auto-detect still ran")
    # Seed-corpus manifest crossed raptor.py → pipeline → disk: paths
    # must be portable (repo-relative source_manifest, no checkout
    # absolute path outside the legitimately-absolute out_dir).
    manifest_path = base / "seeds" / "manifest.json"
    if manifest_path.is_file():
        manifest = json.loads(manifest_path.read_text())
        if manifest.get("source_manifest") != \
                "packages/fuzzing/data/seed_corpus/manifest.json":
            failures.append(
                f"fuzz-export-seed-corpus: source_manifest not "
                f"repo-relative: {manifest.get('source_manifest')!r}")
        rest = json.dumps({k: v for k, v in manifest.items()
                           if k != "out_dir"})
        if str(_RAPTOR_DIR) in rest:
            failures.append(
                "fuzz-export-seed-corpus: checkout absolute path leaked "
                "into manifest outside out_dir")
    assert not failures, (
        f"{len(failures)} flag-matrix entr(ies) failed: "
        + " | ".join(failures)
    )


def case_no_secret_leakage(ctx: Ctx) -> None:
    """Filesystem boundary: after every earlier pipeline run, none of
    the hostile fixture's planted markers may appear anywhere under the
    shared outputs tree — proves no pipeline copied hostile config
    content into its artifacts. Must stay registered LAST in tier 0."""
    markers = (b"sk-FAKE", b"s3cretFAKE", b"collector.invalid")
    hits = []
    for root, _dirs, files in os.walk(ctx.outs):
        for fn in files:
            p = Path(root) / fn
            try:
                if p.is_symlink() or p.stat().st_size > 50_000_000:
                    continue
                data = p.read_bytes()
            except OSError:
                continue
            for m in markers:
                if m in data:
                    hits.append(f"{p}: {m.decode()}")
    assert not hits, (
        f"hostile fixture secrets leaked into outputs: {hits[:5]}"
    )


# ─── cases: tier 1 (LLM, budget-capped) ─────────────────────────────────

def _llm_model_args(ctx: Ctx) -> list[str]:
    return ["--model", ctx.args.model] if ctx.args.model else []


def case_llm_ask(ctx: Ctx) -> None:
    model = ctx.args.model
    if not model:
        # raptor-llm-ask requires --model; only the configured default
        # is guaranteed reachable, so resolve it the same way the
        # audit dispatcher does.
        proc = subprocess.run(
            [str(_RAPTOR_DIR / "libexec" / "raptor-resolve-mode")],
            env=ctx.env_llm(), capture_output=True, text=True, timeout=60,
            check=False,
        )
        parts = (proc.stdout or "").split()
        if len(parts) < 2 or parts[0] != "orchestrator":
            raise Skip("no orchestrator model resolved on this host")
        model = parts[1].split("/", 1)[-1]
    argv = [str(_RAPTOR_DIR / "libexec" / "raptor-llm-ask"),
            "--model", model,
            "Reply with exactly the word: pong"]
    ctx.run("llm-ask", argv, env=ctx.env_llm(), timeout=180)


def case_audit_llm(ctx: Ctx) -> None:
    out = ctx.out_dir("audit-llm")
    cmap = dict(_CONTEXT_MAP)
    cmap["target"] = str(ctx.fixture)
    (out / "context-map.json").write_text(json.dumps(cmap, indent=2))
    cap = min(0.50, ctx.args.max_llm_cost)
    ctx.run("audit-llm", [
        str(_RAPTOR_DIR / "libexec" / "raptor-audit"), "run",
        str(ctx.fixture), "--out", str(out),
        "--budget", "2", "--max-cost", f"{cap:.2f}",
        "--max-time", "600", "--no-validate", "--schedule", "priority",
        "--scope", "app.py", *_llm_model_args(ctx),
    ], env=ctx.env_llm(), timeout=900)
    journal = out / "review-journal.jsonl"
    assert journal.is_file(), "audit produced no review journal"
    ctx.run("audit-llm", [
        str(_RAPTOR_DIR / "libexec" / "raptor-review"),
        "--out", str(out), "stats",
    ], env=ctx.env_llm(), timeout=60, check=False)


def case_agentic_llm(ctx: Ctx) -> None:
    _require("semgrep")
    out = ctx.out_dir("agentic-llm")
    cap = min(1.00, ctx.args.max_llm_cost)
    ctx.run("agentic-llm", [
        sys.executable, "raptor.py", "agentic",
        "--repo", str(ctx.fixture), "--out", str(out),
        "--no-codeql", "--max-findings", "2",
        "--max-cost-usd", f"{cap:.2f}",
        "--no-exploits", "--no-patches", "--sequential",
        *_llm_model_args(ctx),
    ], env=ctx.env_llm(), timeout=1200, check=False)
    report = out / "raptor_agentic_report.json"
    assert report.is_file(), "agentic produced no report"


# ─── registry / driver ──────────────────────────────────────────────────

# (name, tier, function, strand). Registry order matters: cases sharing
# a strand run sequentially IN REGISTRY ORDER inside one pool task (later
# members consume artifacts / on-disk state from earlier ones and Skip
# when absent); strand=None cases are independent singleton tasks.
#
# Strand derivations (each verified by reading the case + the CLIs it
# spawns — see the per-strand notes):
#   scan-sarif    ctx.artifacts["scan_sarif"]: produced by scan-semgrep,
#                 consumed by agentic-sarif-import and
#                 analyze-no-llm-degrade.
#   agentic-out   ctx.artifacts["agentic_out"]: produced by
#                 agentic-no-llm, consumed by agentic-reanalyze and
#                 verified-outcomes (which otherwise falls back to an
#                 empty dir — serial semantics kept deterministic).
#   sca-findings  ctx.artifacts["sca_findings"]: produced by sca-scan,
#                 consumed by sca-render, sca-diff, sca-render-gate.
#   annotations   annotate and audit-stale share out_dir("annotations")
#                 (annotate writes then removes; audit-stale reads).
#   codeql-db     scan-stage-overlap and codeql-scan-only both run
#                 `codeql database analyze` against the SAME cached DB
#                 (content-hashed slot under codeql_dbs/); CodeQL's IMB
#                 disk cache is single-instance locked, so concurrent
#                 analyze runs fail with a lock error. DB CREATION is
#                 concurrent-safe (staging + atomic promote) — query
#                 execution is not.
#   registry      the shared isolated-HOME project registry:
#                 project-lifecycle MUTATES it (create/use/rename/
#                 delete + .active symlink); review-notes' `review
#                 note` delegates to raptor-annotate WITHOUT --base, so
#                 it resolves the active project from that registry;
#                 flag-matrix's coverage-detailed/gaps entries assert
#                 rc==0 on coverage-summary reads of the same registry.
#
# Everything else is a pure read of shared state (coverage-summary,
# coverage-flags, review-empty-graceful: check=False registry reads) or
# fully self-contained (own out_dir / fixtures; the codeql DB cache and
# the JSON/SCA caches use atomic staging+rename and are concurrent-safe
# across the child processes cases spawn).
CASES: list[tuple[str, str, object, str | None]] = [
    ("doctor", "t0", case_doctor, None),
    ("describe", "t0", case_describe, None),
    ("scan-semgrep", "t0", case_scan_semgrep, "scan-sarif"),
    ("scan-policy-groups", "t0", case_scan_policy_groups, None),
    ("scan-stage-overlap", "t0", case_scan_stage_overlap, "codeql-db"),
    ("codeql-scan-only", "t0", case_codeql_scan_only, "codeql-db"),
    ("sca-scan", "t0", case_sca_scan, "sca-findings"),
    ("sca-render", "t0", case_sca_render, "sca-findings"),
    ("sca-offline", "t0", case_sca_offline, None),
    ("agentic-no-llm", "t0", case_agentic_nollm, "agentic-out"),
    ("agentic-sarif-import", "t0", case_agentic_sarif_import, "scan-sarif"),
    ("agentic-reanalyze", "t0", case_agentic_reanalyze, "agentic-out"),
    ("fuzz-plan-only", "t0", case_fuzz_plan_only, None),
    ("exploit-feasibility", "t0", case_exploit_feasibility, None),
    ("project-lifecycle", "t0", case_project_lifecycle, "registry"),
    ("run-lifecycle", "t0", case_run_lifecycle, None),
    ("annotate", "t0", case_annotate, "annotations"),
    ("diagram", "t0", case_diagram, None),
    ("review-empty-graceful", "t0", case_review_empty, None),
    ("verified-outcomes", "t0", case_verified_outcomes, "agentic-out"),
    ("coverage-summary", "t0", case_coverage_summary, None),
    ("resolve-mode", "t0", case_resolve_mode, None),
    ("audit-mechanical-sweep", "t0", case_audit_mechanical, None),
    ("tool-sandbox-matrix", "t0", case_tool_sandbox_matrix, None),
    ("sca-fix-plan", "t0", case_sca_fix_plan, None),
    ("sca-purl", "t0", case_sca_purl, None),
    ("sca-check", "t0", case_sca_check, None),
    ("sca-upgrade", "t0", case_sca_upgrade, None),
    ("sca-diff", "t0", case_sca_diff, "sca-findings"),
    ("sca-health", "t0", case_sca_health, None),
    ("sca-render-gate", "t0", case_sca_render_gate, "sca-findings"),
    ("sca-clean-cache", "t0", case_sca_clean_cache, None),
    ("audit-stale", "t0", case_audit_stale, "annotations"),
    ("review-notes", "t0", case_review_notes, "registry"),
    ("binary-map", "t0", case_binary_map, None),
    ("diagram-stdout", "t0", case_diagram_stdout, None),
    ("coverage-flags", "t0", case_coverage_flags, None),
    ("describe-text", "t0", case_describe_text, None),
    ("doctor-strict", "t0", case_doctor_strict, None),
    ("scorecard-cli", "t0", case_scorecard_cli, None),
    ("scan-extra-config", "t0", case_scan_extra_config, None),
    ("analyze-no-llm-degrade", "t0", case_analyze_no_llm_degrade,
     "scan-sarif"),
    ("trust-mask-hostile", "t0", case_trust_mask_hostile, None),
    ("seccomp-truncation-probe", "t0", case_seccomp_truncation_probe, None),
    ("egress-embedded-ipv4-deny", "t0", case_egress_embedded_ipv4_deny,
     None),
    ("env-ef-through-scrub", "t0", case_env_ef_through_scrub, None),
    ("codeql-manifest-only-cap", "t0", case_codeql_manifest_only_cap, None),
    ("sbom-license-shape", "t0", case_sbom_license_shape, None),
    ("ci-gates", "t0", case_ci_gates, None),
    ("cli-help-surface", "t0", case_cli_help_surface, None),
    ("flag-matrix", "t0", case_flag_matrix, "registry"),
    # no-secret-leakage sweeps every earlier case's outputs — keep LAST.
    # Barrier case (see _BARRIER_CASES): never enters the pool.
    ("no-secret-leakage", "t0", case_no_secret_leakage, None),
    ("binary-oracle-e2e", "deep", case_binary_oracle_e2e, None),
    ("llm-ask", "llm", case_llm_ask, None),
    ("audit-llm-tiny", "llm", case_audit_llm, None),
    ("agentic-llm-tiny", "llm", case_agentic_llm, None),
]

# Cases that must observe every other selected case's outputs: kept out
# of the pool entirely and run strictly after it drains, in registry
# order.
_BARRIER_CASES = frozenset({"no-secret-leakage"})

# Completion lines print from case threads; one lock keeps them whole.
_PRINT_LOCK = threading.Lock()


def _default_case_workers() -> int:
    """Small pool by design: the heavy cases each spawn multi-core child
    pipelines (semgrep, codeql, agentic), so the CASE pool must stay far
    below cpu_count or the children oversubscribe the host."""
    return min(6, max(2, (os.cpu_count() or 4) // 8))


def _strand_tasks(entries: list[tuple]) -> list[list[tuple]]:
    """Group (pos, name, tier, fn, strand) entries into pool tasks.

    Same-strand entries form ONE task (run sequentially in registry
    order); strand=None entries are singleton tasks. Tasks are ordered
    by their first member's registry position, so a single-worker pool
    reproduces registry order exactly.
    """
    tasks: list[list[tuple]] = []
    by_strand: dict[str, list[tuple]] = {}
    for entry in entries:
        strand = entry[4]
        if strand is None:
            tasks.append([entry])
        elif strand in by_strand:
            by_strand[strand].append(entry)
        else:
            group = [entry]
            by_strand[strand] = group
            tasks.append(group)
    return tasks


def _run_case(ctx: Ctx, name: str, tier: str, fn) -> dict:
    """Run one case; print its completion line; return its record.

    Identical failure semantics to the historical serial loop: Skip →
    SKIP, AssertionError / any Exception → FAIL, nothing propagates.
    """
    start = time.monotonic()
    try:
        fn(ctx)
        status, detail = "PASS", ""
    except Skip as exc:
        status, detail = "SKIP", str(exc)
    except AssertionError as exc:
        status, detail = "FAIL", str(exc)
    except Exception as exc:  # noqa: BLE001 — case isolation
        status, detail = "FAIL", f"{type(exc).__name__}: {exc}"
    dur = time.monotonic() - start
    line = f"[{status:4s}] {name:28s} {dur:7.1f}s"
    if detail:
        line += f"  {detail.splitlines()[0]}"
    with _PRINT_LOCK:
        print(line, flush=True)
    return {
        "case": name, "tier": tier, "status": status,
        "duration_s": round(dur, 1), "detail": detail,
    }


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="raptor-self-test",
        description="Non-destructive RAPTOR command-surface smoke suite.",
    )
    ap.add_argument("--list", action="store_true",
                    help="list cases and exit")
    ap.add_argument("--only", metavar="SUBSTR", action="append",
                    default=[],
                    help="run only cases whose name contains SUBSTR "
                         "(repeatable)")
    ap.add_argument("--with-llm", action="store_true",
                    help="include budget-capped LLM cases (tier 1)")
    ap.add_argument("--deep", action="store_true",
                    help="include long-running mechanical cases")
    ap.add_argument("--keep", action="store_true",
                    help="keep the scratch directory for inspection")
    ap.add_argument("--model", default=os.environ.get("RAPTOR_SELFTEST_MODEL"),
                    help="model for LLM cases (default: RAPTOR's own "
                         "resolution; env RAPTOR_SELFTEST_MODEL)")
    ap.add_argument("--max-llm-cost", type=float, default=2.0,
                    help="total USD ceiling for tier-1 cases (default 2.0)")
    ap.add_argument("--timeout", type=int, default=_DEFAULT_CASE_TIMEOUT,
                    help="default per-case timeout in seconds")
    ap.add_argument("--json", metavar="FILE",
                    help="write machine-readable results to FILE")
    ap.add_argument("--case-workers", type=int, metavar="N", default=None,
                    help="parallel case lanes; 1 = serial in registry "
                         "order (default: min(6, max(2, cpu_count//8)))")
    args = ap.parse_args()
    if args.case_workers is not None and args.case_workers < 1:
        ap.error("--case-workers must be >= 1")

    selected = []
    for name, tier, fn, strand in CASES:
        if tier == "llm" and not args.with_llm:
            continue
        if tier == "deep" and not args.deep:
            continue
        if args.only and not any(s in name for s in args.only):
            continue
        selected.append((name, tier, fn, strand))

    if args.list:
        for name, tier, _, _ in selected:
            print(f"{tier:5s} {name}")
        return 0
    if not selected:
        print("raptor-self-test: no cases selected", file=sys.stderr)
        return 2

    scratch = Path(tempfile.mkdtemp(prefix="raptor_selftest_"))
    ctx = Ctx(scratch, args)
    print(f"raptor-self-test: scratch={scratch}")
    print(f"raptor-self-test: {len(selected)} case(s) selected")
    try:
        build_fixture(ctx)
        build_hostile_fixture(ctx)
        build_manifest_only_fixture(ctx)
    except Exception as exc:  # noqa: BLE001 — fixture failure aborts all
        print(f"raptor-self-test: fixture build failed: {exc}",
              file=sys.stderr)
        if not args.keep:
            shutil.rmtree(scratch, ignore_errors=True)
        return 1

    workers = args.case_workers or _default_case_workers()
    if workers > 1:
        # Serial (workers == 1) prints nothing here so its output stays
        # byte-identical to the historical loop.
        print(f"raptor-self-test: {workers} case lanes")
    # Global registry positions keep the report (and --json) ordered by
    # registry position regardless of completion order.
    indexed = [(pos, name, tier, fn, strand)
               for pos, (name, tier, fn, strand) in enumerate(selected)]
    pool_entries = [e for e in indexed if e[1] not in _BARRIER_CASES]
    barrier_entries = [e for e in indexed if e[1] in _BARRIER_CASES]

    results_by_pos: dict[int, dict] = {}

    def run_task(members: list[tuple]) -> None:
        # One strand per task: members run sequentially in registry
        # order; a member's failure never stops later members (same as
        # the serial loop — consumers Skip on missing artifacts).
        for pos, name, tier, fn, _strand in members:
            results_by_pos[pos] = _run_case(ctx, name, tier, fn)

    if workers == 1:
        # Serial mode: flat registry order, exactly the historical
        # behavior (strand grouping would reorder strand members ahead
        # of interleaved independent cases; a flat walk must not).
        for entry in pool_entries:
            run_task([entry])
    else:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            futures = [pool.submit(run_task, task)
                       for task in _strand_tasks(pool_entries)]
            # _run_case swallows all case exceptions, so .result() only
            # propagates genuine harness bugs — those must be loud.
            for fut in futures:
                fut.result()
    # Barrier cases (no-secret-leakage) sweep every other case's
    # outputs: strictly after the pool has fully drained.
    for entry in barrier_entries:
        run_task([entry])

    results = [results_by_pos[pos] for pos in sorted(results_by_pos)]
    failed = sum(1 for r in results if r["status"] == "FAIL")
    passed = sum(1 for r in results if r["status"] == "PASS")
    skipped = sum(1 for r in results if r["status"] == "SKIP")
    print(f"\nraptor-self-test: {passed} passed, {failed} failed, "
          f"{skipped} skipped (logs: {ctx.logs})")
    if args.json:
        Path(args.json).write_text(json.dumps({
            "results": results,
            "passed": passed, "failed": failed, "skipped": skipped,
        }, indent=2))
    if args.keep or failed:
        print(f"raptor-self-test: scratch retained at {scratch}")
    else:
        shutil.rmtree(scratch, ignore_errors=True)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
