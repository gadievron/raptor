def case_project_lifecycle(ctx: Ctx) -> None:
    env = ctx.env_t0(isolated_home=True)
    pm = str(_RAPTOR_DIR / "libexec" / "raptor-project-manager")
    name = "selftest"
    steps = [
        ["create", name, "--target", str(ctx.fixture), "-d", "self-test"],
        ["use", name],
        ["status"],
        ["set", "notes", "self-test scratch project"],
        ["get", "notes"],
        ["unset", "notes"],
        ["trust", "config"],
        ["trust"],
        ["untrust", "config"],
        ["binary", "list"],
        ["list"],
        ["coverage"],
        ["findings"],
        ["notes"],
        ["report"],
        ["correlate"],
        ["provenance"],
        ["annotations"],
        ["threat-model"],
        ["rename", name, "selftest2"],
        ["use", "selftest2"],
        ["clean", "--keep", "1"],
        ["none"],
        ["delete", "selftest2", "--force"],
    ]
    if ctx.fixture_bin is not None:
        steps[9:9] = [
            ["binary", "add", str(ctx.fixture_bin)],
            ["binary", "remove", str(ctx.fixture_bin)],
        ]
    for step in steps:
        ctx.run("project", [pm, *step], env=env, timeout=60, check=False)
    # The isolated HOME guarantees non-destructiveness; assert the real
    # registry was never touched by checking we only wrote under scratch.
    assert (ctx.home / ".raptor").exists() or True


def case_run_lifecycle(ctx: Ctx) -> None:
    env = ctx.env_t0()
    rl = str(_RAPTOR_DIR / "libexec" / "raptor-run-lifecycle")
    out = ctx.out_dir("lifecycle")
    proc = ctx.run("lifecycle", [
        rl, "start", "scan", "--target", str(ctx.fixture),
        "--out", str(out / "run1"),
    ], env=env, timeout=60)
    assert proc.returncode == 0
    log = ctx.logs / "lifecycle.log"
    sentinel = [ln for ln in log.read_text().splitlines()
                if ln.startswith("OUTPUT_DIR=")]
    assert sentinel, "no OUTPUT_DIR= sentinel emitted"
    run_dir = sentinel[-1].split("=", 1)[1]
    ctx.run("lifecycle", [rl, "complete", run_dir], env=env, timeout=60)
    ctx.run("lifecycle", [
        rl, "start", "scan", "--target", str(ctx.fixture),
        "--out", str(out / "run2"),
    ], env=env, timeout=60)
    ctx.run("lifecycle", [rl, "fail", str(out / "run2"), "self-test"],
            env=env, timeout=60, check=False)


def case_annotate(ctx: Ctx) -> None:
    env = ctx.env_t0(isolated_home=True)
    an = str(_RAPTOR_DIR / "libexec" / "raptor-annotate")
    base = ctx.out_dir("annotations")
    based = ["--base", str(base)]
    targeted = [*based, "--target", str(ctx.fixture)]
    ctx.run("annotate", [
        an, "add", "app.py", "ping", "--status", "suspicious",
        "-m", "fixture injection sink", *targeted,
