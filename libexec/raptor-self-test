def case_binary_map(ctx: Ctx) -> None:
    if ctx.fixture_bin is None:
        raise Skip("no compiled fixture binary (gcc missing?)")
    if not (shutil.which("r2") or shutil.which("radare2")):
        raise Skip("radare2 not on PATH")
    out = ctx.out_dir("binary-map")
    ctx.run("binary-map", [
        sys.executable, "raptor.py", "binary", "map",
        str(ctx.fixture_bin), "--out", str(out), "--quick",
    ], env=ctx.env_t0(), timeout=600, check=False)
    assert any(out.rglob("*.json")), f"binary map produced nothing in {out}"


