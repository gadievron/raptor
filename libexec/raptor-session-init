#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""SessionStart hook: env file setup and startup banner.

Called automatically by Claude Code and Codex session-start hooks.
Writes RAPTOR_DIR + PATH to the env file (overwrite, not append) and generates
the startup banner in .startup-output.

The banner is also printed to stdout on purpose: Claude Code attaches
SessionStart stdout to the conversation before the first user message, so the
assistant can render the banner directly without spending a second turn
reading .startup-output back from disk. The file remains as a fallback for
older Claude Code versions and direct/manual callers.

The launcher seeds the session's project binding (sessions.d) and exports the session credential; the .active symlink is the last-activated default.
"""
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

# The launcher formats argv data before a Codex process/context exists.
# Keep this stdlib-only path ahead of process_init and never shell-evaluate
# either value. It does not seed a session or inspect target code.
if __name__ == "__main__" and sys.argv[1:2] in (["--codex-launch-context"], ["--codex-launch-config"]):
    import json
    if len(sys.argv) != 4:
        sys.exit("Usage: raptor-session-init --codex-launch-context CALLER TARGET")
    if sys.argv[1] == "--codex-launch-config":
        # JSON basic strings are TOML basic strings for these argv values.
        # Keep Unicode literal: JSON surrogate-pair escapes are not TOML.
        # An empty target clears inherited values; publication exposes it as null.
        for key, value in (("RAPTOR_CALLER_DIR", sys.argv[2]),
                           ("RAPTOR_LAUNCH_TARGET", sys.argv[3])):
            print(f"shell_environment_policy.set.{key}=" + json.dumps(value, ensure_ascii=False))
    else:
        print(json.dumps({"caller_dir": sys.argv[2],
                          "launch_target": sys.argv[3] or None}, ensure_ascii=True))
    sys.exit(0)

# Explicit agent-driven startup is also available when Codex misses worktree
# hooks. Mark this process as initialization before process_init tries to
# restore a context that does not exist yet. Never infer this mode merely
# from a missing context in an ordinary RAPTOR command.
_CODEX_BOOTSTRAP = sys.argv[1:] == ["--codex-bootstrap"]
if _CODEX_BOOTSTRAP:
    import uuid
    session_id = os.environ.get("CODEX_THREAD_ID", "")
    try:
        if str(uuid.UUID(session_id)) != session_id:
            raise ValueError
    except ValueError:
        sys.exit("RAPTOR: --codex-bootstrap requires a valid CODEX_THREAD_ID")
    os.environ["CODEX"] = "1"
    os.environ["RAPTOR_CODEX_HOOK"] = "1"

sys.path.insert(0, str(REPO_ROOT))
import core.startup.process_init  # noqa: E402,F401



def codex_launch_context(session_id):
    """Expose only operator launch data after validating the session context."""
    from core.startup.codex_environment import restore
    values = restore(session_id)
    return {"caller_dir": values.get("RAPTOR_CALLER_DIR"),
            "launch_target": values.get("RAPTOR_LAUNCH_TARGET") or None}


def read_codex_start_payload():
    """Read a native hook payload, or identify the explicitly bootstrapped turn."""
    if _CODEX_BOOTSTRAP:
        return {"hook_event_name": "SessionStart",
                "session_id": os.environ["CODEX_THREAD_ID"]}
    import json
    return json.load(sys.stdin)


def _is_codex_host() -> bool:
    return bool(os.environ.get("CODEX") and (
        os.environ.get("RAPTOR_CODEX_HOOK") == "1" or not os.environ.get("CLAUDECODE")))


def _seed_codex_session(session_id=None) -> tuple[str, str] | None:
    """Ensure a sessions.d entry for a Codex session.

    Delegates to ``core.project.sessions.ensure_codex_session`` which
    holds _ledger_lock across the full read-decide-write cycle — two
    concurrent hooks cannot race on the entry.

    Returns (pid_str, token) on success, None on failure or if not a
    Codex session. Claude Code sessions are seeded by ``bin/raptor``.
    """
    if not _is_codex_host():
        return None

    try:
        from core.project.sessions import (
            ensure_codex_session,
            resolve_codex_owner_pid,
        )
    except ImportError:
        return None

    pid = resolve_codex_owner_pid()
    if pid is None:
        return None

    initial_project = None
    if session_id is not None:
        from core.project import sessions, session_scope
        session_id = session_scope.validate_id(session_id)
        # The launcher seeds its own PID before exec. Copy only its verified
        # binding; every logical session mints a separate credential/ledger.
        with session_scope.using_directory(sessions._base_sessions_dir()):
            if sessions._env_session_pid() == pid:
                fields = sessions._parse_entry(sessions._sessions_dir() / str(pid))
                if fields.get("seeded_by") in ("flag", "auto", "bookmark"):
                    initial_project = fields.get("project")
        os.environ["RAPTOR_CODEX_CONTEXT_ID"] = session_id
    result = ensure_codex_session(pid, initial_project=initial_project)
    if result is None:
        return None

    pid_str, token = result
    os.environ["RAPTOR_SESSION_PID"] = pid_str
    os.environ["RAPTOR_SESSION_TOKEN"] = token
    return result

def write_env_file():
    """Write the env file with static vars. Overwrites to ensure clean state.

    The env file is *sourced* by the session shell, so the checkout
    path must be written shell-safe: an unescaped path containing
    ``$(``, a backtick, or ``"`` would execute inside every session
    shell. ``shlex.quote`` single-quotes anything outside the safe
    character set (typical paths stay bare). The ``$PATH`` reference
    stays in its own double quotes, outside the quoted path, so it
    still expands.
    """
    import shlex

    if _is_codex_host():
        # Codex uses the validated native Bash bridge, not a shared shell file.
        os.environ["RAPTOR_DIR"] = str(REPO_ROOT)
        return

    env_file = os.environ.get("RAPTOR_ENV_FILE") or os.environ.get("CLAUDE_ENV_FILE")
    if not env_file:
        return

    repo_root = str(REPO_ROOT)
    bin_dir = str(REPO_ROOT / "bin")

    content = (
        f'export RAPTOR_DIR={shlex.quote(repo_root)}\n'
        f'export PATH="$PATH":{shlex.quote(bin_dir)}\n'
    )

    try:
        Path(env_file).write_text(content, encoding="utf-8")
    except OSError:
        pass

    # Set in current process so the doctor check doesn't false-alarm.
    os.environ["RAPTOR_DIR"] = repo_root


def generate_banner():
    """Generate the startup banner and write to .startup-output."""
    try:
        from core.startup.init import main as init_main
        init_main()
    except Exception as e:
        # Non-fatal — write a minimal banner
        output_file = REPO_ROOT / ".startup-output"
        try:
            output_file.write_text(f"RAPTOR startup error: {e}\n", encoding="utf-8")
        except OSError:
            pass


def warm_sage_embeddings():
    """Fire one embed call in a background process to warm the Ollama model."""
    try:
        from core.sage.config import SageConfig
        cfg = SageConfig.from_env()
        if not cfg.enabled:
            return
        import subprocess
        # Child snippet uses the mandated os.environ["RAPTOR_DIR"]
        # sys.path pattern; identity-linted — keep the line shape.
        # fmt: off
        subprocess.Popen(
            [sys.executable, "-c",
             "import sys,os;sys.path.insert(0,os.environ['RAPTOR_DIR']);"
             "from core.sage.client import SageClient;"
             "from core.sage.config import SageConfig;"
             "c=SageClient(SageConfig.from_env());"
             "c.embed('warmup')"],
            env={**os.environ, "RAPTOR_DIR": str(REPO_ROOT)},
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        # fmt: on
    except Exception as e:  # noqa: BLE001
        print(f"SAGE warmup launch failed: {e}", file=sys.stderr)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--codex-python"]:
        # Standalone procedure snippets need RAPTOR_DIR before their first
        # import. process_init above restores this process only; never source
        # a shared env file or rewrite an independently approved shell call.
        if (len(sys.argv) < 3 or os.environ.get("RAPTOR_CODEX_ENVIRONMENT") != "1"
                or not os.environ.get("CODEX_THREAD_ID")
                or not os.environ.get("RAPTOR_CODEX_CONTEXT_ID")
                or os.environ.get("CLAUDECODE") or os.environ.get("RAPTOR_CODEX_HOOK") == "1"):
            sys.exit("Usage in an initialized Codex session: "
                     "python3 -I libexec/raptor-session-init --codex-python SCRIPT [ARGS...]")
        import runpy
        sys.argv = sys.argv[2:]
        runpy.run_path(sys.argv[0], run_name="__main__")
        sys.exit(0)
    if sys.argv[1:] == ["--codex-subagent-context"]:
        from core.json import loads
        from core.startup.codex_environment import publish_alias
        try:
            payload = loads(sys.stdin.read(64 * 1024 + 1), max_bytes=64 * 1024)
            if not isinstance(payload, dict) or payload.get("hook_event_name") != "SubagentStart":
                raise ValueError("invalid SubagentStart payload")
            publish_alias(payload.get("session_id"), payload.get("agent_id"))
        except (OSError, ValueError, TypeError):
            sys.exit("RAPTOR: Codex subagent owner context unavailable")
        sys.exit(0)
    if sys.argv[1:] == ["--codex-context"]:
        import json
        try:
            print(json.dumps(codex_launch_context(os.environ.get("CODEX_THREAD_ID")),
                             ensure_ascii=True))
        except (OSError, ValueError, TypeError):
            sys.exit("RAPTOR: no validated Codex launch context available")
        sys.exit(0)
    from core.run.cli_outcome import cli_outcome
    with cli_outcome():
        if _is_codex_host():
            from core.startup.codex_environment import publish, read_context, _session_id
            try:
                payload = read_codex_start_payload()
                if (not isinstance(payload, dict)
                        or payload.get("hook_event_name") != "SessionStart"):
                    raise ValueError("invalid SessionStart payload")
                session_id = _session_id(payload.get("session_id"))
                try:
                    # Native subagent tool shells can carry their thread ID.
                    # A vetted alias resolves to the same root even through
                    # the explicit bootstrap fallback; never seed a child root.
                    session_id = read_context(session_id)["session_id"]
                except FileNotFoundError:
                    pass
                seeded = _seed_codex_session(session_id)
                if seeded is None:
                    raise ValueError("session seeding failed")
                publish(session_id, int(seeded[0]))
            except (OSError, ValueError, TypeError):
                sys.exit("RAPTOR: Codex session initialization failed; no command environment available")
        write_env_file()
        generate_banner()
        if _CODEX_BOOTSTRAP:
            # Agent-driven bootstrap output is already visible in the tool UI.
            # Include help here so the assistant need only acknowledge success.
            print("Quick commands: $agentic, $scan, "
                  "$fuzz, $web — /skills to browse; "
                  "$commands for the full RAPTOR list.")
        warm_sage_embeddings()
