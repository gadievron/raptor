#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Study loop: prep → study, seeded from the reading list.

Two modes:

1. **Overview** (no identifiers given): mechanical inventory + one LLM
   call → print identifiers/concepts, done.

2. **Study** (identifiers/concepts given, or reading list on disk):
   single pass — pending reading-list items seed the prep scope, then
   prep + study-run execute once.  Resolution bookkeeping lives with
   the study pipeline and its callers (core.concepts.study saves the
   updated list; the audit orchestrator marks items resolved);
   whatever remains pending is reported at the end for the next run.

   The reading list is the work queue.  Audit (or the operator) pushes
   items onto it; study consumes them.  Study-run may add genuine
   concept dependencies ("I can't explain Y without understanding X")
   but never tangential references.

Usage:
    raptor-study-loop <target> <output_dir> [options]
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.config import RaptorConfig  # noqa: E402
from core.json import load_json, save_json  # noqa: E402
from core.security.log_sanitisation import sanitise_for_terminal  # noqa: E402
from core.security.prompt_output_sanitise import (  # noqa: E402
    sanitise_code,
    sanitise_string,
)


def _prose(text: object) -> str:
    """Defang LLM/target-derived free text for the study report."""
    return sanitise_string(str(text), max_chars=4000)


def _line(text: object) -> str:
    """Single-line variant for headings, labels, and list items."""
    return sanitise_string(str(text), max_chars=300).replace("\n", " ")


def _cell(text: object) -> str:
    """Markdown-table-cell variant (pipes escaped)."""
    return _line(text).replace("|", "\\|")

# Study artifacts (reading/study lists, domain model, overview,
# struct annotations) are small RAPTOR-written run output.
_MAX_STUDY_ARTIFACT_BYTES = 64 * 1024 * 1024

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

def _run(cmd: list[str], *, verbose: bool = False) -> int:
    # Curated env, not a full os.environ copy: the children (study-prep
    # / study-run / compile-invariants) are RAPTOR's own LLM-calling
    # scripts, so they get the sanitised baseline plus LLM keys and
    # transport routing (get_llm_env) — the same env the canonical
    # raptor.py spawn path hands its children — instead of whatever the
    # operator's shell happened to carry. Documented study knobs are
    # forwarded explicitly; the trust marker is set as before.
    env = RaptorConfig.get_llm_env()
    for knob in ("RAPTOR_STUDY_MAX_OUTPUT_TOKENS",):
        val = os.environ.get(knob)
        if val is not None:
            env[knob] = val
    env["_RAPTOR_TRUSTED"] = "1"
    try:
        result = subprocess.run(
            cmd, env=env,
            stdout=None if verbose else subprocess.DEVNULL,
            stderr=None,
            timeout=3600,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print(f"study-loop: subprocess timed out: {cmd[0]}",
              file=sys.stderr)
        return 1
    return result.returncode


def _struct_definitions(sl: dict) -> list[dict]:
    """Struct-definition report entries from a study-list payload.

    Study-list items are LLM-adjacent artifacts: tolerate a missing
    name (skip the item) and a junk relevance tier (keep the item —
    fail toward review). A malformed item must not raise here — this
    runs in main() AFTER the paid study completed, before the report,
    project promotion, and SAGE storage, so an escaping KeyError
    throws all of that away.
    """
    struct_defs: list[dict] = []
    for item in sl.get("items", []):
        if not isinstance(item, dict) or item.get("kind") != "struct":
            continue
        tier = item.get("relevance_tier")
        if isinstance(tier, (int, float)) and tier > 2:
            continue
        name = item.get("name")
        if not name:
            continue
        struct_defs.append({
            "name": name,
            "file": item.get("file", ""),
            "definition": item.get("definition", ""),
            "fields": item.get("fields", []),
            "relevance_tier": tier,
            "doc_comment": item.get("doc_comment", ""),
        })
    return struct_defs


def _load_pending_reading_list(output_dir: Path) -> list[dict]:
    rl_path = output_dir / "reading-list.json"
    if not rl_path.is_file():
        return []
    raw = load_json(rl_path, max_bytes=_MAX_STUDY_ARTIFACT_BYTES)
    if not isinstance(raw, dict):
        return []
    return [
        i for i in raw.get("items", [])
        if not i.get("resolved") and not i.get("unresolvable")
    ]


# ------------------------------------------------------------------
# Project persistence
# ------------------------------------------------------------------

def _detect_concepts_dir(output_dir: Path) -> Path | None:
    project_root = output_dir.parent
    if (project_root / "concepts").is_dir():
        return project_root / "concepts"
    try:
        parts = project_root.parts
        if len(parts) >= 2 and parts[-2] == "projects":
            concepts = project_root / "concepts"
            concepts.mkdir(parents=True, exist_ok=True)
            return concepts
    except (IndexError, ValueError):
        pass
    return None


def _load_prior_knowledge(output_dir: Path, concepts_dir: Path | None) -> None:
    if concepts_dir is None:
        return
    for name in ("domain-model.json", "reading-list.json", "patterns.json"):
        prior = concepts_dir / name
        target = output_dir / name
        if prior.is_file() and not target.is_file():
            try:
                # Atomic: a torn copy (crash mid-write) leaves e.g. a
                # malformed reading-list.json that load_json reads as
                # None → [] pending → the next prep silently de-scopes
                # to a full-tree scan.
                from core.atomic_fs import write_text_atomically
                write_text_atomically(
                    target, prior.read_text(encoding="utf-8"))
                print(f"study-loop: loaded prior {name} from {concepts_dir}",
                      file=sys.stderr)
            except OSError as exc:
                print(f"study-loop: WARNING: failed to load prior {name}: {exc}",
                      file=sys.stderr)


def _promote_to_project(output_dir: Path, concepts_dir: Path | None) -> None:
    """Promote run artifacts to the project concepts store — by MERGE.

    A byte-copy here loses updates: ``run_study`` has already
    merge-promoted this run's domain model into the canonical copy
    (core.concepts.study._promote_to_project), and a concurrent run
    may have contributed between that promote and this call, so every
    promotion below folds the run's artifact INTO the canonical file
    instead of replacing it. The domain model goes through the core
    merge implementation so there is exactly one promotion semantics
    to maintain.
    """
    if concepts_dir is None:
        return
    promoted = 0

    dm_src = output_dir / "domain-model.json"
    if dm_src.is_file():
        try:
            from core.concepts.study import merge_promote_domain_model
            merge_promote_domain_model(
                dm_src, concepts_dir / "domain-model.json")
            promoted += 1
        except (OSError, ValueError) as exc:
            print("study-loop: WARNING: failed to promote "
                  f"domain-model.json: {exc}", file=sys.stderr)

    rl_src = output_dir / "reading-list.json"
    if rl_src.is_file():
        try:
            from core.concepts.reading_list import ReadingList
            run_list = ReadingList.load(rl_src)
            # Folds in items already on disk at the canonical path;
            # the run's own item states win for ids it knows.
            run_list.save_merged(concepts_dir / "reading-list.json")
            promoted += 1
        except (OSError, ValueError, TypeError) as exc:
            # TypeError: a torn/hand-edited run list with items missing
            # required fields must degrade to a warning, not a crash.
            print("study-loop: WARNING: failed to promote "
                  f"reading-list.json: {exc}", file=sys.stderr)

    pat_src = output_dir / "patterns.json"
    if pat_src.is_file():
        try:
            from core.concepts.study import merge_promote_patterns
            merge_promote_patterns(pat_src, concepts_dir / "patterns.json")
            promoted += 1
        except (OSError, ValueError) as exc:
            print("study-loop: WARNING: failed to promote "
                  f"patterns.json: {exc}", file=sys.stderr)

    # Only report success when something actually landed — a run that
    # produced no artifacts (or whose promotions all failed) must not
    # claim the project concepts dir was refreshed.
    if promoted:
        print(f"study-loop: promoted domain model to {concepts_dir}",
              file=sys.stderr)


def _store_in_sage(output_dir: Path, target: str) -> None:
    dm_path = output_dir / "domain-model.json"
    if not dm_path.is_file():
        return
    try:
        from core.concepts.model import DomainModel
        from core.sage.hooks import store_study_concepts
    except ImportError:
        return
    try:
        dm = DomainModel.load(dm_path)
    except Exception:  # noqa: BLE001 - SAGE storage is best-effort
        return
    try:
        stored = store_study_concepts(target, dm, study_scope=str(target))
        if stored:
            print(f"study-loop: stored {stored} concepts in SAGE",
                  file=sys.stderr)
    except Exception as exc:  # noqa: BLE001 - SAGE storage is best-effort
        print(f"study-loop: WARNING: SAGE storage failed: {sanitise_for_terminal(str(exc), max_len=300)}",
              file=sys.stderr)


# ------------------------------------------------------------------
# Overview mode
# ------------------------------------------------------------------

_OVERVIEW_SCHEMA = {
    "type": "object",
    "properties": {
        "subject_title": {
            "type": "string",
            "description": (
                "A short, descriptive title for the subsystem or "
                "component (e.g. 'Scatter-Gather Lists (scatterlist)', "
                "'SLAB Memory Allocator', 'VFS Inode Cache'). "
                "Name what it IS, not the directory path."
            ),
        },
        "summary": {
            "type": "string",
            "description": "One-paragraph summary of what this directory does.",
        },
        "identifiers": {
            "type": "array",
            "items": {"type": "string"},
            "description": (
                "Key struct/function/type names worth studying in depth. "
                "Pick the central abstractions — the types that own "
                "resources, the functions that enforce invariants, the "
                "entry points that define the API. 10-30 names."
            ),
        },
        "concepts": {
            "type": "array",
            "items": {"type": "string"},
            "description": (
                "Semantic concepts worth understanding — ownership "
                "models, lifetime rules, state machines, concurrency "
                "protocols. Phrase as short noun phrases. 3-10 concepts."
            ),
        },
    },
    "required": ["subject_title", "identifiers", "concepts"],
}


# Same source/header surface the prep pipeline studies — overview mode
# must not reject C++-only trees that the rest of the pipeline supports.
_OVERVIEW_EXTENSIONS = frozenset(
    (".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hxx"))
_OVERVIEW_HEADER_EXTENSIONS = frozenset((".h", ".hpp", ".hxx"))


def _overview_from_directory(
    target: Path,
    model: str | None = None,
) -> tuple[list[str], list[str], str, str]:
    """Cheap inventory: file names + header types + one LLM call.

    Returns (identifiers, concepts, summary, subject_title).
    """
    # The target may be a single file (per the CLI help) — rglob on a
    # non-directory yields nothing, so handle it explicitly.
    if target.is_file():
        c_files = (
            [target] if target.suffix in _OVERVIEW_EXTENSIONS else []
        )
        listing_base = target.parent
    else:
        # Skip symlinks like the prep scan does — a hostile tree's
        # out-pointing link must not feed host file content into the
        # overview prompt.
        c_files = sorted(
            f for f in target.rglob("*")
            if f.suffix in _OVERVIEW_EXTENSIONS and not f.is_symlink()
        )
        listing_base = target
    if not c_files:
        return [], [], "", ""

    file_listing = "\n".join(
        str(f.relative_to(listing_base)) for f in c_files[:200]
    )

    struct_names: list[str] = []
    # Cap full-text header reads: the prompt keeps at most 200 struct
    # names, so reading EVERY header in a huge tree is pure I/O cost;
    # too low a cap and a deep tree's core types (sorted order ≈
    # path order) can miss the overview. 500 comfortably covers the
    # 200-name budget while bounding the walk.
    _HEADER_READ_CAP = 500
    headers_read = 0
    for h in c_files:
        if h.suffix not in _OVERVIEW_HEADER_EXTENSIONS:
            continue
        if headers_read >= _HEADER_READ_CAP:
            break
        headers_read += 1
        try:
            text = h.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for m in re.finditer(
            r"\b(?:struct|union|enum|typedef)\s+([A-Za-z_]\w+)\s*\{", text,
        ):
            struct_names.append(m.group(1))
    struct_names = sorted(set(struct_names))[:200]

    intent_lines: list[str] = []
    for name in ("Kconfig", "Makefile", "README", "README.md"):
        p = target / name
        if p.is_file() and not p.is_symlink():
            try:
                text = p.read_text(encoding="utf-8", errors="replace")
                intent_lines.append(f"--- {name} (first 40 lines) ---")
                intent_lines.extend(text.splitlines()[:40])
            except OSError:
                pass

    prompt = (
        f"You are examining a C/C++ directory to decide what is worth "
        f"studying in depth.\n\n"
        f"Directory: {target.name}/\n"
        f"Files ({len(c_files)}):\n{file_listing}\n\n"
    )
    if struct_names:
        prompt += f"Types defined in headers:\n{', '.join(struct_names)}\n\n"
    if intent_lines:
        prompt += "\n".join(intent_lines) + "\n\n"
    prompt += (
        "Based on this inventory, identify:\n"
        "1. The key identifiers (structs, functions, types) that are "
        "central to understanding this code — the core abstractions, "
        "not every helper.\n"
        "2. The semantic concepts (ownership models, state machines, "
        "concurrency protocols) that would need to be understood to "
        "audit this code for correctness.\n"
    )

    try:
        from packages.llm_analysis import get_client
        if model:
            from core.llm.client import LLMClient
            client = LLMClient(pinned_model=model)
        else:
            client = get_client()
        _ensure_llm_dispatcher(client, "raptor-study-loop")
    except Exception:  # noqa: BLE001 - overview is best-effort
        print("study-loop: WARNING: no LLM available for overview",
              file=sys.stderr)
        return [], [], "", ""
    if client is None:
        print("study-loop: WARNING: no LLM available for overview",
              file=sys.stderr)
        return [], [], "", ""

    try:
        response = client.generate_structured(
            prompt, _OVERVIEW_SCHEMA, max_tokens=4096,
        )
        result = response.result if hasattr(response, "result") else {}
    except Exception as exc:  # noqa: BLE001 - overview is best-effort
        print(f"study-loop: WARNING: overview LLM call failed: {sanitise_for_terminal(str(exc), max_len=300)}",
              file=sys.stderr)
        return [], [], "", ""

    cost = getattr(response, "cost", 0.0)
    idents = result.get("identifiers", [])
    concepts = result.get("concepts", [])
    summary = result.get("summary", "")
    subject_title = result.get("subject_title", "")

    if subject_title:
        print("study-loop: subject: "
              f"{sanitise_for_terminal(subject_title)}", file=sys.stderr)
    if summary:
        print("study-loop: overview: "
              f"{sanitise_for_terminal(summary, max_len=512)}", file=sys.stderr)
    print(
        f"study-loop: overview produced {len(idents)} identifiers, "
        f"{len(concepts)} concepts (${cost:.4f})",
        file=sys.stderr,
    )

    return (
        [i for i in idents if isinstance(i, str) and len(i) >= 2],
        [c for c in concepts if isinstance(c, str) and len(c) >= 3],
        summary or "",
        subject_title or "",
    )


# ------------------------------------------------------------------
# Post-study synthesis (overview from learned concepts)
# ------------------------------------------------------------------

_SYNTHESIS_SCHEMA = {
    "type": "object",
    "properties": {
        "subject_title": {
            "type": "string",
            "description": (
                "A short, descriptive title for what was studied "
                "(e.g. 'Scatter-Gather Lists (scatterlist)', "
                "'SLAB Memory Allocator', 'VFS Inode Cache'). "
                "Name what the subsystem IS, not the directory."
            ),
        },
        "overview": {
            "type": "string",
            "description": (
                "3-5 paragraphs of flowing prose summarising the "
                "subsystem. Cover: what it does, its core design "
                "decisions, and the key mechanisms. Write for a "
                "security researcher who needs to understand the "
                "code's architecture before auditing it. No bullet "
                "points, no headers — just paragraphs."
            ),
        },
        "trust_summary": {
            "type": "string",
            "description": (
                "EXACTLY one sentence (max 40 words) describing "
                "the key trust boundary: who validates inputs and "
                "who trusts blindly. Do NOT write a paragraph. "
                "Example: 'the scatterlist API trusts its callers "
                "completely — no input validation; a corrupted "
                "scatterlist gives arbitrary kernel memory "
                "read/write.'"
            ),
        },
        "architecture": {
            "type": "object",
            "description": (
                "Structural properties of the codebase that "
                "constrain which vulnerability classes are possible."
            ),
            "properties": {
                "threading_model": {
                    "type": "string",
                    "enum": [
                        "single_threaded",
                        "multi_threaded",
                        "unknown",
                    ],
                    "description": (
                        "Whether the program uses threads. "
                        "'single_threaded' = no pthreads/C11 threads; "
                        "'multi_threaded' = uses pthreads or similar."
                    ),
                },
                "event_model": {
                    "type": "string",
                    "description": (
                        "How the program waits for events: "
                        "'select_loop', 'epoll', 'kqueue', "
                        "'callback', 'blocking_io', or 'none'."
                    ),
                },
                "forks": {
                    "type": "boolean",
                    "description": "True if the program calls fork().",
                },
                "signal_handlers": {
                    "type": "boolean",
                    "description": (
                        "True if the program registers signal handlers "
                        "via signal() or sigaction()."
                    ),
                },
            },
            "required": ["threading_model"],
        },
    },
    "required": ["subject_title", "overview", "trust_summary"],
}


def _synthesise_overview(
    dm_data: dict,
    model: str | None,
) -> tuple[str, str, str, dict | None]:
    """Generate subject_title + overview + trust_summary + architecture.

    Returns (subject_title, overview_summary, trust_summary, architecture).
    Falls back to ("", "", "", None) on any failure.
    """
    concepts = dm_data.get("concepts", [])
    invariants = dm_data.get("invariants", [])
    contracts = dm_data.get("contracts", [])
    if not concepts:
        return "", "", "", None

    # .get throughout: the model is a load_json dict (drift-tolerant
    # loader), and a KeyError here escapes the caller's
    # (OSError, ValueError) handler.
    concept_lines = "\n".join(
        f"- {c.get('id', '?')}: {c.get('description', '')}"
        for c in concepts
    )
    invariant_lines = "\n".join(
        f"- {inv.get('id', '?')}: {inv.get('statement', '')}"
        for inv in invariants
    )
    contract_lines = "\n".join(
        f"- {ct.get('function', '?')}: {ct.get('input_semantics', '')}"
        for ct in contracts
    )
    target = dm_data.get("target", "")

    prompt = (
        f"You have just studied the following code subsystem.\n\n"
        f"Directory: {target}\n\n"
        f"Concepts learned:\n{concept_lines}\n\n"
    )
    if invariant_lines:
        prompt += f"Invariants:\n{invariant_lines}\n\n"
    if contract_lines:
        prompt += f"API contracts:\n{contract_lines}\n\n"
    prompt += (
        "Synthesise a descriptive title and a 3-5 paragraph prose "
        "overview of this subsystem for a security researcher. "
        "Focus on the architecture and design decisions, not "
        "individual function behaviour.\n\n"
        "Also classify the architecture: is it single-threaded or "
        "multi-threaded? Does it use an event loop (select/poll/epoll)? "
        "Does it fork? Does it register signal handlers? These "
        "properties determine which vulnerability classes apply."
    )

    try:
        from packages.llm_analysis import get_client
        if model:
            from core.llm.client import LLMClient
            client = LLMClient(pinned_model=model)
        else:
            client = get_client()
        _ensure_llm_dispatcher(client, "raptor-study-loop")
    except Exception:  # noqa: BLE001 - synthesis is best-effort
        return "", "", "", None
    if client is None:
        return "", "", "", None

    try:
        response = client.generate_structured(
            prompt, _SYNTHESIS_SCHEMA, max_tokens=4096,
        )
        result = response.result if hasattr(response, "result") else {}
    except Exception as exc:  # noqa: BLE001 - synthesis is best-effort
        print(f"study-loop: WARNING: synthesis LLM call failed: {sanitise_for_terminal(str(exc), max_len=300)}",
              file=sys.stderr)
        return "", "", "", None

    cost = getattr(response, "cost", 0.0)
    title = result.get("subject_title", "")
    overview = result.get("overview", "")
    trust = result.get("trust_summary", "")
    arch = result.get("architecture")
    if trust:
        for sep in (". ", "; "):
            if sep in trust:
                trust = trust[: trust.index(sep) + 1]
                break
        if len(trust) > 200:
            last_space = trust.rfind(" ", 0, 200)
            if last_space > 100:
                trust = trust[:last_space] + "."
    if title:
        print(f"study-loop: synthesised title: {sanitise_for_terminal(title)} "
              f"(${float(cost):.4f})",
              file=sys.stderr)
    if arch:
        tm = arch.get("threading_model", "unknown")
        print("study-loop: architecture: "
              f"threading={sanitise_for_terminal(str(tm), max_len=64)}",
              file=sys.stderr)
    return title or "", overview or "", trust or "", arch


# ------------------------------------------------------------------
# Key file collection
# ------------------------------------------------------------------


def _collect_key_files(
    study_data: dict,
    key_files: list[dict[str, str]],
    seen: set[str],
    target_str: str,
) -> None:
    """Extract key files from study-list data.

    Three roles:
    - header: .h files containing primary struct definitions
    - implementation: .c files containing the main function bodies
    - documentation: docs that are *about* the subject (not just
      mentioning it)
    """
    # --- Struct definitions from tier-0 items → header role ---
    for item in study_data.get("items", []):
        tier = item.get("relevance_tier")
        if tier is not None and tier > 0:
            continue
        kind = item.get("kind", "")
        if kind != "struct":
            continue
        fpath = item.get("file", "")
        name = item.get("name", "")
        if not fpath or not name:
            continue
        if fpath in seen:
            continue
        seen.add(fpath)
        key_files.append({
            "role": "header",
            "file": fpath,
            "description": f"defines struct {name}",
        })

    # --- Implementation .c files from tier-0/1/2 function items ---
    # Filter out test harnesses and consumer code that merely *uses* the
    # subsystem (selftest.c, tcrypt.c, testmgr.c etc.) — those are not
    # the core implementation.
    _test_stems = {"selftest", "tcrypt", "testmgr", "test_", "selftests"}
    c_files: set[str] = set()
    for item in study_data.get("items", []):
        tier = item.get("relevance_tier")
        if tier is not None and tier > 2:
            continue
        if item.get("kind") != "function":
            continue
        fpath = item.get("file", "")
        if not fpath or not fpath.endswith(".c"):
            continue
        basename = fpath.rsplit("/", 1)[-1].removesuffix(".c")
        if any(basename.startswith(s) or basename == s for s in _test_stems):
            continue
        if item.get("usage_class") == "passthru":
            continue
        c_files.add(fpath)

    # Build per-file function lists for descriptions
    file_fns: dict[str, list[str]] = {}
    for item in study_data.get("items", []):
        if item.get("kind") != "function":
            continue
        fpath = item.get("file", "")
        if fpath in c_files:
            file_fns.setdefault(fpath, []).append(item.get("name", ""))

    for fpath in sorted(c_files):
        if fpath in seen:
            continue
        seen.add(fpath)
        fns = file_fns.get(fpath, [])
        desc = ", ".join(fns[:4])
        if len(fns) > 4:
            desc += f" (+{len(fns) - 4} more)"
        entry: dict[str, str] = {"role": "implementation", "file": fpath}
        if desc:
            entry["description"] = desc
        key_files.append(entry)

    # --- Documentation: rank by relevance, keep top 3. ---
    # study-prep writes "identifiers": null (not a missing key) for
    # concept-only studies, so .get's default never applies — coalesce
    # explicitly before splitting.
    identifiers = set((study_data.get("identifiers") or "").split(","))
    identifiers.discard("")
    # Doc paths are usually absolute, but older study lists carry
    # source-root-relative ones; a bare open() would resolve those
    # against the process CWD (the launcher dir, not the target) and
    # silently score 0.  Resolve against the recorded root instead.
    doc_root = study_data.get("source_root") or target_str
    scored_docs: list[tuple[float, dict]] = []
    for doc in study_data.get("related_docs", []):
        fpath = doc.get("file", "")
        if not fpath or fpath in seen:
            continue
        score_path = fpath
        if not os.path.isabs(fpath):
            score_path = str(Path(doc_root) / fpath)
        score = _score_doc_relevance(score_path, identifiers)
        if score > 0:
            scored_docs.append((score, doc))

    scored_docs.sort(key=lambda x: x[0], reverse=True)
    for _, doc in scored_docs[:3]:
        fpath = doc.get("file", "")
        seen.add(fpath)
        key_files.append({
            "role": "documentation",
            "file": fpath,
            "description": doc.get("reason", ""),
        })


def _score_doc_relevance(filepath: str, identifiers: set[str]) -> float:
    """Score how relevant a doc is to the study subject.

    Returns a score >= 0.  Title/heading matches score highest,
    body mentions add incremental weight.  A doc whose title mentions
    an identifier scores ~100+; a doc that mentions identifiers only
    in the body scores based on mention density.
    """
    try:
        with open(filepath, encoding="utf-8", errors="replace") as f:
            content = f.read(8192)
    except OSError:
        return 0.0

    if not content.strip():
        return 0.0

    lines = content.split("\n")  # line-model: universal-newline read above
    score = 0.0

    # Title / first heading (lines 0-5)
    title_lines: list[str] = []
    for line in lines[:6]:
        stripped = line.strip()
        if not stripped:
            if title_lines:
                break
            continue
        title_lines.append(stripped.lower())
        if len(title_lines) >= 2:
            break
    title_text = " ".join(title_lines)

    body_text = content.lower()

    for ident in identifiers:
        variants = {ident.lower(), ident.lower().replace("_", "")}
        for v in variants:
            if v in title_text:
                score += 100.0
            count = body_text.count(v)
            score += min(count, 20) * 2.0

    return score


# ------------------------------------------------------------------
# Human-readable report
# ------------------------------------------------------------------


def _render_study_report(output_dir: Path) -> None:
    """Render domain-model.json as a human-readable markdown report."""
    dm_path = output_dir / "domain-model.json"
    if not dm_path.is_file():
        return

    dm = load_json(dm_path, max_bytes=_MAX_STUDY_ARTIFACT_BYTES)
    if not isinstance(dm, dict):
        return

    parts: list[str] = []
    target = dm.get("target", "unknown")
    title = dm.get("subject_title", "")
    if not title:
        sl_path = output_dir / "study-list.json"
        if sl_path.is_file():
            sl = load_json(sl_path, max_bytes=_MAX_STUDY_ARTIFACT_BYTES)
            if isinstance(sl, dict):
                title = sl.get("identifiers", "")
    if not title:
        title = Path(target).name

    # Every free-text field below is LLM-authored or read from
    # target source — route prose through _prose/_line and code
    # through sanitise_code so study-report.md carries no live
    # markdown structure, autofetch markup, or control bytes.
    parts.append(f"# {_line(title)}\n")

    # --- Key files ---
    key_files = dm.get("key_files", [])
    if key_files:
        headers = [kf for kf in key_files if kf.get("role") == "header"]
        impls = [kf for kf in key_files
                 if kf.get("role") == "implementation"]
        docs = [kf for kf in key_files
                if kf.get("role") == "documentation"]

        if headers or impls:
            parts.append("## Source Files\n")
            if headers:
                for kf in headers:
                    desc = _line(kf.get("description", ""))
                    desc_str = f" — {desc}" if desc else ""
                    parts.append(f"- `{_line(kf['file'])}`{desc_str}")
            if impls:
                for kf in impls:
                    desc = _line(kf.get("description", ""))
                    desc_str = f" — studies {desc}" if desc else ""
                    parts.append(f"- `{_line(kf['file'])}`{desc_str}")
            parts.append("")

        if docs:
            parts.append("## Documentation\n")
            for kf in docs:
                desc = _line(kf.get("description", ""))
                desc_str = f" — {desc}" if desc else ""
                parts.append(f"- `{_line(kf['file'])}`{desc_str}")
            parts.append("")

    # --- Overview ---
    overview_summary = dm.get("overview_summary", "")
    concepts = dm.get("concepts", [])
    if overview_summary or concepts:
        parts.append("## Overview\n")
        if overview_summary:
            parts.append(_prose(overview_summary))
            parts.append("")
        else:
            for c in concepts:
                desc = c.get("description", "")
                if desc:
                    parts.append(_prose(desc))
                parts.append("")

    # --- Data Structures ---
    struct_defs = dm.get("struct_definitions", [])
    if struct_defs:
        parts.append("## Data Structures\n")

        # Build field annotation index: struct_name → {field: annotation}
        field_annots: dict[str, dict[str, str]] = {}
        for sa in dm.get("struct_annotations", []):
            sn = sa.get("struct_name", "")
            fn = sa.get("field_name", "")
            if sn and fn:
                field_annots.setdefault(sn, {})[fn] = sa.get(
                    "annotation", "",
                )

        rendered_structs: set[str] = set()
        for sd in struct_defs:
            name = sd.get("name", "")
            if name in rendered_structs:
                continue
            rendered_structs.add(name)
            defn = sd.get("definition", "")
            doc_comment = sd.get("doc_comment", "")
            parts.append(f"### `struct {_line(name)}`\n")
            if doc_comment:
                parts.append(_prose(doc_comment.strip()))
                parts.append("")
            if defn:
                # sanitise_code: control bytes escaped AND embedded
                # ``` runs defanged — a struct block quoting a fence
                # must not spill live markdown out of this block.
                parts.append("```c")
                parts.append(sanitise_code(defn.rstrip()))
                parts.append("```\n")
            # Render field annotations below the definition
            annots = field_annots.get(name, {})
            if annots:
                for field_name, annotation in annots.items():
                    parts.append(
                        f"**`{_line(field_name)}`**: {_line(annotation)}\n")
                parts.append("")

    # --- Data Structures (contracts for structs) ---
    contracts = dm.get("contracts", [])
    struct_contracts = [
        c for c in contracts
        if c.get("file", "").endswith(".h")
    ]
    impl_contracts = [
        c for c in contracts
        if not c.get("file", "").endswith(".h")
    ]

    if struct_contracts or impl_contracts:
        parts.append("## API Reference\n")
        for c in struct_contracts + impl_contracts:
            parts.append(
                f"### `{_line(c.get('function', '?'))}` "
                f"({_line(c.get('file', ''))})\n")
            if c.get("when"):
                parts.append(f"**When:** {_prose(c['when'])}\n")
            if c.get("input_semantics"):
                parts.append(f"**Input:** {_prose(c['input_semantics'])}\n")
            if c.get("output_semantics"):
                parts.append(f"**Output:** {_prose(c['output_semantics'])}\n")
            if c.get("ownership_transfer"):
                parts.append(
                    f"**Ownership:** {_prose(c['ownership_transfer'])}\n")
            if c.get("implication"):
                parts.append(
                    f"**Implication:** {_prose(c['implication'])}\n")
            if c.get("security_note"):
                parts.append(
                    f"**Security:** {_prose(c['security_note'])}\n")

    # --- Invariants & Safety ---
    invariants = dm.get("invariants", [])
    if invariants:
        parts.append("## Invariants & Safety\n")
        for inv in invariants:
            cwes = inv.get("relevant_cwes", [])
            cwe_str = f" ({_line(', '.join(str(c) for c in cwes))})" if cwes else ""
            parts.append(f"### {_line(inv.get('id', ''))}{cwe_str}\n")
            parts.append(f"{_prose(inv.get('statement', ''))}\n")
            neg = inv.get("negation", "")
            if neg:
                parts.append(f"**Violation:** {_prose(neg)}\n")

    # --- Bug patterns ---
    bug_patterns = dm.get("bug_patterns", [])
    if bug_patterns:
        parts.append("## Common Bug Patterns\n")
        for i, bp in enumerate(bug_patterns, 1):
            desc = bp.get("description", bp.get("id", ""))
            # Use first sentence only for terse rendering
            first_sentence = str(desc).split(". ")[0].rstrip(".")
            parts.append(f"{i}. **{_line(first_sentence)}**")
        parts.append("")

    # --- State machines ---
    state_machines = dm.get("state_machines", [])
    if state_machines:
        parts.append("## State Machines\n")
        for sm in state_machines:
            parts.append(f"### {_line(sm.get('name', ''))}\n")
            if sm.get("description"):
                parts.append(f"{_prose(sm['description'])}\n")
            states = sm.get("states", [])
            if states:
                parts.append("| State | Description |")
                parts.append("|-------|-------------|")
                for st in states:
                    desc = st.get("description", "")
                    parts.append(f"| {_cell(st.get('name', ''))} | {_cell(desc)} |")
                parts.append("")

    # --- Security context ---
    sc = dm.get("security_context")
    if sc and (sc.get("privilege_level") or sc.get("trust_summary")):
        parts.append("## Security Context\n")
        if sc.get("privilege_level"):
            parts.append(
                f"- **Privilege level:** {_line(sc['privilege_level'])}")
        if sc.get("attack_surface"):
            parts.append(
                f"- **Attack surface:** {_line(sc['attack_surface'])}")
        if sc.get("isolation"):
            parts.append(f"- **Isolation:** {_line(sc['isolation'])}")
        if sc.get("trust_summary"):
            parts.append(
                f"- **Key trust boundary:** {_line(sc['trust_summary'])}")
        parts.append("")

    seed_section = _render_seed_table(output_dir)
    if seed_section:
        parts.extend(seed_section)

    report_path = output_dir / "study-report.md"
    report_path.write_text("\n".join(parts) + "\n", encoding="utf-8")
    print(f"\nstudy-loop: report written to {report_path}",
          file=sys.stderr)


def _render_seed_table(output_dir: Path) -> list[str]:
    """The report's seed-provenance table: every seeded item with
    its source and why. Honesty first — seed selection is
    target-influenced (bridge seeds derive from attacker-controlled
    bytes; even operator seeds steer attention), so the table opens
    with that line rather than presenting seeded focus as neutral.
    Why-texts come from bridge-seeds.json (escaped at capture) and
    are re-escaped here for the markdown surface anyway.
    """
    sl_path = output_dir / "study-list.json"
    if not sl_path.is_file():
        return []
    sl = load_json(sl_path, max_bytes=_MAX_STUDY_ARTIFACT_BYTES)
    if not isinstance(sl, dict):
        return []
    seeded = [
        item for item in sl.get("items") or []
        if isinstance(item, dict) and item.get("seed_source")
    ]
    if not seeded:
        return []

    whys: dict[str, str] = {}
    bridge_path = output_dir / "bridge-seeds.json"
    if bridge_path.is_file():
        bridge = load_json(bridge_path, max_bytes=4 * 1024 * 1024)
        if isinstance(bridge, dict):
            for seed in bridge.get("seeds") or []:
                if isinstance(seed, dict) and seed.get("name"):
                    whys[str(seed["name"])] = str(seed.get("why") or "")

    # The honesty line is the bridge's CONSTANT (capitalised
    # mechanically) — a re-typed copy here would let the contract
    # string and the report drift apart.
    from core.orchestration.binary_study_bridge import HONESTY_LINE
    honesty = HONESTY_LINE[:1].upper() + HONESTY_LINE[1:]
    parts = [
        "## Seed Provenance\n",
        f"{honesty}. Seeds steer study "
        "attention only — they are hints, never verdicts.\n",
        "| Item | Source | Why |",
        "|------|--------|-----|",
    ]
    order = {"operator": 0, "bridge_seed": 1,
             "bridge_seed_overflow": 2, "bridge_corroborated": 3}
    seeded.sort(key=lambda i: order.get(str(i.get("seed_source")), 9))
    for item in seeded:
        name = str(item.get("name") or "")
        source = str(item.get("seed_source") or "")
        if source == "operator":
            why = "operator-asked identifier"
        elif source == "bridge_seed_overflow":
            why = whys.get(name, "bridge-derived lead") + (
                " — beyond the derived-attention cap; baseline "
                "treatment")
        else:
            why = whys.get(name, "bridge-derived lead")
        parts.append(f"| `{_cell(name)}` | {_cell(source)} "
                     f"| {_cell(why)} |")
    parts.append("")
    return parts


# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------



def _ensure_llm_dispatcher(client, label: str) -> None:
    """Self-serve the in-process LLM dispatcher for Bedrock-routed
    models — delegates to the shared gate
    (core.llm.dispatcher.lifecycle.ensure_route_for_client, which
    never raises). Kept as a local name: it is this script's test
    seam, and the lazy import keeps dispatcher machinery off the
    no-LLM startup path.
    """
    try:
        from core.llm.dispatcher.lifecycle import ensure_route_for_client
    except ImportError:  # no dispatcher machinery, no route to serve
        return
    ensure_route_for_client(client, label)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="raptor-study-loop",
        description="Study loop: prep → study → drain reading list.",
    )
    ap.add_argument("target", help="Study scope (directory or file).")
    ap.add_argument("output_dir", help="Output directory for study artefacts.")
    ap.add_argument("--root", default=None,
                    help="Source root for include resolution.")
    ap.add_argument("--identifier", default=None,
                    help="Initial identifiers (comma-separated).")
    ap.add_argument("--concept", default=None,
                    help="Initial semantic concepts (comma-separated).")
    ap.add_argument("--model", default=None,
                    help="LLM model override for study-run.")
    ap.add_argument("--batch-target", type=int, default=80,
                    help="Items per Phase-2 study batch (passed to raptor-study-run).")
    ap.add_argument("--include-dir", action="append", default=None,
                    dest="include_dirs", metavar="DIR",
                    help="Additional include search directories (repeatable).")
    ap.add_argument("--skip-compile", action="store_true",
                    help="Skip phase 3b (invariant->rule compilation) "
                         "— for callers that gate rule minting on "
                         "their own evidence policy (e.g. binary "
                         "study, where decompiled evidence never "
                         "compiles rules).")
    ap.add_argument("--redb", default=None, metavar="PATH",
                    help="Passed through to raptor-study-prep for "
                         "binary targets (re-database.json).")
    ap.add_argument("--redb-map", default=None, metavar="PATH",
                    help="Passed through to raptor-study-prep "
                         "(decomp-map.json sidecar).")
    ap.add_argument("--bridge-seed-file", default=None, metavar="PATH",
                    help="Passed through to raptor-study-prep "
                         "(bridge-seeds.json from the map→study "
                         "bridge). Also counts as an initial scope: "
                         "a run with bridge seeds proceeds to study "
                         "instead of the overview-only shortcut.")
    ap.add_argument("--max-cost", type=float, default=None,
                    metavar="USD",
                    help="Maximum LLM cost in USD before stopping — "
                         "passed through to raptor-study-run (the "
                         "dominant-spend leg; the overview and "
                         "compile legs run on the config default).")
    ap.add_argument("-v", "--verbose", action="store_true")
    parsed = ap.parse_args()

    # isfinite: argparse's float() accepts "nan"/"inf", and NaN
    # passes a naive `<= 0` gate — the forwarded cap then never
    # trips downstream, silently unlimited.
    import math
    if parsed.max_cost is not None and (
            not math.isfinite(parsed.max_cost) or parsed.max_cost <= 0):
        print("study-loop: --max-cost must be a positive finite "
              "dollar amount", file=sys.stderr)
        return 1

    target = Path(parsed.target).resolve()
    output_dir = Path(parsed.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    concepts_dir = _detect_concepts_dir(output_dir)
    if concepts_dir:
        print(f"study-loop: project concepts dir: {concepts_dir}",
              file=sys.stderr)
    _load_prior_knowledge(output_dir, concepts_dir)

    libexec_dir = Path(__file__).resolve().parent
    prep_bin = str(libexec_dir / "raptor-study-prep")
    run_bin = str(libexec_dir / "raptor-study-run")
    compile_bin = str(libexec_dir / "raptor-compile-invariants")

    identifiers = parsed.identifier or ""
    concepts = parsed.concept or ""

    rl_path = output_dir / "reading-list.json"
    has_reading_list = rl_path.is_file()
    bridge_seed_file = (Path(parsed.bridge_seed_file)
                        if parsed.bridge_seed_file else None)
    has_bridge_seeds = (bridge_seed_file is not None
                        and bridge_seed_file.is_file())

    # --- Overview mode ---
    # Bridge seeds are an initial scope like operator identifiers
    # (one tier down): with them present the run studies instead of
    # stopping at the overview shortcut — the one-shot binary flow
    # depends on this.
    if (not identifiers and not concepts and not has_reading_list
            and not has_bridge_seeds):
        print("study-loop: no identifier/concept given — running overview",
              file=sys.stderr)
        overview_idents, overview_concepts, overview_summary, overview_title = (
            _overview_from_directory(target, model=parsed.model)
        )
        if not overview_idents and not overview_concepts:
            print(
                "study-loop: ERROR: overview produced nothing.\n"
                "  Provide --identifier or --concept explicitly.",
                file=sys.stderr,
            )
            return 1
        overview = {
            "identifiers": overview_idents,
            "concepts": overview_concepts,
            "summary": overview_summary,
            "subject_title": overview_title,
        }
        overview_path = output_dir / "overview.json"
        save_json(overview_path, overview)
        # identifiers/concepts are LLM-returned free text — escape
        # control bytes before the operator terminal.
        print("\nIdentifiers:", file=sys.stderr)
        for ident in overview_idents:
            print(f"  - {sanitise_for_terminal(str(ident))}", file=sys.stderr)
        print("\nConcepts:", file=sys.stderr)
        for concept in overview_concepts:
            print(f"  - {sanitise_for_terminal(str(concept))}", file=sys.stderr)
        print(
            f"\nOverview written to {overview_path}\n"
            "Run again with --identifier or --concept to study specific topics.",
            file=sys.stderr,
        )
        return 0

    # --- Single pass: prep → study-run ---
    key_files: list[dict[str, str]] = []
    seen_key_files: set[str] = set()

    exit_code = 0

    # --- Prep ---
    prep_cmd = [sys.executable, prep_bin, str(target), str(output_dir)]
    if parsed.root:
        prep_cmd.extend(["--root", parsed.root])
    if identifiers:
        prep_cmd.extend(["--identifier", identifiers])
    if concepts:
        prep_cmd.extend(["--concept", concepts])
    if rl_path.is_file():
        prep_cmd.extend(["--reading-list", str(rl_path)])
    if parsed.include_dirs:
        for d in parsed.include_dirs:
            prep_cmd.extend(["--include-dir", d])
    if parsed.model:
        prep_cmd.extend(["--model", parsed.model])
    if parsed.redb:
        prep_cmd.extend(["--redb", parsed.redb])
    if parsed.redb_map:
        prep_cmd.extend(["--redb-map", parsed.redb_map])
    if has_bridge_seeds:
        prep_cmd.extend(["--bridge-seed-file", str(bridge_seed_file)])

    rc = _run(prep_cmd, verbose=parsed.verbose)
    if rc != 0:
        print(f"study-loop: prep failed (exit {rc})", file=sys.stderr)
        exit_code = rc

    study_list = output_dir / "study-list.json"
    if exit_code == 0 and not study_list.is_file():
        print("study-loop: prep produced no study-list.json",
              file=sys.stderr)
        exit_code = 1

    data: dict = {}
    n_items = 0
    if exit_code == 0:
        loaded = load_json(study_list, max_bytes=_MAX_STUDY_ARTIFACT_BYTES)
        if isinstance(loaded, dict):
            data = loaded
            n_items = len(data.get("items", []))

        _collect_key_files(data, key_files, seen_key_files, str(target))

        if n_items == 0:
            print("study-loop: no study items — done", file=sys.stderr)
        else:
            # --- Study ---
            run_cmd = [sys.executable, run_bin, str(output_dir)]
            if parsed.model:
                run_cmd.extend(["--model", parsed.model])
            if parsed.batch_target != 80:
                run_cmd.extend(["--batch-target", str(parsed.batch_target)])
            if parsed.max_cost is not None:
                run_cmd.extend(["--max-cost", str(parsed.max_cost)])
            if parsed.verbose:
                run_cmd.append("-v")

            print(f"study-loop: studying {n_items} items...",
                  file=sys.stderr)
            rc = _run(run_cmd, verbose=parsed.verbose)
            if rc != 0:
                print(f"study-loop: study-run failed (exit {rc})",
                      file=sys.stderr)
                exit_code = rc

    # --- Phase 3b: compile invariants into mechanical rules ---
    dm_path_check = output_dir / "domain-model.json"
    if parsed.skip_compile:
        print("study-loop: rule compilation skipped (--skip-compile)",
              file=sys.stderr)
    elif exit_code == 0 and dm_path_check.is_file():
        try:
            dm_check = load_json(
                dm_path_check, strict=True,
                max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
            ) or {}
            has_invariants = any(
                inv.get("statement") and inv.get("negation")
                and not inv.get("mechanical_rule")
                for inv in dm_check.get("invariants", [])
            )
        except (OSError, ValueError):
            has_invariants = False

        if has_invariants:
            compile_cmd = [sys.executable, compile_bin, str(output_dir)]
            if parsed.model:
                compile_cmd.extend(["--model", parsed.model])
            compile_cmd.extend(["--target", str(target)])
            if parsed.verbose:
                compile_cmd.append("-v")

            print("study-loop: compiling invariants into rules...",
                  file=sys.stderr)
            rc = _run(compile_cmd, verbose=parsed.verbose)
            if rc != 0:
                print(f"study-loop: compile-invariants failed (exit {rc})",
                      file=sys.stderr)
                exit_code = rc

    # --- Attach key files, overview, and struct definitions to domain model ---
    # Gated on success: on a failed run domain-model.json may be the
    # PRIOR canonical model copied in by _load_prior_knowledge — the
    # attach/synthesis pass would decorate a stale model with this
    # run's key files and pay the synthesis LLM call for a run that
    # already failed.
    dm_path = output_dir / "domain-model.json"
    if exit_code == 0 and dm_path.is_file():
        try:
            dm_data = load_json(
                dm_path, strict=True, max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
            ) or {}
            if key_files:
                dm_data["key_files"] = key_files

            # Attach overview summary and subject title if available
            overview_path = output_dir / "overview.json"
            if overview_path.is_file():
                try:
                    ov = load_json(
                        overview_path, strict=True,
                        max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
                    ) or {}
                    if ov.get("summary"):
                        dm_data["overview_summary"] = ov["summary"]
                    if ov.get("subject_title"):
                        dm_data["subject_title"] = ov["subject_title"]
                except (OSError, ValueError):
                    pass

            # Attach struct definitions from study-list for the report
            study_list_path = output_dir / "study-list.json"
            if study_list_path.is_file():
                try:
                    sl = load_json(
                        study_list_path, strict=True,
                        max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
                    ) or {}
                    struct_defs = _struct_definitions(sl)
                    if struct_defs:
                        dm_data["struct_definitions"] = struct_defs
                except (OSError, ValueError):
                    pass

            # Attach struct annotations from LLM output
            annots_path = output_dir / "struct-annotations.json"
            if annots_path.is_file():
                try:
                    annots = load_json(
                        annots_path, strict=True,
                        max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
                    )
                    if annots:
                        dm_data["struct_annotations"] = annots
                except (OSError, ValueError):
                    pass

            # Remove legacy fields if present from older runs
            dm_data.pop("related_docs", None)
            dm_data.pop("definitions", None)
            dm_data.pop("mechanical_findings", None)

            # Synthesise overview from learned concepts (one LLM call).
            # Run when subject_title is missing OR architecture block
            # hasn't been populated yet (architecture was added after
            # earlier runs already cached subject_title).
            needs_synthesis = dm_data.get("concepts") and (
                not dm_data.get("subject_title")
                or not dm_data.get("architecture")
            )
            if needs_synthesis:
                syn_title, syn_overview, syn_trust, syn_arch = (
                    _synthesise_overview(dm_data, parsed.model)
                )
                if syn_title:
                    dm_data["subject_title"] = syn_title
                if syn_overview:
                    dm_data["overview_summary"] = syn_overview
                if syn_trust:
                    sc = dm_data.get("security_context") or {}
                    sc["trust_summary"] = syn_trust
                    dm_data["security_context"] = sc
                if syn_arch and isinstance(syn_arch, dict):
                    dm_data["architecture"] = syn_arch

            save_json(dm_path, dm_data)
        except (OSError, ValueError):
            pass

    # --- Render human-readable report ---
    _render_study_report(output_dir)

    # study-questions.md is a RENDERING of reading-list.json (the
    # one store) — derived, regenerable, never a place questions
    # live. Best-effort: the renderer never fails the run.
    try:
        from core.concepts.reading_list import write_study_questions
        questions_path = write_study_questions(output_dir)
    except Exception:  # noqa: BLE001 — render is a convenience
        questions_path = None
    if questions_path:
        print(f"study-loop: study questions rendered to "
              f"{questions_path} (from reading-list.json)",
              file=sys.stderr)

    # --- Summary ---
    if dm_path.is_file():
        try:
            dm = load_json(
                dm_path, strict=True, max_bytes=_MAX_STUDY_ARTIFACT_BYTES,
            ) or {}
            print(f"\nstudy-loop: DONE — {len(dm.get('concepts', []))} concepts, "
                  f"{len(dm.get('invariants', []))} invariants, "
                  f"{len(dm.get('contracts', []))} contracts",
                  file=sys.stderr)
        except (OSError, ValueError):
            pass

    if key_files:
        print(f"\nKey files ({len(key_files)}):", file=sys.stderr)
        for kf in key_files:
            # role/path are target-derived; description quotes doc
            # titles extracted verbatim from target file content.
            role = sanitise_for_terminal(str(kf.get("role", "")), max_len=32)
            path = sanitise_for_terminal(str(kf.get("file", "")), max_len=200)
            desc = sanitise_for_terminal(str(kf.get("description", "")))
            label = f"  [{role}] {path}"
            if desc:
                label += f" — {desc}"
            print(label, file=sys.stderr)

    remaining = _load_pending_reading_list(output_dir)
    if remaining:
        print(f"\n{len(remaining)} unresolved reading-list items:",
              file=sys.stderr)
        for item in remaining:
            # reading-list questions are LLM-authored free text.
            q = sanitise_for_terminal(str(item.get("question", "")), max_len=100)
            print(f"  - {q}", file=sys.stderr)

    # Promotion and SAGE storage are durable-store WRITES — a failed
    # run must not push its (possibly prior/stale) domain model over
    # the project canonical copy or into persistent memory.
    if exit_code == 0:
        _promote_to_project(output_dir, concepts_dir)
        _store_in_sage(output_dir, str(target))
    else:
        print("study-loop: run failed — skipping project promotion "
              "and SAGE store", file=sys.stderr)

    return exit_code


if __name__ == "__main__":
    sys.exit(main())
