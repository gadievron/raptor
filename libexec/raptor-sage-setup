#!/usr/bin/env bash
#
# raptor-sage-setup — install or uninstall the SAGE persistent-memory sidecar.
#
# Install (default):
#   1. Verify prerequisites (jq, docker, python3, curl, sage-agent-sdk, wrapper).
#   2. Migrate SAGE_HOME volume mount if upgrading from the old .sage-gui layout.
#   3. docker compose -f core/sage/docker-compose.yml up -d.
#   4. Wait for SAGE health.
#   5. Seed institutional knowledge (core/sage/scripts/seed_sage_knowledge.py).
#   6. Register RAPTOR agents (core/sage/scripts/register_agents.py).
#   7. Generate stdio MCP entry in ./.mcp.json (replaces old SSE template).
#   8. Merge SAGE_ENABLED=true into .claude/settings.local.json.
#   9. Smoke-test the MCP wrapper.
#  10. Capture the server's boot payload and record it as operator-authorized
#      (.sage/boot-payload.authorized).
#  11. Generate the per-install row-MAC key if absent — authenticates SAGE
#      rows consumed mechanically (core/sage/rowmac.py). Lives at
#      $XDG_DATA_HOME/raptor/rowmac.key (default ~/.local/share/raptor/)
#      so no sandbox-readable target tree contains it. Never removed by
#      uninstall; deleting it is the operator's reset.
#
# Uninstall (--uninstall):
#   1. docker compose down (data volumes preserved).
#   2. Remove the SAGE entry from ./.mcp.json (delete file if it becomes empty).
#   3. Remove SAGE_ENABLED from .claude/settings.local.json (delete file if empty).
#   4. Remove .sage/boot-payload.authorized.
#
# SAGE is opt-in — 99% of users never touch this. .mcp.json is .gitignored so
# users who don't install SAGE have no MCP registration, no connection errors,
# and no SAGE-related context loaded into Claude Code.
#
# Usage:
#   libexec/raptor-sage-setup              # install
#   libexec/raptor-sage-setup --uninstall  # tear down
#
# Prereqs: jq, docker + docker compose, python3, pip-installed sage-agent-sdk.

set -euo pipefail

# Global EXIT trap + tmp-file array. Pre-fix the script used
# per-function `trap '...' RETURN` patterns to clean up tmp
# files. The RETURN trap only fires on FUNCTION exit, NOT on:
#   * Ctrl-C (SIGINT) mid-function.
#   * SIGTERM from the operator's shell / job manager.
#   * Crashes that propagate past the function's RETURN
#     handler (set -e + a sub-command failure).
# In each case the tmp file leaked into /tmp/, accumulating
# over multiple aborted setup attempts. Operators noticed
# `/tmp/tmp.XXXXX` files appearing after every Ctrl-C and
# wondered which to delete.
#
# Maintain a `_RAPTOR_TMP_FILES` array; functions append the
# tmp path to it. EXIT trap iterates the array and rm-fs each
# entry, fires on EVERY exit path including signals.
declare -a _RAPTOR_TMP_FILES=()
_raptor_cleanup_tmps() {
    local f
    for f in "${_RAPTOR_TMP_FILES[@]:-}"; do
        [ -n "$f" ] || continue
        if [ -d "$f" ]; then
            rm -rf "$f"
        else
            rm -f "$f"
        fi
    done
}
trap _raptor_cleanup_tmps EXIT

# ─── trust-marker check (do not source; inline by design) ───
if [ -z "${CLAUDECODE:-}" ] && [ -z "${_RAPTOR_TRUSTED:-}" ]; then
    echo "$0: internal dispatch script." >&2
    echo "  Run via 'bin/raptor' instead." >&2
    echo "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass." >&2
    exit 2
fi
# ─── end trust-marker check ─────────────────────────────────

usage() {
    cat >&2 <<'EOF'
usage: raptor-sage-setup [install | --uninstall | --status]

  (default)    install SAGE: bring up sidecar, seed, generate MCP entry.
  --uninstall  stop SAGE sidecar and remove its MCP entry (data volumes kept).
  --status     check whether SAGE is running and report health + embedding mode.

Prereqs: jq, docker + docker compose, python3, pip-installed sage-agent-sdk.
EOF
    exit 2
}

MODE=install
MODE_EXPLICIT=0
# Pre-fix the parser only knew `--uninstall` (default install).
# Two ambiguities operators hit:
#
# 1. Conflicting modes silently last-wins. Pre-fix
#    `--install --uninstall` (operator typo or paste from
#    a script that builds the argv) silently took the
#    LAST mode flag, with no warning. Now: explicit
#    flags conflict-detected; second mode flag errors.
# 2. No symmetric `--install` flag. Operators following
#    the README's "explicit is better" convention typed
#    `--install` and got "unknown argument" — even
#    though `--install` is exactly what the script does
#    by default. Accept it for symmetry with `--uninstall`.
# 3. No subcommand-style positional form. Operators used
#    to `git fetch` / `docker pull` reach for
#    `raptor-sage-setup install` / `raptor-sage-setup
#    uninstall` and got "unknown argument". Accept the
#    bare-word forms so the operator-facing surface is
#    permissive without sacrificing the explicit-flag
#    error path.
for arg in "$@"; do
    case "$arg" in
        --install|install)
            if [ "$MODE_EXPLICIT" = "1" ] && [ "$MODE" != "install" ]; then
                echo "raptor-sage-setup: conflicting modes: $arg vs --$MODE" >&2
                exit 2
            fi
            MODE=install
            MODE_EXPLICIT=1
            ;;
        --uninstall|uninstall)
            if [ "$MODE_EXPLICIT" = "1" ] && [ "$MODE" != "uninstall" ]; then
                echo "raptor-sage-setup: conflicting modes: $arg vs --$MODE" >&2
                exit 2
            fi
            MODE=uninstall
            MODE_EXPLICIT=1
            ;;
        --status|status)
            if [ "$MODE_EXPLICIT" = "1" ] && [ "$MODE" != "status" ]; then
                echo "raptor-sage-setup: conflicting modes: $arg vs --$MODE" >&2
                exit 2
            fi
            MODE=status
            MODE_EXPLICIT=1
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo "raptor-sage-setup: unknown argument: $arg" >&2
            usage
            ;;
    esac
done
_ORIG_ARGS=("$@")

# Resolve RAPTOR_DIR via symlink chain (same pattern as raptor-cc-trust-check).
# Hop bound — see raptor-cc-trust-check for the symlink-cycle rationale.
SCRIPT="$0"
_symhops=0
while [ -L "$SCRIPT" ]; do
    _symhops=$((_symhops + 1))
    if [ "$_symhops" -gt 32 ]; then
        echo "raptor-sage-setup: symlink hop limit exceeded resolving $0" >&2
        exit 3
    fi
    DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
    SCRIPT="$(readlink "$SCRIPT")"
    [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
unset _symhops
RAPTOR_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

COMPOSE_FILE="$RAPTOR_DIR/core/sage/docker-compose.yml"
MCP_WRAPPER="$RAPTOR_DIR/libexec/raptor-sage-mcp"
MCP="$RAPTOR_DIR/.mcp.json"
SETTINGS_LOCAL="$RAPTOR_DIR/.claude/settings.local.json"
SAGE_URL="http://localhost:8090"
# Lives under .sage/ — already gitignored, per-machine SAGE state.
AUTHORIZED_PAYLOAD="$RAPTOR_DIR/.sage/boot-payload.authorized"
# Per-install HMAC key for mechanically consumed SAGE rows
# (core/sage/rowmac.py). Deliberately OUTSIDE the repo tree — several
# sandbox profiles grant children repo-root read, and a sandboxed
# target that could read an in-repo key could mint valid row MACs.
# Must resolve identically to core/sage/rowmac.py:_key_path().
ROWMAC_KEY="${XDG_DATA_HOME:-$HOME/.local/share}/raptor/rowmac.key"

# ─── proxy hygiene ──────────────────────────────────────────
# In proxied environments (HTTP_PROXY/HTTPS_PROXY set) every localhost
# call this script makes — the curl health probes, the seed/register
# scripts, the MCP smoke test — would be routed through the proxy,
# which cannot reach this machine's loopback. Corporate NO_PROXY
# values rarely include loopback, so append it for our children.
# Container-side passthrough lives in core/sage/docker-compose.yml.
if [ -n "${HTTP_PROXY:-}${HTTPS_PROXY:-}${http_proxy:-}${https_proxy:-}" ]; then
    NO_PROXY="localhost,127.0.0.1${NO_PROXY:+,$NO_PROXY}"
    no_proxy="$NO_PROXY"
    export NO_PROXY no_proxy
fi

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "raptor-sage-setup: missing prerequisite: $1" >&2
        exit 3
    }
}

check_docker() {
    need docker
    # docker compose is a plugin, not a subcommand — may be absent even
    # when docker is installed.
    if ! docker compose version >/dev/null 2>&1; then
        echo "raptor-sage-setup: 'docker compose' plugin not found." >&2
        echo "  Install: https://docs.docker.com/compose/install/" >&2
        exit 3
    fi
    # Daemon must be running. Try docker info; if the user needs sg docker
    # (group membership rather than direct socket access), re-exec self.
    if ! docker info >/dev/null 2>&1; then
        if command -v sg >/dev/null 2>&1 && sg docker -c "docker info" >/dev/null 2>&1; then
            # Re-exec under sg docker. Build a properly quoted argv
            # since sg -c takes a single string.
            local quoted_args=""
            local a
            for a in "${_ORIG_ARGS[@]}"; do
                quoted_args="$quoted_args \"$a\""
            done
            exec sg docker -c "\"$0\"$quoted_args"
        fi
        echo "raptor-sage-setup: Docker daemon is not running or not accessible." >&2
        echo "  Start: sudo systemctl start docker" >&2
        echo "  Or add yourself to the docker group: sudo usermod -aG docker \$USER" >&2
        exit 3
    fi
}

check_compose_file() {
    if [ ! -f "$COMPOSE_FILE" ]; then
        echo "raptor-sage-setup: compose file not found: $COMPOSE_FILE" >&2
        echo "  Is the RAPTOR checkout complete? Try: git checkout -- core/sage/docker-compose.yml" >&2
        exit 3
    fi
}

check_port() {
    # Skip if our own containers already hold the port (idempotent re-install).
    local port="$1" service="$2"
    local running
    running=$(docker compose -f "$COMPOSE_FILE" ps --status running -q 2>/dev/null || true)
    [ -n "$running" ] && return 0
    if command -v ss >/dev/null 2>&1; then
        if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
            echo "raptor-sage-setup: port $port is already in use ($service needs it)." >&2
            echo "  Check: ss -tlnp | grep :$port" >&2
            exit 3
        fi
    elif command -v lsof >/dev/null 2>&1; then
        if lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
            echo "raptor-sage-setup: port $port is already in use ($service needs it)." >&2
            echo "  Check: lsof -iTCP:$port" >&2
            exit 3
        fi
    fi
}

check_sdk() {
    python3 -c "import sage_sdk" 2>/dev/null || {
        echo "raptor-sage-setup: sage-agent-sdk not importable by python3." >&2
        echo "  Install first: pip install sage-agent-sdk httpx" >&2
        exit 3
    }
}

check_wrapper() {
    if [ ! -f "$MCP_WRAPPER" ]; then
        echo "raptor-sage-setup: stdio wrapper not found: $MCP_WRAPPER" >&2
        echo "  Expected at libexec/raptor-sage-mcp — was it deleted?" >&2
        exit 3
    fi
    if [ ! -x "$MCP_WRAPPER" ]; then
        echo "raptor-sage-setup: stdio wrapper not executable: $MCP_WRAPPER" >&2
        echo "  Fix: chmod +x $MCP_WRAPPER" >&2
        exit 3
    fi
}

preserve_migration_backup() {
    local backup="$1"
    local i
    local old_tmps=("${_RAPTOR_TMP_FILES[@]}")
    _RAPTOR_TMP_FILES=()
    for i in "${old_tmps[@]}"; do
        [ "$i" = "$backup" ] || _RAPTOR_TMP_FILES+=("$i")
    done
}

abort_sage_home_migration() {
    local backup="$1" volume_name="$2" reason="$3"
    preserve_migration_backup "$backup"
    echo "Migration ABORTED: $reason" >&2
    echo "  Old container and both state locations were preserved." >&2
    echo "  Backup: $backup" >&2
    [ -z "$volume_name" ] || echo "  Destination volume: $volume_name" >&2
    echo "  Resolve the failure, then re-run setup." >&2
}

migrate_sage_home_if_needed() {
    # SAGE <= 6.6.5 used /root/.sage-gui as the volume mount. SAGE 11.x
    # expects /root/.sage. If an existing container still has the old mount
    # we migrate the data into the volume before docker compose recreates
    # the container with the new mount point.
    local cid
    if ! cid=$(docker compose -f "$COMPOSE_FILE" ps -aq sage 2>/dev/null); then
        echo "raptor-sage-setup: could not inspect the existing SAGE container." >&2
        return 1
    fi
    [ -z "$cid" ] && return 0

    # Check whether the container's mounts include the old path.
    local has_old_mount
    if ! has_old_mount=$(docker inspect "$cid" \
        --format '{{range .Mounts}}{{if eq .Destination "/root/.sage-gui"}}old{{end}}{{end}}' \
        2>/dev/null); then
        echo "raptor-sage-setup: could not inspect mounts for container $cid." >&2
        return 1
    fi
    [ "$has_old_mount" != "old" ] && return 0

    # Determine whether the container has writable-layer SAGE_HOME state while
    # it is still running. docker exec cannot inspect a stopped container, and
    # treating every non-zero result as "absent" would also swallow daemon,
    # permission, and I/O failures. The in-container probe therefore emits an
    # explicit state only after a successful check; every other result leaves
    # the old container untouched.
    local has_writable_sage_home=0 writable_sage_home_state
    if ! writable_sage_home_state=$(docker exec -u 0 "$cid" /bin/sh -c '
        if [ -d /root/.sage ]; then
            printf "%s\n" present
            exit
        fi
        if [ -d /root ] && [ -x /root ] && [ ! -e /root/.sage ]; then
            printf "%s\n" absent
            exit
        fi
        exit 1
    ' 2>/dev/null); then
        echo "raptor-sage-setup: could not inspect writable-layer SAGE_HOME in container $cid." >&2
        echo "  The old container was left untouched; ensure it is running and readable, then retry." >&2
        return 1
    fi
    case "$writable_sage_home_state" in
        present) has_writable_sage_home=1 ;;
        absent) ;;
        *)
            echo "raptor-sage-setup: writable-layer SAGE_HOME probe returned an invalid result." >&2
            echo "  The old container was left untouched; ensure it is running and readable, then retry." >&2
            return 1
            ;;
    esac

    echo "Detected old volume mount (/root/.sage-gui). Migrating data to /root/.sage..."

    docker compose -f "$COMPOSE_FILE" stop sage

    local volume_name
    if ! volume_name=$(docker inspect "$cid" \
        --format '{{range .Mounts}}{{if eq .Destination "/root/.sage-gui"}}{{.Name}}{{end}}{{end}}' \
        2>/dev/null); then
        echo "raptor-sage-setup: could not resolve the legacy SAGE volume." >&2
        return 1
    fi
    if [ -z "$volume_name" ]; then
        echo "raptor-sage-setup: no volume backs /root/.sage-gui; migration stopped." >&2
        return 1
    fi

    local backup
    backup=$(mktemp -d "$RAPTOR_DIR/.sage-migration.XXXXXX")
    _RAPTOR_TMP_FILES+=("$backup")

    # The volume was mounted at /root/.sage-gui, but SAGE_HOME defaults to
    # /root/.sage — so state may be in either location. Copy both: the volume
    # contents (ledger, old data) and the writable-layer SAGE_HOME (agent keys,
    # ledger written to the default path).
    if ! docker cp "$cid:/root/.sage-gui/." "$backup/" 2>/dev/null; then
        abort_sage_home_migration "$backup" "$volume_name" \
            "could not copy the legacy volume state."
        return 1
    fi
    # Writable-layer SAGE_HOME — 6.6.5 containers may not have /root/.sage
    # at all, but 11.x containers with the old volume mount store real state
    # there (agent.key, data/sage.db, etc).
    if [ "$has_writable_sage_home" -eq 1 ]; then
        if ! docker cp "$cid:/root/.sage/." "$backup/" 2>/dev/null; then
            abort_sage_home_migration "$backup" "$volume_name" \
                "could not copy the writable-layer SAGE_HOME."
            return 1
        fi
    fi

    # Resolve the SAGE image from the compose file so we don't hardcode a version.
    local compose_images sage_image=""
    if ! compose_images=$(docker compose -f "$COMPOSE_FILE" config --images 2>/dev/null); then
        abort_sage_home_migration "$backup" "$volume_name" \
            "could not resolve the SAGE image from the compose file."
        return 1
    fi
    while IFS= read -r image; do
        case "$image" in
            *sage*) sage_image="$image"; break ;;
        esac
    done <<< "$compose_images"
    if [ -z "$sage_image" ]; then
        abort_sage_home_migration "$backup" "$volume_name" \
            "the compose file did not resolve a SAGE image."
        return 1
    fi

    # Only populate destination if the backup has content.
    if [ -d "$backup" ] && [ "$(ls -A "$backup" 2>/dev/null)" ]; then
        local dest_marker
        if ! dest_marker=$(docker run --rm \
            -v "$volume_name:/dest:ro" \
            --entrypoint /bin/sh \
            "$sage_image" \
            -c 'ls -A /dest 2>/dev/null | head -1' 2>/dev/null); then
            abort_sage_home_migration "$backup" "$volume_name" \
                "could not inspect the destination volume."
            return 1
        fi
        if [ -z "$dest_marker" ]; then
            # Destination empty — full copy.
            if ! docker run --rm \
                -v "$backup:/src:ro" \
                -v "$volume_name:/dest" \
                --entrypoint /bin/sh \
                "$sage_image" \
                -c 'cp -a /src/. /dest/'; then
                abort_sage_home_migration "$backup" "$volume_name" \
                    "full-copy extraction failed."
                return 1
            fi
            echo "Volume migration complete (full copy)."
        else
            # Destination already has data. Detect collisions (files in
            # both src and dest with different content) before merging.
            # Uses find -exec to avoid word-splitting on filenames.
            # cmp -s: byte-for-byte comparison (POSIX, no false negatives).
            local collisions critical_collisions
            if ! collisions=$(docker run --rm \
                -v "$backup:/src:ro" \
                -v "$volume_name:/dest:ro" \
                --entrypoint /bin/sh \
                "$sage_image" \
                -c '
                find /src -type f ! -name ".migration-complete" -exec sh -c '\''
                    for src_path; do
                        rel="${src_path#/src/}"
                        dst_path="/dest/$rel"
                        if [ -f "$dst_path" ]; then
                            cmp -s "$src_path" "$dst_path"
                            cmp_status=$?
                            case "$cmp_status" in
                                0) ;;
                                1) printf "%s\n" "$rel" ;;
                                *) printf "comparison failed: %s\n" "$rel" >&2; exit "$cmp_status" ;;
                            esac
                        fi
                    done
                '\'' _ {} +
                '); then
                abort_sage_home_migration "$backup" "$volume_name" \
                    "collision comparison failed."
                return 1
            fi

            # Classify collisions: critical state must block migration.
            # SAGE layout: agent.key, vault.key, config.yaml at root;
            # data/sage.db (off-chain), data/badger/ (on-chain),
            # data/cometbft/ (consensus) under data/.
            critical_collisions=0
            if [ -n "$collisions" ]; then
                echo "Collision: these files differ between backup and destination volume:"
                while IFS= read -r rel; do
                    case "$rel" in
                        agent.key|vault.key|config.yaml|data/sage.db|data/badger/*|data/cometbft/*)
                            printf "  %s  [CRITICAL]\n" "$rel"
                            critical_collisions=$((critical_collisions + 1))
                            ;;
                        *)
                            printf "  %s\n" "$rel"
                            ;;
                    esac
                done <<< "$collisions"
            fi

            if [ "$critical_collisions" -gt 0 ]; then
                abort_sage_home_migration "$backup" "$volume_name" \
                    "critical state files differ between backup and destination."
                return 1
            fi

            if [ -n "$collisions" ]; then
                echo "  Destination version kept for non-critical files. Backup preserved."
            fi
            # Merge paths missing from destination. Existing files were
            # compared above and remain untouched.
            if ! docker run --rm \
                -v "$backup:/src:ro" \
                -v "$volume_name:/dest" \
                --entrypoint /bin/sh \
                "$sage_image" \
                -c '
                find /src -mindepth 1 -type d -exec sh -c '\''
                    for src_path; do
                        rel="${src_path#/src/}"
                        dst_path="/dest/$rel"
                        if [ -e "$dst_path" ] && [ ! -d "$dst_path" ]; then
                            printf "type collision: %s\n" "$rel" >&2
                            exit 1
                        fi
                        mkdir -p "$dst_path" || exit 1
                    done
                '\'' _ {} + &&
                find /src -mindepth 1 ! -type d -exec sh -c '\''
                    for src_path; do
                        rel="${src_path#/src/}"
                        dst_path="/dest/$rel"
                        if [ -e "$dst_path" ] || [ -L "$dst_path" ]; then
                            continue
                        fi
                        cp -a "$src_path" "$dst_path" || exit 1
                    done
                '\'' _ {} +
                '; then
                abort_sage_home_migration "$backup" "$volume_name" \
                    "missing-file merge failed."
                return 1
            fi
            echo "Destination volume already has data — merged missing files only."
        fi

        # Post-migration regression: every critical file present in the
        # backup must exist byte-for-byte in the destination. Directories
        # must also survive even when empty.
        local validation_result
        if ! validation_result=$(docker run --rm \
            -v "$backup:/src:ro" \
            -v "$volume_name:/dest:ro" \
            --entrypoint /bin/sh \
            "$sage_image" \
            -c '
            for rel in agent.key vault.key config.yaml data/sage.db; do
                src_path="/src/$rel"
                dst_path="/dest/$rel"
                [ -f "$src_path" ] || continue
                if [ ! -f "$dst_path" ]; then
                    printf "missing critical file: %s\n" "$rel"
                    exit 1
                fi
                if ! cmp -s "$src_path" "$dst_path"; then
                    printf "critical file mismatch: %s\n" "$rel"
                    exit 1
                fi
            done
            for rel in data/badger data/cometbft; do
                src_dir="/src/$rel"
                dst_dir="/dest/$rel"
                [ -d "$src_dir" ] || continue
                if [ ! -d "$dst_dir" ]; then
                    printf "missing critical directory: %s\n" "$rel"
                    exit 1
                fi
                find "$src_dir" -type f -exec sh -c '\''
                    src_dir="$1"
                    dst_dir="$2"
                    shift 2
                    for src_path; do
                        rel_path="${src_path#"$src_dir"/}"
                        dst_path="$dst_dir/$rel_path"
                        if [ ! -f "$dst_path" ] || ! cmp -s "$src_path" "$dst_path"; then
                            printf "critical state mismatch: %s\n" "$rel_path"
                            exit 1
                        fi
                    done
                '\'' _ "$src_dir" "$dst_dir" {} + || exit 1
            done
            printf "critical state: verified\n"
            '); then
            [ -z "$validation_result" ] || printf "%s\n" "$validation_result" >&2
            abort_sage_home_migration "$backup" "$volume_name" \
                "post-migration validation failed."
            return 1
        fi
        echo "Post-migration check:"
        echo "  $validation_result"

        if ! docker run --rm \
            -v "$volume_name:/dest" \
            --entrypoint /bin/sh \
            "$sage_image" \
            -c 'date -u > /dest/.migration-complete'; then
            abort_sage_home_migration "$backup" "$volume_name" \
                "could not write the migration completion marker."
            return 1
        fi
    fi

    # Preserve backup so the operator can verify before removing.
    if [ -d "$backup" ] && [ "$(ls -A "$backup" 2>/dev/null)" ]; then
        # Remove from cleanup trap so it survives script exit.
        preserve_migration_backup "$backup"
        echo "Migration backup preserved at: $backup"
        echo "  Remove manually after verifying: rm -rf $backup"
    else
        rm -rf "$backup"
    fi
}

generate_mcp_entry() {
    # Generate the stdio MCP entry inline. Replaces .mcpServers.sage entirely
    # so stale type/url fields from an old SSE config do not survive.
    local tmp
    tmp=$(mktemp "$(dirname "$MCP")/.tmp.mcp.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    trap 'rm -f "$tmp"' RETURN

    (if [ -f "$MCP" ]; then cat "$MCP"; else echo '{}'; fi) \
    | jq --arg cmd "$MCP_WRAPPER" --arg project "$(basename "$RAPTOR_DIR")" '
      if type != "object" then error(".mcp.json root must be an object") else . end
      | if .mcpServers == null then .mcpServers = {} elif (.mcpServers | type) != "object" then error(".mcpServers must be an object") else . end
      | .mcpServers.sage = {
          "command": $cmd,
          "args": [],
          "env": {
            "SAGE_PROVIDER": "claude-code",
            "SAGE_PROJECT": $project,
            "SAGE_IDENTITY_PATH": "/root/.sage/agents/raptor-claude-code/agent.key"
          }
        }
    ' > "$tmp"
    mv "$tmp" "$MCP"
    trap - RETURN
    echo "Generated stdio MCP entry in $MCP."
}

discover_mcp_tools() {
    # Query the SAGE MCP wrapper for its tool list via the MCP protocol.
    # Returns one tool name per line (e.g. "mcp__sage__sage_turn").
    #
    # The wrapper emits newline-delimited JSON (one object per line) per
    # the JSONRPC-over-stdio convention.  We collect the full output then
    # use jq to find the tools/list response by id, which is robust even
    # if a future wrapper pretty-prints or reorders responses.
    local timeout_cmd=""
    if command -v timeout >/dev/null 2>&1; then
        timeout_cmd="timeout 10"
    elif command -v gtimeout >/dev/null 2>&1; then
        timeout_cmd="gtimeout 10"
    fi
    local response
    response=$(printf '%s\n%s\n%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"raptor-setup","version":"1.0.0"}}}' \
        '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
        '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
        | CLAUDECODE=1 $timeout_cmd "$MCP_WRAPPER" 2>/dev/null || true)
    if [ -z "$response" ]; then
        return 0
    fi
    # Parse all JSON objects from the response stream, select the one
    # with id==2 (tools/list), and extract tool names.
    printf '%s\n' "$response" \
        | jq -r 'select(.id == 2) | .result.tools[]?.name // empty' 2>/dev/null \
        | sed 's/^/mcp__sage__/' \
        | grep '^mcp__sage__sage_[a-z_]*$' \
        | sort
}

grant_mcp_permissions() {
    # Discover SAGE MCP tools and add them to settings.local.json permissions.
    local tools
    tools=$(discover_mcp_tools)
    if [ -z "$tools" ]; then
        echo "Warning: could not discover SAGE MCP tools — permissions not updated." >&2
        return 0
    fi
    local tool_count
    tool_count=$(printf '%s\n' "$tools" | wc -l | tr -d ' ')
    if [ ! -f "$SETTINGS_LOCAL" ]; then
        echo "Warning: $SETTINGS_LOCAL not found — permissions not updated." >&2
        return 0
    fi
    local tmp
    tmp=$(mktemp "$(dirname "$SETTINGS_LOCAL")/.tmp.settings.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    local tools_json
    tools_json=$(printf '%s\n' "$tools" | jq -R . | jq -s .)
    if ! jq --argjson sage_tools "$tools_json" '
        .permissions.allow = (
            [.permissions.allow[]? | select(startswith("mcp__sage__") | not)]
            + $sage_tools
        )
    ' "$SETTINGS_LOCAL" > "$tmp"; then
        echo "Warning: failed to update $SETTINGS_LOCAL — file may be malformed." >&2
        rm -f "$tmp"
        return 0
    fi
    mv "$tmp" "$SETTINGS_LOCAL"
    echo "Granted $tool_count SAGE MCP tool permissions in $SETTINGS_LOCAL."
}

revoke_mcp_permissions() {
    # Remove all mcp__sage__ entries from settings.local.json permissions.
    [ -f "$SETTINGS_LOCAL" ] || return 0
    local before
    before=$(jq '[.permissions.allow[]? | select(startswith("mcp__sage__"))] | length' "$SETTINGS_LOCAL")
    [ "$before" = "0" ] && return 0
    local tmp
    tmp=$(mktemp "$(dirname "$SETTINGS_LOCAL")/.tmp.settings.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    jq '.permissions.allow = [.permissions.allow[]? | select(startswith("mcp__sage__") | not)]' \
        "$SETTINGS_LOCAL" > "$tmp"
    mv "$tmp" "$SETTINGS_LOCAL"
    echo "Revoked $before SAGE MCP tool permissions from $SETTINGS_LOCAL."
}

smoke_test_mcp() {
    # Send an MCP initialize + notifications/initialized sequence and check for
    # a valid response. The MCP protocol requires notifications/initialized after
    # the server responds to initialize before tool calls are accepted.
    # Non-fatal — warn and continue if it fails (container may need more startup time).
    # The wrapper requires CLAUDECODE or _RAPTOR_TRUSTED to pass its trust-marker
    # check — export CLAUDECODE for the duration of this test.
    local response
    local timeout_cmd=""
    if command -v timeout >/dev/null 2>&1; then
        timeout_cmd="timeout 10"
    elif command -v gtimeout >/dev/null 2>&1; then
        timeout_cmd="gtimeout 10"
    fi
    response=$(printf '%s\n%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"raptor-smoke-test","version":"1.0.0"}}}' \
        '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
        | CLAUDECODE=1 $timeout_cmd "$MCP_WRAPPER" 2>/dev/null || true)
    if printf '%s' "$response" | grep -q '"result"'; then
        echo "MCP smoke test passed."
    else
        echo "Warning: MCP smoke test did not get a valid response." >&2
        echo "  SAGE may still be starting up. Claude Code will retry on first use." >&2
    fi
}

capture_boot_payload() {
    # Fetch the two instruction surfaces the SAGE server injects into
    # agents at connection time: the MCP initialize `instructions`
    # field and the sage_inception result message. These are prompt
    # surfaces — an agent cannot otherwise distinguish them from
    # untrusted runtime text, so authorize_boot_payload records them
    # for core/sage/CLAUDE.md's trust declaration to point at.
    # The payload text is state-dependent (first connection returns an
    # "Auto-Inception" variant with boot safeguards; later connections
    # a shorter "Auto-Connect" variant) — whichever the server emits
    # NOW is what gets recorded.
    local timeout_cmd=""
    if command -v timeout >/dev/null 2>&1; then
        timeout_cmd="timeout 15"
    elif command -v gtimeout >/dev/null 2>&1; then
        timeout_cmd="gtimeout 15"
    fi
    printf '%s\n%s\n%s\n' \
        '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"raptor-sage-setup","version":"1.0.0"}}}' \
        '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
        '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"sage_inception","arguments":{}}}' \
        | CLAUDECODE=1 $timeout_cmd "$MCP_WRAPPER" 2>/dev/null \
        | jq -r 'if .id == 1 then "### initialize.instructions\n" + (.result.instructions // "")
                 elif .id == 2 then "### sage_inception.message\n" + ((try (.result.content[0].text | fromjson | .message) catch "") // "")
                 else empty end'
}

authorize_boot_payload() {
    # Capture the server's boot payload and record it as operator-
    # authorized. Running setup IS the authorization event: SAGE is
    # opt-in, the image is pinned in the compose file, and the operator
    # deliberately invoked this install — so the payload the pinned
    # server emits now is what the operator is choosing to trust. No
    # separate review step; the stamp (time, image, hash) makes the
    # authorization auditable, and re-running setup after an upgrade
    # re-authorizes automatically.
    # Non-fatal: without the recorded file, agents treat server boot
    # instructions as unreviewed and may ask before executing them.
    local payload
    if ! payload=$(capture_boot_payload) || [ -z "$payload" ]; then
        echo "Warning: could not capture the SAGE boot payload." >&2
        echo "  Agents will treat server boot instructions as unreviewed." >&2
        echo "  Once SAGE is responsive, re-run: bin/raptor sage-setup install" >&2
        return 0
    fi
    local sha image stamp
    sha=$(printf '%s\n' "$payload" | sha256sum | awk '{print $1}')
    image=$(docker compose -f "$COMPOSE_FILE" config --images 2>/dev/null \
        | grep sage | head -1 || true)
    image="${image:-unknown}"
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # Show what changed when re-authorizing a different payload — the
    # only moment an operator would want to eyeball an upgrade's new
    # boot text. Informational, never blocking.
    if [ -f "$AUTHORIZED_PAYLOAD" ]; then
        local old_sha
        old_sha=$(sed -n 's/^# SHA256: //p' "$AUTHORIZED_PAYLOAD" | head -1)
        if [ -n "$old_sha" ] && [ "$old_sha" != "$sha" ]; then
            echo "SAGE boot payload changed since last authorization:"
            sed '1,/^# ---$/d' "$AUTHORIZED_PAYLOAD" \
                | diff -u --label previous --label current - <(printf '%s\n' "$payload") \
                || true
            echo "Re-authorized by this setup run."
        fi
    fi
    # Same-fs mktemp + atomic mv — see enable_sage_env for the rationale.
    mkdir -p "$(dirname "$AUTHORIZED_PAYLOAD")"
    local tmp
    tmp=$(mktemp "$(dirname "$AUTHORIZED_PAYLOAD")/.tmp.payload.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    trap 'rm -f "$tmp"' RETURN
    {
        echo "# SAGE boot payload — operator-authorized"
        echo "# Generated: $stamp by raptor-sage-setup"
        echo "# Image: $image"
        echo "# SHA256: $sha"
        echo "# Running raptor-sage-setup constitutes operator authorization of the"
        echo "# payload below. Regenerated on every install; per-machine; gitignored."
        echo "# Trust semantics: core/sage/CLAUDE.md."
        echo "# ---"
        printf '%s\n' "$payload"
    } > "$tmp"
    mv "$tmp" "$AUTHORIZED_PAYLOAD"
    trap - RETURN
    echo "Recorded operator-authorized SAGE boot payload:"
    echo "  File:    $AUTHORIZED_PAYLOAD"
    echo "  Image:   $image"
    echo "  SHA256:  $sha"
    echo "  Surfaces: initialize.instructions, sage_inception.message"
}

ensure_rowmac_key() {
    # Generate the per-install row-MAC key used by core/sage/rowmac.py
    # to authenticate SAGE rows that drive mechanical decisions.
    # 32 random bytes, directory 0700, file 0600. An existing key is
    # never touched: there is no rotation — previously stamped rows must
    # keep verifying, and deleting the key is the operator's explicit
    # reset (existing rows demote to hints and re-earn their status).
    # The library also creates this lazily on first store, so setup
    # order does not matter; this just front-loads it.
    if [ -f "$ROWMAC_KEY" ]; then
        echo "SAGE row-MAC key already present: $ROWMAC_KEY"
        return 0
    fi
    mkdir -p "$(dirname "$ROWMAC_KEY")"
    chmod 700 "$(dirname "$ROWMAC_KEY")"
    local tmp
    tmp=$(mktemp "$(dirname "$ROWMAC_KEY")/.tmp.rowmac.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    chmod 600 "$tmp"
    head -c 32 /dev/urandom > "$tmp"
    # ln (not mv) so publication is exclusive: if the library's lazy
    # O_EXCL create won the race between the -f check above and here,
    # that key wins and the tmp copy is discarded — a clobbering mv
    # would orphan any tokens already minted with the other key.
    if ln "$tmp" "$ROWMAC_KEY" 2>/dev/null; then
        echo "Generated SAGE row-MAC key: $ROWMAC_KEY"
    else
        echo "SAGE row-MAC key already present: $ROWMAC_KEY"
    fi
    rm -f "$tmp"
}

remove_mcp_entry() {
    [ -f "$MCP" ] || return 0
    # Same same-fs mktemp pattern as generate_mcp_entry.
    local tmp
    tmp=$(mktemp "$(dirname "$MCP")/.tmp.mcp.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    trap 'rm -f "$tmp"' RETURN
    jq 'del(.mcpServers.sage)' "$MCP" > "$tmp"
    mv "$tmp" "$MCP"
    trap - RETURN
    # If the file now contains only an empty mcpServers object (and nothing
    # else at the top level), delete it — it's ours to clean up.
    #
    # Pre-fix `jq -r 'keys | length' "$MCP"` was ambiguous for
    # non-object roots: `keys` works on BOTH objects AND arrays, so
    # an MCP file whose root happened to be `[...]` (corrupted writer,
    # operator hand-edit, manual JSON re-export from a tool that
    # serialised the wrong shape) returned the array's length — and
    # the `top_count == 1` test could match a 1-element array, leading
    # to deletion of an MCP file we shouldn't have touched. For
    # scalar roots (`null`, `true`, `42`, `"string"`) `keys` errors
    # outright, which jq returns rc=5 — the unset `top_count` then
    # compared "" against "1" and we left the file in place (correct
    # by accident, not by design).
    # Type-guard explicitly: only count keys when the root IS an
    # object; otherwise return 0 (so the cleanup branch doesn't
    # fire on non-object roots).
    local server_count top_count
    server_count="$(jq -r '.mcpServers // {} | length' "$MCP")"
    top_count="$(jq -r 'if type == "object" then keys|length else 0 end' "$MCP")"
    if [ "$server_count" = "0" ] && [ "$top_count" = "1" ]; then
        rm -f "$MCP"
        echo "Removed $MCP (no MCP servers remaining)."
    else
        echo "Removed SAGE entry from $MCP."
    fi
}

wait_health() {
    printf "Waiting for SAGE health"
    # SAGE serves /health (no /v1 prefix) — see core/sage/docker-compose.yml
    # healthcheck and core/sage/client.py.
    # `for _ in {1..60}` instead of `seq 1 60`. Pre-fix `seq`
    # is GNU coreutils — present on Linux distros by default
    # but NOT POSIX-required and NOT installed by default on
    # macOS, BusyBox-based containers (Alpine without
    # coreutils), or minimal Docker base images. Operators
    # running RAPTOR on Alpine / minimal images saw
    # "raptor-sage-setup: line 162: seq: command not found"
    # and the wait_health loop never executed, then immediately
    # printed " — timeout.\n" and exited. Bash brace expansion
    # works on every bash >= 3.0 (which is older than macOS's
    # bundled bash) and needs no external tool.
    for _ in {1..60}; do
        # Check both HTTP-200 AND a sentinel string in the
        # response body. Pre-fix any 200 response from /health
        # marked SAGE as "ready" — but several proxy-layer
        # misconfigurations (nginx default-site, Cloudflare
        # 200-OK-with-error-page, k8s ingress controller's
        # default backend) can return 200 with completely
        # unrelated content. The launcher then proceeded
        # assuming SAGE was up; the first real /v1/* call
        # then failed in confusing ways (404 from the wrong
        # backend, JSON parse error on HTML response).
        # SAGE's /health endpoint returns a JSON `{"status":
        # "healthy", "version": ...}` body (SAGE 8.4.x; earlier
        # 6.6.x returned `{"status": "ok", ...}`). Match on the
        # `"status"` key — present in every SAGE version's health
        # body and absent from the proxy/ingress default-backend
        # responses we are guarding against — before trusting it.
        if response=$(curl -sf "$SAGE_URL/health" 2>/dev/null); then
            if printf '%s' "$response" | grep -q '"status"'; then
                printf " — ready.\n"
                return 0
            fi
        fi
        sleep 2
        printf "."
    done
    printf " — timeout.\n" >&2
    echo "SAGE did not become healthy within 120s." >&2
    echo "Check: docker compose -f $COMPOSE_FILE logs sage" >&2
    exit 1
}

enable_sage_env() {
    # Writes SAGE_ENABLED=true into RAPTOR's .claude/settings.local.json
    # so Claude Code propagates it into RAPTOR subprocesses. This is the
    # *Python-pipeline* opt-in (the MCP opt-in is .mcp.json). Without this,
    # recall_context_for_scan / store_scan_results no-op silently because
    # core/sage/config.py:SageConfig.enabled defaults to False.
    #
    # settings.local.json is per-machine (already covered by `.claude/*.local.json`
    # in .gitignore). cc_trust skips RAPTOR_DIR so the SAGE_* entry here is
    # safe from our own trust check.
    #
    # `umask 077` for the duration of this function. Pre-fix the
    # generated settings.local.json + tmp files used the
    # operator's default umask (commonly 022, world-readable).
    # SAGE settings can grow to include endpoint URLs and (in
    # future configurations) auth tokens; world-readable
    # permissions on the file expose those to any local user
    # on shared multi-user machines. 077 = owner-rwx only.
    local _saved_umask
    _saved_umask=$(umask)
    umask 077
    mkdir -p "$(dirname "$SETTINGS_LOCAL")"
    local fragment='{"env":{"SAGE_ENABLED":"true"}}'
    local tmp
    # `mktemp "$(dirname ...)/.tmp.XXXXXX"` so the tmp file lives
    # on the SAME filesystem as the destination. Pre-fix bare `mktemp`
    # defaulted to `/tmp` (or whatever `$TMPDIR` resolved to), which
    # on hardened systems is a tmpfs separate from the home filesystem
    # — `mv` then degraded to copy+unlink which is non-atomic, AND
    # `/tmp`'s default permissions vary across distros (1777 on most,
    # but containers and CI runners sometimes set 755 with operator
    # adjacency). Same-fs mktemp keeps mv atomic and inherits the
    # parent dir's permissions.
    tmp=$(mktemp "$(dirname "$SETTINGS_LOCAL")/.tmp.settings.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    trap 'rm -f "$tmp"; umask "$_saved_umask"' RETURN
    if [ ! -f "$SETTINGS_LOCAL" ]; then
        echo "$fragment" | jq . > "$SETTINGS_LOCAL"
        echo "Wrote SAGE_ENABLED=true to $SETTINGS_LOCAL."
    else
        jq --argjson frag "$fragment" '. * $frag' "$SETTINGS_LOCAL" > "$tmp"
        mv "$tmp" "$SETTINGS_LOCAL"
        echo "Merged SAGE_ENABLED=true into $SETTINGS_LOCAL."
    fi
    # Belt-and-braces chmod in case mv preserved a wider mode
    # from the tmp source (mv is atomic but inherits mode from
    # source on cross-fs fallback).
    chmod 600 "$SETTINGS_LOCAL"
    trap - RETURN
    umask "$_saved_umask"
}

disable_sage_env() {
    [ -f "$SETTINGS_LOCAL" ] || return 0
    local tmp
    # Same-fs mktemp — see enable_sage_env above for the rationale.
    tmp=$(mktemp "$(dirname "$SETTINGS_LOCAL")/.tmp.settings.XXXXXX"); _RAPTOR_TMP_FILES+=("$tmp")
    trap 'rm -f "$tmp"' RETURN
    # Remove env.SAGE_ENABLED; if env becomes empty, drop env entirely.
    # Pre-fix the top-level "is the whole settings object now empty?"
    # check happened AFTER the mv, opening a small race window where
    # another process could read SETTINGS_LOCAL and observe `{}`
    # (the post-removal state) before we got around to deleting the
    # empty file. Two consequences:
    #   * Any concurrent reader that special-cases "empty settings →
    #     fall back to defaults" got a misleading "explicit empty"
    #     signal.
    #   * Any concurrent writer that merged into the empty file
    #     wrote into a transient state we were about to delete,
    #     racing the rm.
    #
    # Make the jq filter compute the top-level emptiness in the same
    # pass and emit an empty document marker (`null`) when the whole
    # object would become `{}` — bash then sees the marker and
    # deletes the file directly without ever writing the empty `{}`
    # state to disk.
    jq 'if has("env") then (.env |= del(.SAGE_ENABLED)
           | if .env == {} then del(.env) else . end)
         else . end
       | if . == {} then null else . end' "$SETTINGS_LOCAL" > "$tmp"
    if [ "$(cat "$tmp")" = "null" ]; then
        rm -f "$SETTINGS_LOCAL" "$tmp"
        trap - RETURN
        echo "Removed $SETTINGS_LOCAL (no settings remaining)."
    else
        mv "$tmp" "$SETTINGS_LOCAL"
        trap - RETURN
        echo "Removed SAGE_ENABLED from $SETTINGS_LOCAL."
    fi
}

verify_embeddings() {
    # Verify SAGE is running with Ollama embeddings rather than hash-based
    # pseudo-embeddings. Two checks: (1) the container has the env var, (2)
    # Ollama has the model. No log parsing — env vars and API are stable;
    # SAGE's zerolog format and ANSI codes are not.
    local provider
    provider=$(docker compose -f "$COMPOSE_FILE" exec -T sage \
        printenv SAGE_EMBEDDING_PROVIDER 2>/dev/null || true)
    provider=$(printf '%s' "$provider" | tr -d '[:space:]')
    if [ "$provider" != "ollama" ] && [ "$provider" != "openai-compatible" ]; then
        echo "Warning: SAGE_EMBEDDING_PROVIDER is '${provider:-unset}', expected 'ollama' or 'openai-compatible'." >&2
        echo "  Semantic recall will use hash-based fallback (keyword matching only)." >&2
        return 0
    fi
    local model
    model=$(docker compose -f "$COMPOSE_FILE" exec -T sage \
        printenv SAGE_EMBEDDING_MODEL 2>/dev/null || true)
    model=$(printf '%s' "$model" | tr -d '[:space:]')
    model="${model:-nomic-embed-text}"
    # Ask the ollama container itself (same pattern as status_sage).
    # Pre-fix this probed http://ollama:11434/api/tags with wget from
    # INSIDE the sage container — but SAGE 11.17.11+ images ship neither
    # wget nor curl (see the compose file's healthcheck comment), so the
    # probe always failed and the "model not found" warning fired even
    # on healthy installs.
    local models
    models=$(docker compose -f "$COMPOSE_FILE" exec -T ollama \
        ollama list 2>/dev/null || true)
    if printf '%s' "$models" | grep -q "${model%%:*}"; then
        echo "SAGE using $provider embeddings ($model)."
    else
        echo "Warning: $model not found in Ollama." >&2
        echo "  Run: docker compose -f $COMPOSE_FILE exec ollama ollama pull $model" >&2
    fi
}

detect_embedding_model() {
    # Set SAGE_EMBED_MODEL and SAGE_EMBED_DIM based on GPU availability.
    # GPU: nomic-embed-text (768d, ~0.1s/embed on GPU).
    # CPU: snowflake-arctic-embed:m (768d, ~3s/embed on Xeon E5-2650 v2).
    # Both are 768-dim so the SAGE vector store works with either —
    # switching between GPU/CPU machines doesn't require a re-seed.
    # Operator override: export SAGE_EMBED_MODEL / SAGE_EMBED_DIM before
    # running setup to skip auto-detection entirely.
    if [ -n "${SAGE_EMBED_MODEL:-}" ]; then
        echo "Embedding model: $SAGE_EMBED_MODEL (operator override)"
        export SAGE_EMBED_MODEL SAGE_EMBED_DIM="${SAGE_EMBED_DIM:-768}"
        return 0
    fi
    if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
        export SAGE_EMBED_MODEL="nomic-embed-text"
        export SAGE_EMBED_DIM="768"
        echo "GPU detected — using nomic-embed-text (768d)."
    else
        export SAGE_EMBED_MODEL="snowflake-arctic-embed:m"
        export SAGE_EMBED_DIM="768"
        echo "No GPU detected — using snowflake-arctic-embed:m (768d, CPU-optimised)."
    fi
}

install_sage() {
    need jq
    check_docker
    need python3
    need curl
    check_sdk
    check_wrapper
    check_compose_file
    check_port 8090 "SAGE REST API"
    check_port 11435 "Ollama embedding server"
    migrate_sage_home_if_needed
    detect_embedding_model
    # `--remove-orphans` so containers from a PREVIOUS
    # compose config (e.g. the operator updated
    # core/sage/docker-compose.yml between runs and the old config's
    # containers are still running) get cleaned up too. Same
    # rationale as `down --remove-orphans` below: stale
    # containers from a prior config hold port bindings and
    # confuse the install with "port already allocated"
    # errors. Pre-fix bare `up -d` left orphans intact.
    docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
    wait_health
    verify_embeddings
    local seed_script="$RAPTOR_DIR/core/sage/scripts/seed_sage_knowledge.py"
    local register_script="$RAPTOR_DIR/core/sage/scripts/register_agents.py"
    if [ -f "$seed_script" ]; then
        python3 "$seed_script" --sage-url "$SAGE_URL"
    else
        echo "Warning: seed script not found: $seed_script" >&2
    fi
    if [ -f "$register_script" ]; then
        python3 "$register_script" --sage-url "$SAGE_URL"
    else
        echo "Warning: register script not found: $register_script" >&2
    fi
    generate_mcp_entry
    enable_sage_env
    smoke_test_mcp
    authorize_boot_payload
    ensure_rowmac_key
    grant_mcp_permissions
    echo
    echo "SAGE is up. Restart Claude Code so it picks up the MCP registration."
}

uninstall_sage() {
    need jq
    check_docker
    # `--remove-orphans` so containers from PREVIOUS compose
    # configs (e.g. operator updated core/sage/docker-compose.yml
    # between runs and the old config's containers are still
    # running) get cleaned up too. Pre-fix `docker compose
    # down` only removes containers defined in the CURRENT
    # compose file; stale containers from a prior config
    # (renamed services, removed dependencies) lingered as
    # zombies, holding port bindings and confusing the next
    # `install` invocation with "port already allocated"
    # errors. The orphan flag is safe — we WANT teardown to
    # be thorough.
    docker compose -f "$COMPOSE_FILE" down --remove-orphans
    remove_mcp_entry
    disable_sage_env
    revoke_mcp_permissions
    if [ -f "$AUTHORIZED_PAYLOAD" ]; then
        rm -f "$AUTHORIZED_PAYLOAD"
        echo "Removed $AUTHORIZED_PAYLOAD."
    fi
    echo "SAGE sidecar stopped. Data volumes preserved."
    echo "To wipe volumes: docker compose -f $COMPOSE_FILE down -v --remove-orphans"
}

status_sage() {
    check_docker
    check_compose_file
    local running
    running=$(docker compose -f "$COMPOSE_FILE" ps --status running -q sage 2>/dev/null || true)
    if [ -z "$running" ]; then
        echo "SAGE is not running."
        echo "  Start: bin/raptor sage-setup install"
        return 1
    fi
    echo "SAGE is running."
    # Health
    local health
    health=$(curl -sf "$SAGE_URL/health" 2>/dev/null || true)
    if printf '%s' "$health" | grep -q '"status"'; then
        echo "  Health: OK"
    else
        echo "  Health: unreachable at $SAGE_URL"
    fi
    # Embedding mode
    local provider
    provider=$(docker compose -f "$COMPOSE_FILE" exec -T sage \
        printenv SAGE_EMBEDDING_PROVIDER 2>/dev/null || true)
    provider=$(printf '%s' "$provider" | tr -d '[:space:]')
    echo "  Embedding: ${provider:-hash (default)}"
    # Ollama
    local ollama_running
    ollama_running=$(docker compose -f "$COMPOSE_FILE" ps --status running -q ollama 2>/dev/null || true)
    if [ -n "$ollama_running" ]; then
        local embed_model
        embed_model=$(docker compose -f "$COMPOSE_FILE" exec -T sage \
            printenv SAGE_EMBEDDING_MODEL 2>/dev/null || true)
        embed_model=$(printf '%s' "$embed_model" | tr -d '[:space:]')
        embed_model="${embed_model:-nomic-embed-text}"
        local model_count
        model_count=$(docker compose -f "$COMPOSE_FILE" exec -T ollama \
            ollama list 2>/dev/null | grep -c "${embed_model%%:*}" || true)
        echo "  Ollama: running ($embed_model: ${model_count:-0} loaded)"
        # Report performance-relevant Ollama env vars so the operator can
        # confirm tuning took effect after a container recreate.
        local oenv
        for oenv in OLLAMA_NUM_PARALLEL OLLAMA_FLASH_ATTENTION OLLAMA_KEEP_ALIVE; do
            local oval
            oval=$(docker compose -f "$COMPOSE_FILE" exec -T ollama \
                printenv "$oenv" 2>/dev/null || true)
            oval=$(printf '%s' "$oval" | tr -d '[:space:]')
            [ -n "$oval" ] && echo "  $oenv: $oval"
        done
    else
        echo "  Ollama: not running"
    fi
    # Memory count
    local mem_count
    mem_count=$(docker compose -f "$COMPOSE_FILE" exec -T sage \
        sage-gui status 2>/dev/null | sed -n 's/.*Memories:[[:space:]]*\([0-9][0-9]*\).*/\1/p' || true)
    [ -n "$mem_count" ] && echo "  Memories: $mem_count"
    # MCP entry
    if [ -f "$MCP" ] && jq -e '.mcpServers.sage' "$MCP" >/dev/null 2>&1; then
        echo "  MCP entry: present in $MCP"
    else
        echo "  MCP entry: missing (run install to generate)"
    fi
    # Boot payload authorization + live drift check. All mechanical —
    # operators (and agents) get the answer from this allowlisted
    # script instead of ad-hoc head/sha256sum invocations that would
    # trip permission prompts.
    if [ -f "$AUTHORIZED_PAYLOAD" ]; then
        local auth_stamp auth_image auth_sha
        auth_stamp=$(sed -n 's/^# Generated: //p' "$AUTHORIZED_PAYLOAD" | head -1)
        auth_image=$(sed -n 's/^# Image: //p' "$AUTHORIZED_PAYLOAD" | head -1)
        auth_sha=$(sed -n 's/^# SHA256: //p' "$AUTHORIZED_PAYLOAD" | head -1)
        echo "  Boot payload: authorized ${auth_stamp:-unknown} (${auth_image:-unknown}, sha256 ${auth_sha:0:12})"
        # Compare against what the running server emits now. The payload
        # is state-dependent (first-connection vs steady-state variant),
        # so a mismatch means "look", not "compromised".
        local live live_sha
        if live=$(capture_boot_payload) && [ -n "$live" ]; then
            live_sha=$(printf '%s\n' "$live" | sha256sum | awk '{print $1}')
            if [ "$live_sha" = "$auth_sha" ]; then
                echo "  Boot payload drift: none — live payload matches"
            else
                echo "  Boot payload drift: live payload DIFFERS (sha256 ${live_sha:0:12})"
                echo "    Review + re-authorize: bin/raptor sage-setup install"
            fi
        else
            echo "  Boot payload drift: could not capture live payload to compare"
        fi
    else
        echo "  Boot payload: not recorded — authorize: bin/raptor sage-setup install"
    fi
}

case "$MODE" in
    install)   install_sage ;;
    uninstall) uninstall_sage ;;
    status)    status_sage ;;
esac
