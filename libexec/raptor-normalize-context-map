#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Normalise a context-map.json in place using the run dir's checklist.json.

Usage: raptor-normalize-context-map <understand_dir>

Wraps core.orchestration.understand_bridge.normalize_context_map for
invocation from skill markdown. Lets /understand --map clean its output
right after writing context-map.json so anyone reading the on-disk file
sees the normalised data — not just consumers that go through the bridge
on read.

Idempotent — safe to run more than once. Logs warnings for any
hallucinated files / out-of-range lines / cross-ref typos but never
errors out (a usable context-map should still get saved).
"""
import sys
from pathlib import Path

# libexec/raptor-normalize-context-map -> repo root (parents[1])

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.artifacts.context_map_budget import (  # noqa: E402
    enforce_context_map_budget,
)
from core.artifacts.provenance import (  # noqa: E402
    CONTEXT_MAP_TEXT_SCHEMA,
    sanitise_free_text,
    stamp_provenance,
)
from core.json import load_json, save_json  # noqa: E402
from core.orchestration.understand_bridge import normalize_context_map  # noqa: E402


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: raptor-normalize-context-map <understand_dir>",
              file=sys.stderr)
        return 1

    understand_dir = Path(sys.argv[1])
    if not understand_dir.is_dir():
        print(f"raptor-normalize-context-map: {understand_dir} is not a directory",
              file=sys.stderr)
        return 1

    context_map_path = understand_dir / "context-map.json"
    if not context_map_path.exists():
        print(f"raptor-normalize-context-map: {context_map_path} does not exist",
              file=sys.stderr)
        return 1

    context_map = load_json(context_map_path)
    if not isinstance(context_map, dict):
        print(f"raptor-normalize-context-map: {context_map_path} is not a JSON object",
              file=sys.stderr)
        return 1

    checklist = load_json(understand_dir / "checklist.json") or {}
    target_path = checklist.get("target_path") if isinstance(checklist, dict) else None

    # Firmware runs carry an ELF inventory next to the map — feed it to
    # the firmware-surface pass so shipped high-value binaries (which
    # have no source for the LLM to read) still land as entry points.
    from core.orchestration.firmware_enrichment import locate_firmware_inventory
    firmware_inventory = None
    inv_path = locate_firmware_inventory(understand_dir, target=target_path)
    if inv_path is not None:
        firmware_inventory = load_json(inv_path)
        if not isinstance(firmware_inventory, dict):
            firmware_inventory = None

    normalize_context_map(context_map, checklist, target_path=target_path,
                          firmware_inventory=firmware_inventory)

    # Writer-side provenance chokepoint for the in-session /understand
    # --map artifact: defang free-text fields and stamp the map as
    # LLM-derived (untrusted) so raptor-validate-schema and downstream
    # consumers get a mechanical trust signal. Keeps any generator id
    # an earlier writer recorded (e.g. the binary-analysis pipeline).
    sanitised = sanitise_free_text(context_map, CONTEXT_MAP_TEXT_SCHEMA)
    stamp_provenance(context_map, "understand:map",
                     untrusted=True, overwrite_generator=False)
    enforce_context_map_budget(context_map)
    save_json(context_map_path, context_map)
    if sanitised:
        print(f"raptor-normalize-context-map: sanitised {len(sanitised)} "
              "free-text field(s)")
    print(f"raptor-normalize-context-map: normalised {context_map_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
