#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Phase 1 mechanical prep for /understand --study.

Extracts study items from target source files: struct/union/enum
definitions, refcount fields, paired operations (get_X/put_X,
alloc_X/free_X), doc comments, and include-resolved definitions.

Writes ``study-list.json`` to the output directory.

Usage:
    raptor-study-prep <target> <output_dir> [--root <source_root>]

The target is the study scope (e.g. crypto/).
The root is the search space for include resolution (defaults to
detecting the top-level source root from the target path).
"""
