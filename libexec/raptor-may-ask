#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Interactivity gate for structured operator prompts (AskUserQuestion).

Usage:
  raptor-may-ask

Output (one line):
  interactive       — an operator is present; the session may present
                      an AskUserQuestion choice at documented decision
                      points
  non-interactive   — dispatched / CI / unattended context; the session
                      must apply the instruction's documented
                      non-interactive fallback instead of asking

Exit code is 0 either way — the verdict is the printed word. See
core/ux/interactivity.py for the decision order (explicit
RAPTOR_NONINTERACTIVE override, CI markers via rule_of_two.is_ci,
std-fd TTYs, rule-of-two human-attendance probe; fail closed).
"""
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401


def main() -> int:
    from core.ux.interactivity import session_interactivity
    print(session_interactivity())
    return 0


if __name__ == "__main__":
    sys.exit(main())
