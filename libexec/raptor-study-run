#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Run Phase 2 + 3 of /understand --study: LLM concept extraction.

Usage:
    raptor-study-run <output_dir> [--model MODEL]

Reads study-list.json from output_dir (written by raptor-study-prep),
dispatches items to an LLM in batches, synthesises results, and writes
domain-model.json to the same directory.

Requires an LLM provider (set ANTHROPIC_API_KEY, OPENAI_API_KEY, etc.).
"""
import argparse
import logging
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401

from core.concepts.study import run_study  # noqa: E402

logger = logging.getLogger("raptor-study-run")


def _progress(phase: str, message: str) -> None:
    print(f"study-run[{phase}]: {message}", file=sys.stderr, flush=True)


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="raptor-study-run",
        description="Phase 2 + 3: LLM concept extraction and synthesis.",
    )
    ap.add_argument("output_dir", help="Directory with study-list.json.")
    ap.add_argument("--model", default=None,
                    help="LLM model override (e.g. claude-sonnet-4-6).")
    ap.add_argument("-v", "--verbose", action="store_true")
    parsed = ap.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if parsed.verbose else logging.INFO,
        format="%(name)s: %(message)s",
    )
    for _noisy in ("httpx", "httpcore", "urllib3"):
        logging.getLogger(_noisy).setLevel(logging.WARNING)

    output_dir = Path(parsed.output_dir).resolve()
    study_list = output_dir / "study-list.json"
    if not study_list.is_file():
        print(
            f"study-run: {study_list} not found — run raptor-study-prep first",
            file=sys.stderr,
        )
        return 1

    from packages.llm_analysis import get_client

    if parsed.model:
        from core.llm.config import LLMConfig

        cfg = LLMConfig()
        mc = cfg.config_for_model(parsed.model)
        if not mc.api_key:
            print(
                f"study-run: no API key for --model {parsed.model}\n"
                f"  Set the provider env var or add the key to models.json",
                file=sys.stderr,
            )
            return 1
        client = get_client(config=LLMConfig(primary_model=mc, fallback_models=[]))
    else:
        client = get_client()

    if client is None:
        print(
            "study-run: no LLM provider available. "
            "Set ANTHROPIC_API_KEY, OPENAI_API_KEY, or similar.",
            file=sys.stderr,
        )
        return 1

    _progress("start", f"Reading {study_list}")
    model = run_study(
        study_list,
        output_dir,
        client,
        on_progress=_progress,
    )

    print(
        f"study-run: domain model written — "
        f"{len(model.concepts)} concepts, "
        f"{len(model.invariants)} invariants, "
        f"{len(model.contracts)} contracts",
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
