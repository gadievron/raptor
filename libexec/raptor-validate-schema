#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Validate a RAPTOR JSON output file against its schema.

Usage: raptor-validate-schema [--lint] <type> <file>

Types:
  findings        findings.json
  checklist       checklist.json
  attack-tree     attack-tree.json
  attack-paths    attack-paths.json
  attack-surface  attack-surface.json
  hypotheses      hypotheses.json
  disproven       disproven.json
  context-map     context-map.json (/understand --map)
  flow-trace      flow-trace-*.json (/understand --trace)
  variants        variants.json (/understand --hunt)
  bug-report      bug-report.json (/crash-analysis fetch stage)
  part-a..part-f  one stage part from stage-<x>-parts/ (--lint only)

Exit code 0 on success, 1 on validation errors, 3 on usage errors
(unknown type, missing or unparseable file). 2 is reserved for the
trust-marker refusal below (cc-trust-check convention).

On success, records file hash in <dir>/.validated so the prep script
can skip re-validation if the file hasn't changed.

Lint mode (``--lint``):
  Dry-run with the promoter's exact checks and ZERO side effects — no
  ``.validated`` record, no ``provenance.schema_validated`` flip, no
  vuln_type-normalisation writeback, no cache short-circuit. Both
  modes call the same implementation
  (packages.exploitability_validation.lint), so lint and promote
  cannot disagree about schema validity. Same exit codes as above.

  Fragment lint: pass a ``part-<x>`` type (or point --lint at a file
  inside a ``stage-<x>-parts/`` directory — auto-detected) to lint
  ONE delegated agent's part before hand-back. Fragment mode checks
  element shapes and enums for the slice the part carries;
  set-completeness and cross-part referential integrity are checked
  at assembly (``raptor-validation-helper parts``), not here.

Provenance policy (docs/security.md invariant I2-(b)):
  These artifacts carry LLM-derived content, so writers stamp them with
  a top-level ``provenance`` object ({generator, untrusted,
  schema_validated}) plus a ``raptor_schema_version`` marker (see
  core.artifacts.provenance). This gate enforces the stamp:

  * stamp present and well-formed  -> validated; on success the gate
    flips ``provenance.schema_validated`` to true in the file.
  * stamp present but malformed    -> FAIL (exit 1).
  * ``raptor_schema_version`` present without a stamp -> FAIL — a
    current-version writer produced the file but did not stamp it.
  * neither key present            -> LEGACY artifact written by an
    older RAPTOR version: warn once, treat content as untrusted, and
    validate the rest normally (no hard failure — old runs stay
    loadable; consumers read missing stamps as untrusted anyway).

  Top-level-array artifacts (attack-paths, hypotheses) carry the stamp
  per element; a mix of stamped and unstamped elements is tolerated
  with a warning (unstamped elements read as untrusted).

Free-text sanitisation check:
  String fields the schema marks with ``x_free_text`` must be
  sanitiser-idempotent on disk (the writer already applied
  core.artifacts.provenance.sanitise_artifact_text). Non-idempotent
  fields FAIL with the precise field path on stamped artifacts, and
  warn on legacy artifacts.
"""
import hashlib
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.security.log_sanitisation import sanitise_for_terminal as _sft  # noqa: E402
from core.artifacts.provenance import mark_schema_validated  # noqa: E402
from core.json import load_json, save_json  # noqa: E402
from packages.exploitability_validation import lint as _lint  # noqa: E402

# The check implementation lives in packages.exploitability_validation.lint
# so the --lint dry-run, this promote path, and in-process callers all
# consume the SAME schema objects and check functions — a re-declared
# copy here would be able to disagree with what --lint reported.
# Existing callers import these names from this module; keep them bound.
VALIDATORS = _lint.VALIDATORS
_LIST_TYPES = _lint.LIST_TYPES
_validate_stage_file = _lint.validate_stage_file
_require_list_fields = _lint.require_list_fields
_validate_lightweight = _lint.validate_lightweight
_free_text_schema = _lint.free_text_schema
_provenance_checks = _lint.provenance_checks

# --lint fragment types: one delegated agent's part of a sharded stage.
_PART_TYPES = {f"part-{s.lower()}": s for s in _lint.PART_STAGES}

# Filename → type auto-detection (mirrors the stage-file detection).
_FILENAME_TYPES = {
    "context-map.json": "context-map",
    "variants.json": "variants",
    "bug-report.json": "bug-report",
}


def _hash_file(filepath):
    return hashlib.sha256(filepath.read_bytes()).hexdigest()


def _read_validated(directory):
    """Read .validated hashes. Returns {filename: hash}."""
    vfile = Path(directory) / ".validated"
    result = {}
    if vfile.exists():
        for line in vfile.read_text(encoding="utf-8").splitlines():
            if ":" in line:
                name, h = line.split(":", 1)
                result[name.strip()] = h.strip()
    return result


def _write_validated(directory, filename, filehash, schema_type=None):
    """Record a validated file hash.

    When *schema_type* is given, it is folded into the recorded value
    (``type:hash``) so the cache is keyed by WHICH validator passed —
    a file validated as one type must not short-circuit a later
    validation request under a different type.
    """
    vfile = Path(directory) / ".validated"
    # Advisory lock around the read-modify-write: without it two
    # concurrent stage validations both read the same pre-state and
    # the later rename drops the earlier one's entry. On flock
    # failure proceed unlocked — this is a validation CACHE, so the
    # loss direction is benign (the dropped entry re-validates) and
    # refusing the write would cost more than the race.
    import fcntl
    lock_path = Path(directory) / ".validated.lock"
    with open(lock_path, "a+b") as lock_fh:
        try:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
        except OSError:
            pass
        existing = _read_validated(directory)
        existing[filename] = (
            f"{schema_type}:{filehash}" if schema_type else filehash
        )
        lines = [f"{k}:{v}" for k, v in sorted(existing.items())]
        # Atomic write: a torn write would drop every cached record.
        from core.atomic_fs import write_text_atomically
        write_text_atomically(vfile, "\n".join(lines) + "\n")


def is_already_validated(filepath, schema_type=None):
    """Check if file was already validated and hasn't changed.

    Looks up the file's content hash in the per-directory
    `.validated` index file. Returns True only when:
      * the index has an entry for `filepath.name`, AND
      * the recorded hash matches the file's CURRENT hash
        (i.e., the file hasn't changed since the last
        successful validation).

    Returns False when the file has no recorded validation,
    when the index file is missing/unreadable, or when the
    file has been modified since the last validation
    (re-validation needed).

    The hash check covers in-place edits — mtime checks would
    miss content-preserving touches and false-positive on
    rsync-with-preserve-mtime, so we hash. The cost is one
    file read per check; for the validate stage that runs
    sub-second per file, this is acceptable.

    Used by `main()` to short-circuit re-validation of
    unchanged files in batch runs (Stage 0 inventory walk
    re-runs `raptor-validate-schema` over every stage file
    on each Stage A boot — without this skip, validation
    cost was O(N) per A-boot per file, multiplied by every
    A-boot in a long-running pipeline).

    Distinct from `validate(...)` which does the actual
    schema check — the helper here is purely "did we already
    do that check, and is the result still valid?". A True
    result means the caller can skip the validate() call.
    """
    filepath = Path(filepath)
    validated = _read_validated(filepath.parent)
    recorded = validated.get(filepath.name)
    if not recorded:
        return False
    # Match the schema type as well as the content hash when the
    # caller supplies one: a pass recorded for a different validator
    # (or a legacy type-less record) must not be claimed for this one.
    current = _hash_file(filepath)
    if schema_type is not None:
        return recorded == f"{schema_type}:{current}"
    return recorded == current


def _detect_type(filepath):
    """Filename → type auto-detection (stage files + well-known names)."""
    if filepath.name.startswith("stage-") and filepath.name.endswith(".json"):
        return "stage"
    if filepath.name.startswith("flow-trace-") and filepath.name.endswith(".json"):
        return "flow-trace"
    return _FILENAME_TYPES.get(filepath.name)


def _detect_part_stage(filepath):
    """Return the stage letter when the file sits in stage-<x>-parts/."""
    import re
    m = re.fullmatch(r"stage-([a-f])-parts", filepath.parent.name)
    return m.group(1).upper() if m else None


def _run_lint(schema_type, filepath):
    """--lint mode: promoter checks, zero side effects, no cache."""
    data = load_json(filepath)
    if data is None:
        print(f"✗ cannot parse JSON: {filepath}", file=sys.stderr)
        sys.exit(3)

    part_stage = _PART_TYPES.get(schema_type)
    if part_stage is None:
        detected_stage = _detect_part_stage(filepath)
        if detected_stage:
            print(f"NOTE: file is in a stage-{detected_stage.lower()}-parts/ "
                  f"directory — linting as a stage {detected_stage} part",
                  file=sys.stderr)
            part_stage = detected_stage

    if part_stage:
        result = _lint.lint_fragment(part_stage, data)
    else:
        detected = _detect_type(filepath)
        if detected and detected != schema_type:
            print(f"NOTE: auto-detected {detected} file — using '{detected}' "
                  f"validator instead of '{schema_type}'", file=sys.stderr)
            schema_type = detected
        result = _lint.lint_artifact(schema_type, data, filepath.name)

    for w in result.warnings:
        print(f"WARNING: {filepath.name}: {_sft(str(w), max_len=300)}",
              file=sys.stderr)
    if result.errors:
        print(f"ERRORS in {filepath.name}:", file=sys.stderr)
        for e in result.errors:
            print(f"  {_sft(str(e), max_len=300)}", file=sys.stderr)
        sys.exit(1)
    print(f"LINT OK: {filepath.name} (dry-run; nothing recorded)")


def main():
    args = sys.argv[1:]
    lint_mode = "--lint" in args
    args = [a for a in args if a != "--lint"]

    known_type = args and (
        args[0] in VALIDATORS or (lint_mode and args[0] in _PART_TYPES)
    )
    if len(args) < 2 or not known_type:
        print(f"Usage: {sys.argv[0]} [--lint] <type> <file>", file=sys.stderr)
        print(f"Types: {', '.join(sorted(VALIDATORS.keys()))}", file=sys.stderr)
        print(f"Lint-only types: {', '.join(sorted(_PART_TYPES))} "
              "(one stage part)", file=sys.stderr)
        sys.exit(3)

    schema_type = args[0]
    filepath = Path(args[1])

    if lint_mode:
        if not filepath.exists():
            print(f"✗ file not found: {filepath}", file=sys.stderr)
            sys.exit(3)
        _run_lint(schema_type, filepath)
        return

    # Auto-detect well-known filenames regardless of what type was
    # requested (mirrors the long-standing stage-file detection).
    detected = _detect_type(filepath)
    if detected and detected != schema_type:
        print(f"NOTE: auto-detected {detected} file — using '{detected}' "
              f"validator instead of '{schema_type}'", file=sys.stderr)
        schema_type = detected

    if not filepath.exists():
        print(f"✗ file not found: {filepath}", file=sys.stderr)
        sys.exit(3)

    if is_already_validated(filepath, schema_type):
        print(f"OK: {filepath.name} (cached)")
        return

    data = load_json(filepath)
    if data is None:
        print(f"✗ cannot parse JSON: {filepath}", file=sys.stderr)
        sys.exit(3)

    # Normalise vuln_type and feasibility-status aliases before
    # validating findings and stage files (persisted — the lint
    # applies the same normalisation to a copy, so the two surfaces
    # judge identical content). Rewriting the file in place must not
    # be silent: a one-line notice carries the count only (never the
    # values — file content is target-derived).
    if schema_type in ("findings", "stage"):
        n_normalised = (_lint.normalise_findings_vuln_types(data)
                        + _lint.normalise_feasibility_fields(data))
        if n_normalised:
            save_json(filepath, data)
            print(f"NOTE: normalised {n_normalised} field(s) to canonical "
                  "form — file rewritten in place", file=sys.stderr)

    # Same checks as --lint, same implementation: schema/structural
    # validation + provenance stamp + free-text idempotence gate.
    result = _lint.lint_artifact(schema_type, data, filepath.name)
    for w in result.warnings:
        print(f"WARNING: {filepath.name}: {_sft(str(w), max_len=300)}", file=sys.stderr)

    if result.errors:
        print(f"ERRORS in {filepath.name}:", file=sys.stderr)
        for e in result.errors:
            print(f"  {_sft(str(e), max_len=300)}", file=sys.stderr)
        sys.exit(1)

    # Record the successful schema validation in the stamp itself so
    # consumers can distinguish gated artifacts from raw ones. Preserve
    # the on-disk mode (some artifacts are written 0o600).
    if result.provenance_ok and mark_schema_validated(data):
        save_json(filepath, data, mode=filepath.stat().st_mode & 0o777)

    _write_validated(
        filepath.parent, filepath.name, _hash_file(filepath), schema_type,
    )
    print(f"OK: {filepath.name}")


if __name__ == "__main__":
    from core.run.cli_outcome import cli_outcome
    with cli_outcome():
        main()
