"""Validation pipeline helper — per-stage mechanical work.

Usage:
  raptor-validation-helper 0 --target <path>              # start + inventory + bridge
  raptor-validation-helper <A|B|C|D|E|F> <workdir> [--target <path>]
  raptor-validation-helper 1 <workdir>                    # report + coverage + complete

Stages 0 and 1 compose generic tools (lifecycle, checklist, coverage, diagrams)
with validation-specific logic (bridge, stage merging, report generation).
Stages A-F do per-stage merging, validation, and schema hints.
"""
import contextlib
import re
import sys
from collections import defaultdict
from pathlib import Path

