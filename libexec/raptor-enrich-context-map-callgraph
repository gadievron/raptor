#!/usr/bin/env python3
# ruff: noqa: RUF100, I001
# (preamble protection; see .github/tests/test_libexec_marker_coverage.py)
"""Enrich a context-map.json with substrate-derived forward-reachable
closures per entry point. Runs after raptor-normalize-context-map.

Usage: raptor-enrich-context-map-callgraph <understand_dir> [--max-depth N]

Wraps core.orchestration.context_map_callgraph.enrich_with_forward_reachable
for invocation from skill markdown. Adds a ``forward_reachable`` field
to each entry point in context-map.json. Idempotent — safe to re-run.

Best-effort: missing checklist / inventory build failure / unresolved
host functions log warnings but never abort the run.
"""
import argparse
import sys
from pathlib import Path

# ─── trust-marker check (do not import; inline by design) ───
# fmt: off
import os  # noqa: E402
if not (os.environ.get("CLAUDECODE")
        or os.environ.get("_RAPTOR_TRUSTED")):
    sys.stderr.write(
        f"{sys.argv[0]}: internal dispatch script.\n"
        "  Run via 'bin/raptor' instead.\n"
        "  Tests / power users: set _RAPTOR_TRUSTED=1 to bypass.\n"
    )
    sys.exit(2)
# fmt: on
# ─── end trust-marker check ─────────────────────────────────

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import core.startup.process_init  # noqa: E402,F401
from core.artifacts.context_map_budget import (  # noqa: E402
    save_context_map,
)
from core.json import load_json  # noqa: E402
from core.orchestration.context_map_callgraph import (  # noqa: E402
    DEFAULT_MAX_DEPTH,
    enrich_with_call_edges,
    enrich_with_forward_reachable,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="raptor-enrich-context-map-callgraph",
        description=(
            "Enrich context-map.json entry points with substrate-derived "
            "forward-reachable closures."
        ),
    )
    parser.add_argument("understand_dir", help="path to /understand run dir")
    parser.add_argument(
        "--max-depth", type=int, default=DEFAULT_MAX_DEPTH,
        help=(
            f"BFS depth bound for the closure walk "
            f"(default: {DEFAULT_MAX_DEPTH})"
        ),
    )
    args = parser.parse_args()

    understand_dir = Path(args.understand_dir).resolve()
    if not understand_dir.is_dir():
        print(
            f"raptor-enrich-context-map-callgraph: {understand_dir} is "
            "not a directory", file=sys.stderr,
        )
        return 1

    context_map_path = understand_dir / "context-map.json"
    if not context_map_path.exists():
        print(
            f"raptor-enrich-context-map-callgraph: {context_map_path} "
            "does not exist", file=sys.stderr,
        )
        return 1

    context_map = load_json(context_map_path)
    if not isinstance(context_map, dict):
        print(
            f"raptor-enrich-context-map-callgraph: {context_map_path} "
            "is not a JSON object", file=sys.stderr,
        )
        return 1

    from core.inventory import read_checklist
    checklist = read_checklist(understand_dir)
    target_path = checklist.get("target_path")
    if not target_path:
        print(
            "raptor-enrich-context-map-callgraph: checklist missing "
            "target_path; skipping enrichment", file=sys.stderr,
        )
        return 0

    # checklist.json is a mutable run artefact — corroborate against
    # the target_path sealed into .raptor-run.json at run start.
    from core.run.metadata import corroborate_target_path
    mismatch = corroborate_target_path(understand_dir, target_path)
    if mismatch:
        print(
            f"raptor-enrich-context-map-callgraph: {mismatch}; refusing "
            "recovered target", file=sys.stderr,
        )
        return 1

    # Project mode: route the FULL (uncapped) mechanical edge set into
    # the project graph store alongside the capped in-artifact list. A
    # project-owned store resolves OUTSIDE the run dir; a run-local
    # graph path means no project — storeless compatibility path.
    graph_store = None
    try:
        from core.understand_graph.store import graph_path_for_run
        candidate = graph_path_for_run(understand_dir, str(target_path))
        if not candidate.resolve().is_relative_to(understand_dir):
            graph_store = candidate
    except Exception:  # noqa: BLE001 — routing is additive; enrichment must survive resolution failure
        graph_store = None

    edge_count = enrich_with_call_edges(
        context_map, checklist=checklist,
        graph_store=graph_store, run_dir=understand_dir,
        target_path=str(target_path),
    )

    # Reuse the checklist as the inventory — no re-parse of the
    # target tree (invariants in core.orchestration.checklist_inventory).
    from core.orchestration.checklist_inventory import (
        inventory_from_checklist,
    )
    inventory = inventory_from_checklist(checklist)

    enriched = enrich_with_forward_reachable(
        context_map, Path(target_path), inventory=inventory,
        max_depth=args.max_depth,
    )

    if enriched or edge_count:
        save_context_map(context_map_path, context_map)
        parts = []
        if enriched:
            parts.append(f"{enriched} entry point(s)")
        if edge_count:
            parts.append(f"{edge_count} call edges")
        print(
            f"raptor-enrich-context-map-callgraph: enriched "
            f"{', '.join(parts)} in {context_map_path}"
        )
    else:
        print(
            "raptor-enrich-context-map-callgraph: no entries enriched "
            "(no entry_points field, all hosts unresolvable, or inventory "
            "build skipped)",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
