{
  "description": "RAPTOR Codex lifecycle hooks; active only for launcher-owned sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${RAPTOR_CODEX_HOOK_ROOT-}\" ]; then python3 -I \"${PLUGIN_ROOT}/hooks/dispatch.py\" session-start; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${RAPTOR_CODEX_HOOK_ROOT-}\" ]; then python3 -I \"${PLUGIN_ROOT}/hooks/dispatch.py\" stop; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${RAPTOR_CODEX_HOOK_ROOT-}\" ]; then python3 -I \"${PLUGIN_ROOT}/hooks/dispatch.py\" subagent-start; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${RAPTOR_CODEX_HOOK_ROOT-}\" ]; then python3 -I \"${PLUGIN_ROOT}/hooks/dispatch.py\" end; fi",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${RAPTOR_CODEX_HOOK_ROOT-}\" ]; then python3 -I \"${PLUGIN_ROOT}/hooks/dispatch.py\" outcome; fi",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
