          }
        },
        {
          "ruleId": "srcwrap:bare",
          "level": "warning",
          "message": {
            "text": "srcwrap rule matched"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ""
                },
                "region": {}
              }
            }
          ],
          "properties": {
            "provenance": "mechanical-source-summary"
          }
        }
      ]
    }
  ]
}
